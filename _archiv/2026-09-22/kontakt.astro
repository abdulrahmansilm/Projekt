---
/**
 * Kontakt (docs/BRANCHE.md → Sonderseiten „Kontakt (Formular-Flow)“).
 * Ziel des Header-CTAs „Beratung vereinbaren“ auf Seiten ohne eigenes Formular.
 * Kompakter Hero → Anfrage-Wizard (Komponente 16) → direkte Kontaktwege.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import KontaktWizard from "../components/kontakt/KontaktWizard.astro";
import { firma } from "../lib/config";
import { breadcrumbJsonLd } from "../lib/seo";
---

<BaseLayout
  title="Kontakt: Beratung anfragen oder Erstgespräch buchen"
  description="Schildern Sie uns Ihr Anliegen in wenigen Schritten oder buchen Sie direkt ein kostenloses Erstgespräch. Selim-IT, IT-Dienstleister in Frankfurt am Main."
  pfad="/kontakt"
  mitKontaktformular
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Startseite", pfad: "/" },
      { name: "Kontakt", pfad: "/kontakt" },
    ]),
  ]}
>
  <Hero
    kompakt
    headline="Kontakt"
    subline="Per Formular, Telefon oder E-Mail: Wählen Sie den Weg, der Ihnen am liebsten ist. Das Erstgespräch ist kostenlos."
  />

  <KontaktWizard />

  <section class="direkt" aria-labelledby="direkt-titel">
    <div class="container-site">
      <h2 id="direkt-titel" class="direkt__titel" data-reveal>Lieber direkt?</h2>
      <ul class="direkt__liste" role="list">
        <li class="direkt__karte" data-reveal style="--reveal-index:0">
          <span class="direkt__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.5 2.5.8 3.8.9.6 0 1 .5 1 1.1v3.6c0 .6-.5 1.1-1.1 1.1C10.9 21.7 2.3 13.1 2.3 3.9c0-.6.5-1.1 1.1-1.1H7c.6 0 1.1.4 1.1 1 .1 1.3.4 2.6.9 3.8.1.4.1.8-.2 1.1L6.6 10.8Z"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"></path>
            </svg>
          </span>
          <h3>Telefon</h3>
          <p>
            <a href={firma.telefon.href}><span class:list={{ platzhalter: firma.telefon.platzhalter }}>{firma.telefon.anzeige}</span></a>
          </p>
          <p class="direkt__hinweis">Bei akuten Ausfällen der schnellste Weg. {firma.supportZeiten}</p>
        </li>
        <li class="direkt__karte" data-reveal style="--reveal-index:1">
          <span class="direkt__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.7"></rect>
              <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <h3>E-Mail</h3>
          <p><a href={`mailto:${firma.email.adresse}`}>{firma.email.adresse}</a></p>
          <p class="direkt__hinweis">Für alles, was nicht eilt.</p>
        </li>
        <li class="direkt__karte" data-reveal style="--reveal-index:2">
          <span class="direkt__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
              <circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.7"></circle>
            </svg>
          </span>
          <h3>Standort</h3>
          <address>
            {firma.adresse.strasse}<br />
            <span class:list={{ platzhalter: firma.adresse.plz.platzhalter }}>{firma.adresse.plz.wert}</span>
            {" "}{firma.adresse.stadt}
          </address>
          <p class="direkt__hinweis">{firma.einsatzgebiet}.</p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .direkt {
    padding: 8px 0 104px;
    background: var(--nebel);
  }

  .direkt__titel {
    margin-bottom: 20px;
    font-size: 24px;
    font-weight: 600;
  }

  .direkt__liste {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .direkt__karte {
    padding: 26px 26px 24px;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 3px 14px rgba(11, 46, 60, 0.05);
  }

  .direkt__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 16px;
    border-radius: 12px;
    background: rgba(79, 184, 166, 0.12);
    color: var(--petrol);
  }

  .direkt__icon svg {
    width: 22px;
    height: 22px;
  }

  .direkt__karte h3 {
    margin-bottom: 6px;
    font-size: 17px;
    font-weight: 600;
  }

  .direkt__karte p,
  .direkt__karte address {
    font-size: 15.5px;
    font-style: normal;
    line-height: 1.6;
  }

  .direkt__karte a {
    color: var(--petrol);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(27, 110, 122, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .direkt__karte a:hover {
      text-decoration-color: currentColor;
    }
  }

  .direkt__hinweis {
    margin-top: 10px;
    font-size: 14px !important;
    color: var(--ink-68);
  }

  @media (max-width: 860px) {
    .direkt__liste {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .direkt {
      padding-bottom: 72px;
    }
  }
</style>
