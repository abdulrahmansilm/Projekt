---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatiereDatum } from "../../lib/utils";

const artikel = (await getCollection("wissen")).sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
---

<BaseLayout
  title="Wissen | Selim-IT"
  description="Fachartikel zu IT-Sicherheit, Datensicherung und Microsoft 365 von Selim-IT."
  path="/wissen"
>
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <span class="bg-accent-start/10 text-bg-dark reveal mb-4 inline-flex items-center gap-2 rounded-full px-4 py-1 text-xs font-medium uppercase tracking-wide">
      <span aria-hidden="true" class="bg-accent-start size-1.5 rounded-full"></span>
      — WISSEN
    </span>
    <h1 class="reveal font-headline text-3xl font-medium tracking-tight md:text-4xl">Wissen</h1>
    <p class="text-bg-dark/68 reveal mt-3 max-w-2xl text-base">
      Praxisnahe Artikel zu IT-Sicherheit, Datensicherung und Microsoft 365, ohne kundenspezifische Angaben.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        artikel.map((a) => (
          <a href={`/wissen/${a.id}`} class="reveal border-bg-dark/15 hover:border-accent-start/50 block border p-6 transition-colors">
            <p class="text-bg-dark/68 text-xs uppercase tracking-wide">{formatiereDatum(a.data.datum)}</p>
            <h2 class="font-headline mt-3 text-lg font-medium">{a.data.titel}</h2>
            <p class="text-bg-dark/68 mt-2 text-sm leading-relaxed">{a.data.beschreibung}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
