---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { firma, kategorien, kategorienReihenfolge, kiAssistentenBaldVerfuegbar, hauptNavigation } from "../../lib/config";

const alleLeistungen = await getCollection("leistungen");
// KI-Assistenten ist ein eigener Navbar-Punkt (siehe docs/BRANCHE.md), daher hier ausgeschlossen.
const leistungenNachKategorie = kategorienReihenfolge
  .filter((kat) => kat !== "ki-assistenten")
  .map((kat) => ({
    kategorie: kat,
    label: kategorien[kat].label,
    icon: kategorien[kat].icon,
    leistungen: alleLeistungen
      .filter((l) => l.data.kategorie === kat)
      .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge),
  }));
---

<header id="site-header" data-scrolled="false" class="sticky top-0 z-50 transition-colors duration-300">
  <a href="#main" class="skip-link bg-gradient-brand rounded-full px-4 py-2 text-sm font-semibold text-bg-dark">
    Zum Inhalt springen
  </a>

  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 md:h-20">
    <a href="/" class="flex shrink-0 items-center" aria-label="Selim-IT – Startseite">
      <img src="/logo/logo-dunkel.png" alt="Selim-IT" width="900" height="301" class="header-logo-dunkel h-7 w-auto md:h-8" />
      <img src="/logo/logo-hell.png" alt="Selim-IT" width="900" height="301" class="header-logo-hell hidden h-7 w-auto md:h-8" />
    </a>

    <nav aria-label="Hauptnavigation" class="hidden items-center gap-1 lg:flex">
      {
        leistungenNachKategorie.map((kat) => (
          <div class="nav-dropdown relative">
            <button
              type="button"
              class="header-text flex items-center gap-1.5 rounded-full px-3 py-2 text-sm font-medium hover:bg-bg-dark/5"
              aria-expanded="false"
              aria-controls={`nav-panel-${kat.kategorie}`}
            >
              {kat.label}
              <Icon name="chevron-down" class="size-3.5" aria-hidden="true" />
            </button>
            <div
              id={`nav-panel-${kat.kategorie}`}
              class="nav-panel border-bg-dark/10 bg-bg text-bg-dark invisible absolute left-0 top-full mt-2 w-64 origin-top-left rounded-none border opacity-0 shadow-sm transition-[opacity,visibility] duration-150"
            >
              <ul class="py-2">
                {kat.leistungen.map((l) => (
                  <li>
                    <a href={`/leistungen/${l.id}`} class="hover:bg-accent-start/10 block px-4 py-2.5 text-sm">
                      {l.data.titel}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }

      <div class="nav-dropdown relative">
        <button
          type="button"
          class="header-text flex items-center gap-1.5 rounded-full px-3 py-2 text-sm font-medium hover:bg-bg-dark/5"
          aria-expanded="false"
          aria-controls="nav-panel-ki"
        >
          KI-Assistenten
          <Icon name="chevron-down" class="size-3.5" aria-hidden="true" />
        </button>
        <div
          id="nav-panel-ki"
          class="nav-panel border-bg-dark/10 bg-bg text-bg-dark invisible absolute left-0 top-full mt-2 w-64 origin-top-left rounded-none border opacity-0 shadow-sm transition-[opacity,visibility] duration-150"
        >
          <ul class="py-2">
            {
              alleLeistungen
                .filter((l) => l.data.kategorie === "ki-assistenten")
                .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge)
                .map((l) => (
                  <li>
                    <a href={`/leistungen/${l.id}`} class="hover:bg-accent-start/10 block px-4 py-2.5 text-sm">
                      {l.data.titel}
                    </a>
                  </li>
                ))
            }
            {
              kiAssistentenBaldVerfuegbar.map((eintrag) => (
                <li>
                  <span aria-disabled="true" class="text-bg-dark/40 flex items-center justify-between px-4 py-2.5 text-sm">
                    {eintrag.titel}
                    <span class="text-[10px] uppercase tracking-wide">Bald verfügbar</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {
        hauptNavigation.map((item) => (
          <a href={item.href} class="header-text rounded-full px-3 py-2 text-sm font-medium hover:bg-bg-dark/5">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href={firma.kontakt.telefonHref} class="header-text hidden items-center gap-2 text-sm font-medium lg:inline-flex">
        <Icon name="phone" class="size-4" aria-hidden="true" />
        {firma.kontakt.telefon}
      </a>
      <a
        href="/kontakt"
        class="bg-gradient-brand inline-flex min-h-11 items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold text-white"
      >
        Anfrage
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="header-text inline-flex size-11 items-center justify-center lg:hidden"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" id="mobile-menu-icon-open" class="size-6" aria-hidden="true" />
        <Icon name="x" id="mobile-menu-icon-close" class="hidden size-6" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="bg-bg-dark fixed inset-0 z-40 hidden overflow-y-auto lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Hauptnavigation"
>
  <div class="px-4 pb-10 pt-24">
    <nav aria-label="Mobile Navigation" class="flex flex-col gap-1">
      {
        leistungenNachKategorie.map((kat) => (
          <div class="border-b border-white/10 py-2">
            <p class="px-2 py-2 text-xs font-medium uppercase tracking-wide text-white/68">{kat.label}</p>
            <ul>
              {kat.leistungen.map((l) => (
                <li>
                  <a href={`/leistungen/${l.id}`} class="block rounded-none px-2 py-3 text-base text-white">
                    {l.data.titel}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="border-b border-white/10 py-2">
        <p class="px-2 py-2 text-xs font-medium uppercase tracking-wide text-white/68">KI-Assistenten</p>
        <ul>
          {
            alleLeistungen
              .filter((l) => l.data.kategorie === "ki-assistenten")
              .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge)
              .map((l) => (
                <li>
                  <a href={`/leistungen/${l.id}`} class="block rounded-none px-2 py-3 text-base text-white">
                    {l.data.titel}
                  </a>
                </li>
              ))
          }
          {
            kiAssistentenBaldVerfuegbar.map((eintrag) => (
              <li>
                <span aria-disabled="true" class="flex items-center justify-between px-2 py-3 text-base text-white/40">
                  {eintrag.titel}
                  <span class="text-[10px] uppercase tracking-wide">Bald verfügbar</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        hauptNavigation.map((item) => (
          <a href={item.href} class="block px-2 py-3 text-base text-white">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={firma.kontakt.telefonHref}
      class="mt-6 flex items-center gap-2 px-2 text-base font-medium text-white"
    >
      <Icon name="phone" class="size-4" aria-hidden="true" />
      {firma.kontakt.telefon}
    </a>
    <a
      href="/kontakt"
      class="bg-gradient-brand mt-6 flex min-h-11 items-center justify-center rounded-full px-5 py-3 text-base font-semibold text-white"
    >
      Anfrage senden
    </a>
  </div>
</div>

<style>
  #site-header[data-scrolled="true"] {
    background-color: var(--color-bg-dark);
  }
  #site-header[data-scrolled="true"] .header-text {
    color: #ffffff;
  }
  #site-header[data-scrolled="false"] .header-text {
    color: var(--color-bg-dark);
  }
  #site-header[data-scrolled="true"] .header-logo-dunkel {
    display: none;
  }
  #site-header[data-scrolled="true"] .header-logo-hell {
    display: block;
  }
  #site-header[data-scrolled="true"] .nav-panel {
    color: var(--color-bg-dark);
  }
  .nav-dropdown:hover .nav-panel,
  .nav-dropdown:focus-within .nav-panel,
  .nav-panel.is-open {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  const header = document.getElementById("site-header");

  function updateScrolled() {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
  }
  updateScrolled();
  window.addEventListener("scroll", updateScrolled, { passive: true });

  // Dropdown-Menüs: per Klick/Tastatur bedienbar, nicht nur Hover.
  document.querySelectorAll<HTMLElement>(".nav-dropdown").forEach((dropdown) => {
    const button = dropdown.querySelector<HTMLButtonElement>("button");
    const panel = dropdown.querySelector<HTMLElement>(".nav-panel");
    if (!button || !panel) return;

    function close() {
      button!.setAttribute("aria-expanded", "false");
      panel!.classList.remove("is-open");
    }
    function open() {
      document.querySelectorAll<HTMLElement>(".nav-panel.is-open").forEach((p) => p.classList.remove("is-open"));
      button!.setAttribute("aria-expanded", "true");
      panel!.classList.add("is-open");
    }

    button.addEventListener("click", () => {
      const isOpen = button.getAttribute("aria-expanded") === "true";
      isOpen ? close() : open();
    });

    dropdown.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        close();
        button.focus();
      }
    });

    dropdown.addEventListener("focusout", (e) => {
      if (!dropdown.contains(e.relatedTarget as Node)) close();
    });
  });

  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLElement>(".nav-dropdown").forEach((dropdown) => {
      if (!dropdown.contains(e.target as Node)) {
        dropdown.querySelector(".nav-panel")?.classList.remove("is-open");
        dropdown.querySelector("button")?.setAttribute("aria-expanded", "false");
      }
    });
  });

  // Mobiles Menü: Fokus-Falle, Escape schließt, Fokus kehrt zum Trigger zurück.
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("mobile-menu-icon-open");
  const iconClose = document.getElementById("mobile-menu-icon-close");

  function openMenu() {
    if (!menu || !toggle) return;
    menu.classList.remove("hidden");
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Menü schließen");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    const firstLink = menu.querySelector<HTMLElement>("a, button");
    firstLink?.focus();
  }

  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.add("hidden");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Menü öffnen");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    document.body.style.overflow = "";
    toggle.focus();
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeMenu() : openMenu();
  });

  menu?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeMenu();
      return;
    }
    if (e.key !== "Tab") return;
    const focusable = menu.querySelectorAll<HTMLElement>("a, button");
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
