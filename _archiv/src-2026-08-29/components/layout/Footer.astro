---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { firma, kategorien, kategorienReihenfolge, footerRechtsLinks, socialLinks } from "../../lib/config";

const alleLeistungen = await getCollection("leistungen");
const spalten = kategorienReihenfolge.slice(0, 3).map((kat) => ({
  label: kategorien[kat].label,
  leistungen: alleLeistungen
    .filter((l) => l.data.kategorie === kat)
    .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge),
}));

const jahr = new Date().getFullYear();
---

<footer class="px-4 pb-4 pt-16 md:pt-20">
  <div class="bg-bg-dark mx-auto max-w-6xl rounded-t-[2.5rem] rounded-b-none px-6 py-12 text-white md:px-12 md:py-16">
    <div class="flex flex-col items-start justify-between gap-6 border-b border-white/15 pb-10 md:flex-row md:items-center">
      <div>
        <img src="/logo/logo-hell.png" alt="Selim-IT" width="900" height="301" class="h-8 w-auto" />
        <p class="mt-3 max-w-xs text-sm text-white/68">IT-Betreuung, Cloud, Digitalisierung und KI-Assistenten aus Frankfurt am Main.</p>
      </div>
      <a
        href="/kontakt"
        class="bg-gradient-brand inline-flex min-h-11 items-center justify-center rounded-full px-6 py-3 text-base font-semibold text-white"
      >
        Kostenloses Erstgespräch buchen
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        spalten.map((spalte) => (
          <div>
            <h3 class="font-headline text-sm font-medium uppercase tracking-wide text-white/68">{spalte.label}</h3>
            <ul class="mt-4 space-y-2.5">
              {spalte.leistungen.map((l) => (
                <li>
                  <a href={`/leistungen/${l.id}`} class="text-sm text-white hover:text-accent-end">
                    {l.data.titel}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <h3 class="font-headline text-sm font-medium uppercase tracking-wide text-white/68">Kontakt & Rechtliches</h3>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a href={firma.kontakt.telefonHref} class="flex items-center gap-2 text-sm text-white hover:text-accent-end">
              <Icon name="phone" class="size-4 shrink-0" aria-hidden="true" />
              {firma.kontakt.telefon}
            </a>
          </li>
          <li>
            <a href={`mailto:${firma.kontakt.email}`} class="flex items-center gap-2 text-sm text-white hover:text-accent-end">
              <Icon name="mail" class="size-4 shrink-0" aria-hidden="true" />
              {firma.kontakt.email}
            </a>
          </li>
          <li class="flex items-start gap-2 text-sm text-white">
            <Icon name="map-pin" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
            <span>{firma.adresse.strasse}, {firma.adresse.plz} {firma.adresse.stadt}</span>
          </li>
        </ul>
        <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1">
          {
            footerRechtsLinks.map((link) => (
              <li>
                <a href={link.href} class="text-xs text-white/68 hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-white/15 pt-6 sm:flex-row sm:items-center">
      <p class="text-xs text-white/68">© {jahr} {firma.name}, {firma.inhaber}</p>
      {
        socialLinks.length > 0 && (
          <ul class="flex gap-3">
            {socialLinks.map((social) => (
              <li>
                <a
                  href={social.href}
                  class="border-white/15 flex size-9 items-center justify-center rounded-full border text-white hover:bg-white/10"
                  aria-label={social.label}
                >
                  <Icon name={social.icon} class="size-4" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
