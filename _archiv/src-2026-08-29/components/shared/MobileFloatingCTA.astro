---
import { Icon } from "astro-icon/components";
import { firma } from "../../lib/config";
---

<div class="border-bg-dark/10 bg-bg fixed inset-x-0 bottom-0 z-40 border-t p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] md:hidden">
  <a
    href={firma.kontakt.telefonHref}
    class="bg-gradient-brand flex min-h-11 w-full items-center justify-center gap-2 rounded-full px-6 py-3 text-base font-semibold text-white"
  >
    <Icon name="phone" class="size-5" aria-hidden="true" />
    Jetzt anrufen
  </a>
</div>
