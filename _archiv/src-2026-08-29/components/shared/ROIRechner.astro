---
interface Tier {
  name: string;
  zielgruppe?: string;
  preisHaupt: string;
}

interface Props {
  einheitLabel: string;
  einheitDefault: number;
  einheitMin: number;
  einheitMax: number;
  dauerLabel: string;
  dauerDefault: number;
  dauerMin: number;
  dauerMax: number;
  anteilLabel: string;
  anteilDefault: number;
  stundenlohnLabel: string;
  stundenlohnDefault: number;
  fusszeile?: string;
  tiers: Tier[];
  id?: string;
}

const {
  einheitLabel,
  einheitDefault,
  einheitMin,
  einheitMax,
  dauerLabel,
  dauerDefault,
  dauerMin,
  dauerMax,
  anteilLabel,
  anteilDefault,
  stundenlohnLabel,
  stundenlohnDefault,
  fusszeile,
  tiers,
  id = "roi",
} = Astro.props;

function parseZielgruppe(zielgruppe: string | undefined): { min: number; max: number } {
  if (!zielgruppe) return { min: 0, max: Number.POSITIVE_INFINITY };
  const abMatch = zielgruppe.match(/ab\s+(\d+)/i);
  if (abMatch) return { min: Number(abMatch[1]), max: Number.POSITIVE_INFINITY };
  const rangeMatch = zielgruppe.match(/(\d+)[–-](\d+)/);
  if (rangeMatch) return { min: Number(rangeMatch[1]), max: Number(rangeMatch[2]) };
  return { min: 0, max: Number.POSITIVE_INFINITY };
}

function parsePreis(preisHaupt: string): number {
  const normalisiert = preisHaupt.replace(/\./g, "").replace(",", ".");
  const match = normalisiert.match(/(\d+(?:\.\d+)?)/);
  return match ? Number(match[1]) : 0;
}

const tierRanges = tiers.map((t) => {
  const { min, max } = parseZielgruppe(t.zielgruppe);
  return { name: t.name, min, max: Number.isFinite(max) ? max : 999999, preis: parsePreis(t.preisHaupt) };
});
const arbeitstageProMonat = 21;
---

<div class="reveal grid grid-cols-1 gap-0 overflow-hidden rounded-none border border-bg-dark/15 lg:grid-cols-2">
  <div class="bg-bg p-6 md:p-8">
    <h3 class="font-headline text-lg font-medium">Ihre Angaben</h3>

    <div class="mt-6 space-y-6">
      <div>
        <div class="flex items-center justify-between">
          <label for={`${id}-einheit`} class="text-sm font-medium">{einheitLabel}</label>
          <output for={`${id}-einheit`} id={`${id}-einheit-wert`} class="text-accent-start font-mono text-sm">{einheitDefault}</output>
        </div>
        <input
          type="range"
          id={`${id}-einheit`}
          min={einheitMin}
          max={einheitMax}
          value={einheitDefault}
          step="1"
          class={`${id}-input mt-2 w-full accent-accent-end`}
        />
      </div>

      <div>
        <div class="flex items-center justify-between">
          <label for={`${id}-dauer`} class="text-sm font-medium">{dauerLabel}</label>
          <output for={`${id}-dauer`} id={`${id}-dauer-wert`} class="text-accent-start font-mono text-sm">{dauerDefault}</output>
        </div>
        <input
          type="range"
          id={`${id}-dauer`}
          min={dauerMin}
          max={dauerMax}
          value={dauerDefault}
          step="1"
          class={`${id}-input mt-2 w-full accent-accent-end`}
        />
      </div>

      <div>
        <div class="flex items-center justify-between">
          <label for={`${id}-anteil`} class="text-sm font-medium">{anteilLabel}</label>
          <output for={`${id}-anteil`} id={`${id}-anteil-wert`} class="text-accent-start font-mono text-sm">{anteilDefault} %</output>
        </div>
        <input
          type="range"
          id={`${id}-anteil`}
          min="10"
          max="100"
          value={anteilDefault}
          step="5"
          class={`${id}-input mt-2 w-full accent-accent-end`}
        />
      </div>

      <div>
        <div class="flex items-center justify-between">
          <label for={`${id}-lohn`} class="text-sm font-medium">{stundenlohnLabel}</label>
          <output for={`${id}-lohn`} id={`${id}-lohn-wert`} class="text-accent-start font-mono text-sm">{stundenlohnDefault} €</output>
        </div>
        <input
          type="range"
          id={`${id}-lohn`}
          min="12"
          max="60"
          value={stundenlohnDefault}
          step="1"
          class={`${id}-input mt-2 w-full accent-accent-end`}
        />
      </div>

      <label class="flex cursor-pointer items-center gap-3 pt-2">
        <input type="checkbox" id={`${id}-vollkosten`} class="peer sr-only" />
        <span
          aria-hidden="true"
          class="border-bg-dark/25 peer-checked:bg-accent-end peer-checked:border-accent-end relative inline-flex h-6 w-11 shrink-0 items-center rounded-full border bg-bg transition-colors after:absolute after:left-0.5 after:size-5 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-5"
        ></span>
        <span class="text-sm">Arbeitgeber-Vollkosten einrechnen</span>
      </label>
    </div>
  </div>

  <div class="bg-bg-dark p-6 text-white md:p-8">
    <p class="text-xs font-medium uppercase tracking-wide text-white/68">Ihre Ersparnis</p>
    <div class="mt-2 border-t border-white/15 pt-6">
      <p class="text-xs uppercase tracking-wide text-white/68">Eingesparte Zeit pro Monat</p>
      <p id={`${id}-zeit`} class="font-mono text-4xl font-medium md:text-5xl">0 Std.</p>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-4 border-t border-white/15 pt-6">
      <div>
        <p class="text-xs uppercase tracking-wide text-white/68">Heutige Kosten</p>
        <p id={`${id}-heute`} class="mt-1 font-mono text-xl">0 €</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wide text-white/68">Kosten mit Assistent</p>
        <p id={`${id}-assistent`} class="mt-1 font-mono text-xl">0 €</p>
      </div>
    </div>

    <div class="mt-6 border-t border-white/15 pt-6">
      <p class="text-xs uppercase tracking-wide text-white/68">Ersparnis pro Monat</p>
      <p id={`${id}-ersparnis`} class="text-accent-end font-mono text-2xl font-medium">+0 €</p>
    </div>

    {fusszeile && <p class="mt-6 text-xs text-white/68">{fusszeile}</p>}

    <p id={`${id}-status`} role="status" aria-live="polite" class="sr-only"></p>
  </div>
</div>

<script is:inline define:vars={{ id, tierRanges, arbeitstageProMonat, einheitLabel, dauerLabel, anteilLabel, stundenlohnLabel }}>
  {
    const $ = (selector) => document.getElementById(selector);
    const einheitInput = $(`${id}-einheit`);
    const dauerInput = $(`${id}-dauer`);
    const anteilInput = $(`${id}-anteil`);
    const lohnInput = $(`${id}-lohn`);
    const vollkostenInput = $(`${id}-vollkosten`);

    const einheitWert = $(`${id}-einheit-wert`);
    const dauerWert = $(`${id}-dauer-wert`);
    const anteilWert = $(`${id}-anteil-wert`);
    const lohnWert = $(`${id}-lohn-wert`);

    const zeitOut = $(`${id}-zeit`);
    const heuteOut = $(`${id}-heute`);
    const assistentOut = $(`${id}-assistent`);
    const ersparnisOut = $(`${id}-ersparnis`);
    const statusOut = $(`${id}-status`);

    const euroFmt = (n) => new Intl.NumberFormat("de-DE", { maximumFractionDigits: 0 }).format(Math.round(n)) + " €";

    function findAssistentPreis(einheit) {
      const tier = tierRanges.find((t) => einheit >= t.min && einheit <= t.max);
      return tier ? tier.preis : tierRanges.length > 0 ? tierRanges[tierRanges.length - 1].preis : 0;
    }

    function berechne(announce) {
      const einheit = Number(einheitInput.value);
      const dauer = Number(dauerInput.value);
      const anteil = Number(anteilInput.value);
      const lohn = Number(lohnInput.value);
      const vollkosten = vollkostenInput.checked;

      einheitWert.textContent = String(einheit);
      dauerWert.textContent = String(dauer);
      anteilWert.textContent = `${anteil} %`;
      lohnWert.textContent = `${lohn} €`;

      einheitInput.setAttribute("aria-valuetext", `${einheit} ${einheitLabel}`);
      dauerInput.setAttribute("aria-valuetext", `${dauer} ${dauerLabel}`);
      anteilInput.setAttribute("aria-valuetext", `${anteil} Prozent, ${anteilLabel}`);
      lohnInput.setAttribute("aria-valuetext", `${lohn} Euro, ${stundenlohnLabel}`);

      const zeitMinutenProMonat = einheit * dauer * (anteil / 100) * arbeitstageProMonat;
      const zeitStunden = zeitMinutenProMonat / 60;
      const lohnfaktor = vollkosten ? 1.3 : 1;
      const heutigeKosten = zeitStunden * lohn * lohnfaktor;
      const assistentKosten = findAssistentPreis(einheit);
      const ersparnis = heutigeKosten - assistentKosten;

      zeitOut.textContent = `${zeitStunden.toFixed(1).replace(".0", "")} Std.`;
      heuteOut.textContent = euroFmt(heutigeKosten);
      assistentOut.textContent = euroFmt(assistentKosten);
      ersparnisOut.textContent = `${ersparnis >= 0 ? "+" : ""}${euroFmt(ersparnis)}`;

      if (announce) {
        statusOut.textContent = `Ergebnis aktualisiert: ${zeitOut.textContent} eingesparte Zeit pro Monat, ${ersparnisOut.textContent} Ersparnis pro Monat.`;
      }
    }

    [einheitInput, dauerInput, anteilInput, lohnInput].forEach((input) => {
      input.addEventListener("input", () => berechne(false));
      input.addEventListener("change", () => berechne(true));
    });
    vollkostenInput.addEventListener("change", () => berechne(true));

    berechne(false);
  }
</script>
