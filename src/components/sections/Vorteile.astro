---
/** „Ihre Vorteile“ (docs/DESIGNSYSTEM.md → Komponente 10, referenz/startseite/vorteile.html) */
interface Props {
  titel: string;
  intro: string;
  items: { icon: string; titel: string; text: string }[];
}
const { titel, intro, items } = Astro.props;
---

<section class="vorteile section-light" aria-labelledby="vorteile-titel">
  <div class="container-site vorteile__inner">
    <div class="vorteile__kopf" data-reveal>
      <h2 id="vorteile-titel" class="h2">{titel}</h2>
      <p class="lead">{intro}</p>
    </div>
    <ul class="vorteile__band" role="list" data-reveal-group>
      {
        items.map((item) => (
          <li class="vorteile__item" data-reveal>
            <svg class="vorteile__ico" viewBox="0 0 48 48" fill="none" aria-hidden="true" set:html={item.icon} />
            <h3>{item.titel}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .vorteile {
    padding: 92px 0 96px;
  }

  .vorteile__kopf {
    max-width: 600px;
    margin-bottom: 56px;
  }

  .vorteile__kopf h2 {
    margin-bottom: 14px;
  }

  .vorteile__band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vorteile__item {
    position: relative;
    padding: 0 32px;
  }

  .vorteile__item:first-child {
    padding-left: 0;
  }

  .vorteile__item:last-child {
    padding-right: 0;
  }

  .vorteile__item + .vorteile__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--line);
  }

  .vorteile__ico {
    width: 40px;
    height: 40px;
    margin-bottom: 22px;
  }

  .vorteile__item h3 {
    margin-bottom: 10px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  .vorteile__item p {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ink-72);
  }

  @media (max-width: 900px) {
    .vorteile__band {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 44px;
    }

    .vorteile__item {
      padding: 0 22px;
    }

    .vorteile__item:nth-child(odd) {
      padding-left: 0;
    }

    .vorteile__item:nth-child(even) {
      padding-right: 0;
    }

    .vorteile__item:nth-child(3)::before {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .vorteile {
      padding: 64px 0 68px;
    }

    .vorteile__kopf {
      margin-bottom: 40px;
    }

    .vorteile__band {
      grid-template-columns: 1fr;
      row-gap: 0;
    }

    .vorteile__item,
    .vorteile__item:nth-child(odd),
    .vorteile__item:nth-child(even) {
      padding: 26px 0;
    }

    .vorteile__item + .vorteile__item::before,
    .vorteile__item:nth-child(3)::before {
      display: block;
      left: 0;
      right: 0;
      top: 0;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .vorteile__ico {
      margin-bottom: 16px;
    }
  }
</style>
