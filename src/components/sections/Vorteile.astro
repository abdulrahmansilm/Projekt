---
/**
 * „Ihre Vorteile“ (docs/DESIGNSYSTEM.md → Komponente 10, überarbeitet 20.09.2026):
 * Vier Karten mit dunkler Icon-Kachel. Beim Drüberfahren: Karte hebt sich, ein Lichtkegel folgt dem Mauszeiger,
 * die Kachel kippt leicht und füllt sich mit dem Verlauf, unten läuft eine Akzentlinie ein.
 */
interface Props {
  titel: string;
  intro: string;
  items: { icon: string; titel: string; text: string }[];
}
const { titel, intro, items } = Astro.props;
---

<section class="vorteile section-light" aria-labelledby="vorteile-titel">
  <div class="container-site vorteile__inner">
    <div class="vorteile__kopf" data-reveal>
      <h2 id="vorteile-titel" class="h2">{titel}</h2>
      <p class="lead">{intro}</p>
    </div>
    <ul class="vorteile__band" role="list" data-reveal-group>
      {
        items.map((item) => (
          <li class="vorteile__item" data-reveal data-spot>
            <span class="vorteile__kachel" aria-hidden="true">
              <svg class="vorteile__ico" viewBox="0 0 48 48" fill="none" set:html={item.icon} />
            </span>
            <h3>{item.titel}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Lichtkegel folgt der Maus (nur mit echter Maus, reine CSS-Variablen, kein Layout)
  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".vorteile [data-spot]").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty("--mx", `${e.clientX - r.left}px`);
        el.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  }
</script>

<style>
  .vorteile {
    padding: 92px 0 100px;
  }

  .vorteile__kopf {
    max-width: 600px;
    margin-bottom: 52px;
  }

  .vorteile__kopf h2 {
    margin-bottom: 14px;
  }

  .vorteile__band {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vorteile__item {
    --mx: 50%;
    --my: 0%;
    position: relative;
    overflow: hidden;
    padding: 30px 26px 34px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(11, 46, 60, 0.05);
    transition:
      opacity 500ms var(--ease-out),
      transform 320ms var(--ease-out),
      box-shadow 320ms ease,
      border-color 320ms ease;
  }

  /* Lichtkegel unter dem Mauszeiger */
  .vorteile__item::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(240px circle at var(--mx) var(--my), rgba(79, 184, 166, 0.2), transparent 70%);
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  .vorteile__kachel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin-bottom: 24px;
    border-radius: 18px;
    background:
      radial-gradient(120% 120% at 80% 0%, rgba(79, 184, 166, 0.35), transparent 60%),
      var(--tiefsee);
    box-shadow: 0 10px 22px -10px rgba(11, 46, 60, 0.6);
    transition:
      transform 360ms var(--ease-out),
      box-shadow 360ms ease,
      background-color 360ms ease;
  }

  .vorteile__ico {
    width: 36px;
    height: 36px;
    transition: transform 360ms var(--ease-out);
  }

  .vorteile__item h3 {
    position: relative;
    margin-bottom: 10px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
  }

  .vorteile__item p {
    position: relative;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-72);
  }

  @media (hover: hover) and (pointer: fine) {
    .vorteile__band .vorteile__item:hover {
      transform: translateY(-8px);
      border-color: rgba(79, 184, 166, 0.5);
      box-shadow: 0 26px 44px -18px rgba(11, 46, 60, 0.3);
    }

    .vorteile__item:hover::before {
      opacity: 1;
    }

    .vorteile__item:hover .vorteile__kachel {
      transform: translateY(-2px) rotate(-6deg) scale(1.08);
      box-shadow: 0 16px 28px -10px rgba(27, 110, 122, 0.7);
    }

    .vorteile__item:hover .vorteile__ico {
      transform: scale(1.08) rotate(6deg);
    }
  }

  @media (max-width: 1000px) {
    .vorteile__band {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .vorteile {
      padding: 64px 0 68px;
    }

    .vorteile__kopf {
      margin-bottom: 36px;
    }

    .vorteile__band {
      grid-template-columns: 1fr;
    }

    .vorteile__item {
      padding: 26px 22px 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vorteile__item,
    .vorteile__item:hover,
    .vorteile__item:hover .vorteile__kachel,
    .vorteile__item:hover .vorteile__ico {
      transform: none;
    }
  }
</style>
