---
/**
 * Typische Anwendungsfälle als 3D-Flip-Karten (docs/DESIGNSYSTEM.md → Komponente 22i,
 * referenz/prozessautomatisierung/typische-anwendungsfaelle-trustbar.html).
 * Umklappen per Hover (echte Maus), Tap/Klick oder Tastatur (transparenter Button über der Karte, aria-pressed).
 * Beide Seiten stehen im DOM und werden vorgelesen.
 * 22.09.2026: Die 3D-Drehung (rotateY mit backface-visibility) lief auf manchen Geräten ruckelig und zeigte
 * beim Zurückdrehen kurz ein leeres Viereck. Ersetzt durch einen weichen Wechsel aus Opacity und Scale –
 * nur zusammengesetzte Eigenschaften, damit der Wechsel jederzeit flüssig bleibt und sich unterbrechen lässt.
 */
interface Props {
  eyebrow?: string;
  titel: string;
  intro?: string;
  karten: { nummer: string; icon: string; titel: string; text: string }[];
}
const { eyebrow, titel, intro, karten } = Astro.props;
const introText = intro?.replace("Tippen oder darüberfahren für Details.", "").trim();
---

<section class="af section-dark besondere-sektion" aria-labelledby="af-titel">
  <div class="af__inner">
    <div class="af__kopf" data-reveal>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="af-titel" class="h2">{titel}</h2>
      {
        intro && (
          <p class="lead">
            {introText} <span class="af__hinweis">Tippen oder darüberfahren für Details.</span>
          </p>
        )
      }
    </div>

    <ul class="af__grid" role="list" data-reveal-group>
      {
        karten.map((k) => (
          <li class="flip" data-flip data-reveal>
            <div class="flip__inner">
              <div class="flip__seite flip__vorne">
                <span class="flip__ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" set:html={k.icon} />
                </span>
                <h3>{k.titel}</h3>
                <span class="flip__mehr" aria-hidden="true">
                  Details ansehen
                  <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </span>
              </div>
              <div class="flip__seite flip__hinten">
                <h3 class="flip__tag" aria-hidden="true">{k.titel}</h3>
                <p class="flip__text">{k.text}</p>
              </div>
            </div>
            <button type="button" class="flip__knopf" aria-pressed="false">
              <span class="sr-only">Details zu {k.titel} umklappen</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-flip]").forEach((karte) => {
    const knopf = karte.querySelector<HTMLButtonElement>(".flip__knopf");
    knopf?.addEventListener("click", () => {
      const aktiv = karte.classList.toggle("is-aktiv");
      knopf.setAttribute("aria-pressed", String(aktiv));
    });
  });
</script>

<style>
  .af {
    --glow-pos: 78% 4%;
    padding: 96px 32px 72px;
  }

  .af__inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .af__kopf {
    max-width: 620px;
    margin-bottom: 56px;
  }

  .af__kopf .eyebrow {
    margin-bottom: 14px;
  }

  .af__kopf h2 {
    margin-bottom: 14px;
    color: #ffffff;
  }

  .af__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flip {
    position: relative;
    height: 310px;
  }

  .flip__inner {
    position: relative;
    width: 100%;
    height: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    .flip:hover .flip__ico {
      transform: scale(1.08) rotate(-4deg);
    }
  }

  .flip__knopf {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 18px;
    background: transparent;
    cursor: pointer;
  }

  .flip__knopf:focus-visible {
    outline: 2px solid var(--helltuerkis);
    outline-offset: 4px;
  }

  .flip__seite {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 30px 28px;
    border-radius: 18px;
    will-change: opacity, transform;
    transition:
      opacity 320ms var(--ease-out),
      transform 420ms var(--ease-out);
  }

  .flip__vorne {
    border: 1px solid rgba(240, 244, 243, 0.1);
    background: rgba(240, 244, 243, 0.035);
    opacity: 1;
    transform: scale(1);
  }

  /* Rückseite liegt darüber und blendet ein, sobald die Karte aktiv ist */
  .flip__hinten {
    opacity: 0;
    transform: scale(1.04);
    pointer-events: none;
  }

  .flip.is-aktiv .flip__vorne {
    opacity: 0;
    transform: scale(0.96);
  }

  .flip.is-aktiv .flip__hinten {
    opacity: 1;
    transform: scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .flip:hover .flip__vorne {
      opacity: 0;
      transform: scale(0.96);
    }

    .flip:hover .flip__hinten {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Runde 4: Piktogramm ohne Rahmen; Titel direkt darunter, unten ein Hinweis –
     so wirkt die Vorderseite nicht mehr leer */
  .flip__ico {
    display: flex;
    width: 46px;
    height: 46px;
    transition: transform 300ms var(--ease-out);
  }

  .flip__ico svg {
    width: 46px;
    height: 46px;
  }

  .flip__vorne h3 {
    margin-top: 22px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    color: #ffffff;
  }

  .flip__mehr {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    font-size: 14px;
    font-weight: 500;
    color: var(--helltuerkis);
  }

  .flip__mehr svg {
    width: 15px;
    height: 15px;
  }

  .flip__hinten {
    justify-content: center;
    background: linear-gradient(150deg, #1b6e7a, #123844);
    box-shadow: inset 0 0 60px rgba(79, 184, 166, 0.15);
  }

  .flip__tag {
    margin-bottom: 12px;
    font-family: var(--font-headline);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--helltuerkis);
  }

  .flip__text {
    font-size: 16px;
    line-height: 1.6;
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .af__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .af__grid {
      grid-template-columns: 1fr;
    }

    /* genug Höhe, damit auch lange Rückseiten-Texte vollständig passen */
    .flip {
      height: 320px;
    }

    .flip__text {
      font-size: 15px;
    }
  }

  @media (max-width: 560px) {
    .af {
      padding: 64px 20px 56px;
    }

    .af__kopf h2 {
      font-size: 27px;
    }
  }

  /* Reduzierte Bewegung: nur Ein-/Ausblenden, kein Skalieren */
  @media (prefers-reduced-motion: reduce) {
    .flip__seite,
    .flip.is-aktiv .flip__vorne,
    .flip.is-aktiv .flip__hinten,
    .flip:hover .flip__vorne,
    .flip:hover .flip__hinten {
      transform: none;
      transition: opacity 200ms ease;
    }

    .flip:hover .flip__ico {
      transform: none;
    }
  }
</style>
