---
/**
 * FAQ-Akkordeon (docs/DESIGNSYSTEM.md → Komponenten 15 und 21).
 * Single-Open, erste Frage geöffnet, aria-expanded/aria-controls.
 * Höhe über grid-template-rows (0fr → 1fr) statt max-height-Messung: unterbrechbar, ohne JS-Messung.
 * Öffnen 300ms ease-out, Schließen 200ms (asymmetrisch, emil-design-eng). Ohne JS sind alle Antworten sichtbar.
 */
interface Props {
  titel: string;
  intro?: string;
  fragen: { frage: string; antwort: string }[];
  id?: string;
}
const { titel, intro, fragen: alleFragen, id = "faq" } = Astro.props;
// Global gedeckelt: maximal 6 Einträge pro Seite (siehe Anforderungen 17.09.2026)
const fragen = alleFragen.slice(0, 6);
---

<section class="faq" aria-labelledby={`${id}-titel`}>
  <div class="faq__inner">
    <div class="faq__kopf" data-reveal>
      <h2 id={`${id}-titel`} class="h2">{titel}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>
    <div class="faq__liste" data-faq>
      {
        fragen.map((f, i) => (
          <div class:list={["faq-item", { "is-open": i === 0 }]} data-faq-item>
            <h3 class="faq-item__h">
              <button
                type="button"
                class="faq-item__frage"
                id={`${id}-frage-${i}`}
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`${id}-antwort-${i}`}
              >
                <span>{f.frage}</span>
                <span class="faq-item__chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </button>
            </h3>
            <div class="faq-item__antwort" id={`${id}-antwort-${i}`} role="region" aria-labelledby={`${id}-frage-${i}`}>
              <div class="faq-item__antwort-clip">
                <div class="faq-item__antwort-inner" set:html={f.antwort} />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((liste) => {
    const items = Array.from(liste.querySelectorAll<HTMLElement>("[data-faq-item]"));
    const setze = (item: HTMLElement, offen: boolean) => {
      item.classList.toggle("is-open", offen);
      item.querySelector("button")?.setAttribute("aria-expanded", String(offen));
    };
    items.forEach((item) => {
      item.querySelector("button")?.addEventListener("click", () => {
        const offen = !item.classList.contains("is-open");
        items.forEach((anderes) => anderes !== item && setze(anderes, false));
        setze(item, offen);
      });
    });
  });
</script>

<style>
  .faq {
    background: var(--nebel);
  }

  .faq__inner {
    max-width: 840px;
    margin: 0 auto;
    padding: 96px 32px 104px;
  }

  .faq__kopf {
    max-width: 560px;
    margin-bottom: 40px;
  }

  .faq__kopf h2 {
    margin-bottom: 14px;
  }

  .faq__liste {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    overflow: hidden;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 4px 16px rgba(11, 46, 60, 0.06);
  }

  .faq-item__h {
    margin: 0;
    font-size: inherit;
  }

  .faq-item__frage {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: 22px 24px;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-headline);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
  }

  .faq-item__frage:focus-visible {
    outline-offset: -4px;
    border-radius: 16px;
  }

  .faq-item__chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 50%;
    background: rgba(27, 110, 122, 0.08);
    color: var(--petrol);
    transition:
      background-color 200ms ease,
      color 200ms ease,
      transform 250ms var(--ease-out);
  }

  .faq-item__chevron svg {
    width: 14px;
    height: 14px;
  }

  .faq-item.is-open .faq-item__chevron {
    background: var(--verlauf);
    color: #ffffff;
    transform: rotate(180deg);
  }

  .faq-item__frage:active .faq-item__chevron {
    transform: scale(0.94);
  }

  .faq-item.is-open .faq-item__frage:active .faq-item__chevron {
    transform: rotate(180deg) scale(0.94);
  }

  .faq-item__antwort {
    display: grid;
    grid-template-rows: 1fr;
  }

  :global(.js) .faq-item__antwort {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 200ms var(--ease-out),
      visibility 0s linear 200ms;
  }

  :global(.js) .faq-item.is-open .faq-item__antwort {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 300ms var(--ease-out),
      visibility 0s;
  }

  .faq-item__antwort-clip {
    overflow: hidden;
    min-height: 0;
  }

  .faq-item__antwort-inner {
    max-width: 660px;
    padding: 0 24px 24px;
    font-size: 14.5px;
    line-height: 1.7;
    color: rgba(11, 46, 60, 0.82);
  }

  :global(.js) .faq-item__antwort-inner {
    opacity: 0;
    transition: opacity 150ms ease;
  }

  :global(.js) .faq-item.is-open .faq-item__antwort-inner {
    opacity: 1;
    transition: opacity 250ms ease 60ms;
  }

  /* Leistungsliste innerhalb einer Antwort (Startseiten-FAQ) */
  .faq-item__antwort-inner :global(.svc-groups) {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 14px;
  }

  .faq-item__antwort-inner :global(.svc-group h4) {
    margin-bottom: 7px;
    font-family: var(--font-headline);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--petrol);
  }

  .faq-item__antwort-inner :global(.svc-group ul) {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .faq-item__antwort-inner :global(.svc-group li) {
    padding: 6px 13px;
    border-radius: 999px;
    background: rgba(79, 184, 166, 0.12);
    font-size: 13px;
  }

  .faq-item__antwort-inner :global(.svc-group li.soon) {
    background: rgba(11, 46, 60, 0.06);
    color: rgba(11, 46, 60, 0.68);
  }

  @media (max-width: 600px) {
    .faq__inner {
      padding: 64px 20px 72px;
    }

    .faq-item__frage {
      padding: 18px;
      font-size: 15px;
    }

    .faq-item__antwort-inner {
      padding: 0 18px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .faq-item__antwort,
    :global(.js) .faq-item.is-open .faq-item__antwort,
    .faq-item__chevron {
      transition: none;
    }
  }
</style>
