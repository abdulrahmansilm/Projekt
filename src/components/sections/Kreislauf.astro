---
/**
 * Sicherungs-Kreislauf als 4-Segment-Kreisdiagramm (docs/DESIGNSYSTEM.md → Komponente 22e,
 * referenz/datensicherung/kreislauf.html). Unter 760px zeigt der Kreis nur Nummer/Titel/Frequenz,
 * die Beschreibungen stehen als Legende darunter. Für Screenreader ist die Legende die maßgebliche Liste.
 */
interface Props {
  eyebrow?: string;
  titel: string;
  intro?: string;
  hubTitel: string;
  hubText: string;
  phasen: { nummer: string; titel: string; text: string; legende: string; frequenz: string }[];
  hinweis: string;
}
const { eyebrow, titel, intro, hubTitel, hubText, phasen, hinweis } = Astro.props;
const positionen = ["ne", "se", "sw", "nw"];
---

<section class="kl section-dark besondere-sektion" aria-labelledby="kl-titel">
  <div class="kl__inner">
    <div class="kl__kopf" data-reveal>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="kl-titel" class="h2">{titel}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>

    <div class="kreis" aria-hidden="true" data-reveal>
      <svg class="kreis__ring" viewBox="0 0 700 700">
        <defs>
          <linearGradient id="kl-g1" x1="350" y1="120" x2="600" y2="350" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#4FB8A6" stop-opacity="0.09"></stop>
            <stop offset="1" stop-color="#4FB8A6" stop-opacity="0.04"></stop>
          </linearGradient>
          <linearGradient id="kl-g2" x1="600" y1="350" x2="350" y2="600" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#4FB8A6" stop-opacity="0.17"></stop>
            <stop offset="1" stop-color="#4FB8A6" stop-opacity="0.08"></stop>
          </linearGradient>
          <linearGradient id="kl-g3" x1="350" y1="600" x2="100" y2="350" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#4FB8A6" stop-opacity="0.26"></stop>
            <stop offset="1" stop-color="#4FB8A6" stop-opacity="0.13"></stop>
          </linearGradient>
          <linearGradient id="kl-g4" x1="100" y1="350" x2="350" y2="120" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#4FB8A6" stop-opacity="0.36"></stop>
            <stop offset="1" stop-color="#4FB8A6" stop-opacity="0.19"></stop>
          </linearGradient>
        </defs>
        <path class="seg" fill="url(#kl-g1)" d="M350,20 A330,330 0 0,1 680,350 L586.4,391.7 L500,350 A150,150 0 0,0 350,200 L391.7,113.6 Z"></path>
        <path class="seg" fill="url(#kl-g2)" d="M680,350 A330,330 0 0,1 350,680 L308.3,586.4 L350,500 A150,150 0 0,0 500,350 L586.4,391.7 Z"></path>
        <path class="seg" fill="url(#kl-g3)" d="M350,680 A330,330 0 0,1 20,350 L113.6,308.3 L200,350 A150,150 0 0,0 350,500 L308.3,586.4 Z"></path>
        <path class="seg" fill="url(#kl-g4)" d="M20,350 A330,330 0 0,1 350,20 L391.7,113.6 L350,200 A150,150 0 0,0 200,350 L113.6,308.3 Z"></path>
      </svg>

      <div class="hub">
        <strong>{hubTitel}</strong>
        <span>{hubText}</span>
      </div>

      {
        phasen.map((p, i) => (
          <div class="knoten" data-pos={positionen[i]}>
            <div class="knoten__num">{p.nummer}</div>
            <p class="knoten__titel">{p.titel}</p>
            <p class="knoten__text">{p.text}</p>
            <span class="knoten__freq">{p.frequenz}</span>
          </div>
        ))
      }
    </div>

    <ol class="legende" role="list">
      {
        phasen.map((p) => (
          <li class="legende__zeile">
            <span class="legende__num" aria-hidden="true">
              {p.nummer}
            </span>
            <div>
              <h3>
                <span class="sr-only">Phase {p.nummer}: </span>
                {p.titel} <span class="legende__freq">({p.frequenz})</span>
              </h3>
              <p>{p.legende}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="kl__hinweis">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M4 12 A8 8 0 0 1 19.5 8.5 M16.3 5.2 L19.6 8.6 L22.6 5.4 M20 12 A8 8 0 0 1 4.5 15.5 M7.7 18.8 L4.4 15.4 L1.4 18.6"
          stroke="rgba(240,244,243,0.55)"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {hinweis}
    </p>
  </div>
</section>

<style>
  .kl {
    --glow-pos: 50% 4%;
    padding: 96px 32px 104px;
  }

  .kl__inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .kl__kopf {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }

  .kl__kopf .eyebrow {
    margin-bottom: 14px;
  }

  .kl__kopf h2 {
    margin-bottom: 14px;
    color: #ffffff;
  }

  .kreis {
    position: relative;
    width: 100%;
    max-width: 680px;
    margin: 64px auto 0;
    aspect-ratio: 1 / 1;
  }

  .kreis__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .seg {
    stroke: rgba(79, 184, 166, 0.28);
    stroke-width: 1.5;
    stroke-linejoin: round;
    transition: stroke 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .kreis:hover .seg {
      stroke: rgba(79, 184, 166, 0.14);
    }

    .kreis .seg:hover {
      stroke: rgba(79, 184, 166, 0.55);
    }
  }

  .hub {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 42.9%;
    height: 42.9%;
    padding: 8%;
    border-radius: 50%;
    background: #0b2e3c;
    text-align: center;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .hub strong {
    margin-bottom: 9px;
    font-family: var(--font-headline);
    font-size: clamp(13px, 2.7vw, 19px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #ffffff;
    hyphens: auto;
  }

  .hub span {
    font-size: clamp(9.5px, 1.75vw, 13px);
    line-height: 1.5;
    color: rgba(240, 244, 243, 0.68);
  }

  .knoten {
    position: absolute;
    z-index: 1;
    width: 22%;
    color: #ffffff;
    text-align: center;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .knoten[data-pos="ne"] {
    left: 74.2%;
    top: 25.8%;
  }

  .knoten[data-pos="se"] {
    left: 74.2%;
    top: 74.2%;
  }

  .knoten[data-pos="sw"] {
    left: 25.8%;
    top: 74.2%;
  }

  .knoten[data-pos="nw"] {
    left: 25.8%;
    top: 25.8%;
  }

  .knoten__num {
    margin-bottom: 7px;
    font-family: var(--font-headline);
    font-size: clamp(20px, 4.4vw, 34px);
    font-weight: 500;
    line-height: 1;
    color: rgba(127, 217, 196, 0.7);
  }

  .knoten__titel {
    margin-bottom: 5px;
    font-family: var(--font-headline);
    font-size: clamp(12px, 2.3vw, 17px);
    font-weight: 600;
    line-height: 1.25;
  }

  .knoten__text {
    font-size: clamp(9px, 1.6vw, 12.5px);
    line-height: 1.45;
    color: rgba(240, 244, 243, 0.75);
  }

  .knoten__freq {
    display: block;
    margin-top: 7px;
    font-family: var(--font-headline);
    font-size: clamp(7.5px, 1.25vw, 9.5px);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(127, 217, 196, 0.8);
  }

  /* Legende: auf Desktop nur für Screenreader, mobil sichtbar */
  .legende {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    list-style: none;
  }

  .kl__hinweis {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 44px;
    font-size: 13.5px;
    text-align: center;
    color: rgba(240, 244, 243, 0.62);
  }

  .kl__hinweis svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    .kl {
      padding: 72px 20px 80px;
    }

    .kl__kopf h2 {
      font-size: 27px;
    }

    .kreis {
      margin-top: 44px;
    }

    .knoten__text,
    .hub span {
      display: none;
    }

    .knoten {
      width: 25%;
    }

    .hub {
      padding: 10%;
    }

    .legende {
      position: static;
      width: auto;
      height: auto;
      margin: 36px 0 0;
      overflow: visible;
      clip: auto;
      display: flex;
      flex-direction: column;
      border-top: 1px solid rgba(240, 244, 243, 0.12);
    }

    .legende__zeile {
      display: grid;
      grid-template-columns: 28px 1fr;
      gap: 14px;
      padding: 16px 0;
      border-bottom: 1px solid rgba(240, 244, 243, 0.12);
    }

    .legende__num {
      padding-top: 1px;
      font-family: var(--font-headline);
      font-size: 13px;
      font-weight: 600;
      color: rgba(127, 217, 196, 0.8);
    }

    .legende h3 {
      margin-bottom: 4px;
      font-size: 15.5px;
      font-weight: 600;
      color: #ffffff;
    }

    .legende__freq {
      font-size: 12px;
      font-weight: 500;
      color: rgba(127, 217, 196, 0.85);
    }

    .legende p {
      font-size: 13.5px;
      line-height: 1.55;
      color: rgba(240, 244, 243, 0.72);
    }
  }

  @media (max-width: 420px) {
    .knoten__num {
      font-size: 19px;
    }

    .knoten__titel {
      font-size: 11.5px;
    }

    .knoten__freq {
      font-size: 7px;
    }

    .hub strong {
      font-size: 12.5px;
    }
  }
</style>
