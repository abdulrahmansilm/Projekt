---
/**
 * Pricing mit 3 Paketen (docs/DESIGNSYSTEM.md → Komponente 1; referenz/it-betreuung/pricing.html,
 * referenz/server-betreuung/pricing.html, referenz/webseiten/pricing.html).
 * Monatlich/Jährlich-Umschalter als echte Radiogruppe; Preise für beide Zahlweisen stehen im HTML
 * und werden per CSS umgeschaltet (funktioniert ohne JavaScript). Farben auf die Kernpalette abgebildet.
 */
import { uebersetzer, kontaktAnker, zahl } from "../../i18n";

type Paket = {
  name: string;
  variante: "neutral" | "beliebt" | "premium";
  badge?: string;
  claim: string;
  preis: number;
  /** z. B. „ab“ vor dem Preis (Webentwicklung Premium) */
  prefix?: string;
  geraetPreis?: number;
  reaktion?: { wert: string; sub: string };
  diffTitel: string;
  geerbt: boolean;
  diffs: string[];
  cta: string;
};

interface Props {
  eyebrow?: string;
  titel: string;
  intro?: string;
  chips: { titel: string; sub: string; icon: string; items: string[] };
  jahresRabatt?: number;
  rabattHinweis?: string;
  einheit: string;
  geraetEinheit?: string;
  pakete: Paket[];
  vergleich?: { label: string; werte?: string[]; preisFeld?: "preis" | "geraetPreis"; betont?: boolean }[];
  /** Regler über den Paketen (Geräte-/Serveranzahl) mit automatischer Neuberechnung */
  slider?: { label: string; einzahl: string; mehrzahl: string; min: number; max: number; start: number; hinweis?: string };
  zusatz?: {
    titel: string;
    sub: string;
    karten: {
      icon: string;
      badge?: string;
      name: string;
      claim: string;
      preisLabel?: string;
      preisEinheit?: string;
      notiz?: string;
      features: string[];
      cta: string;
      /** Runde 4: Verweis auf die passende Leistungsseite */
      link?: { text: string; href: string };
    }[];
  };
}

const { titel, intro, chips, jahresRabatt, einheit, geraetEinheit, pakete, vergleich, zusatz, slider } = Astro.props;
const id = `preise-${Math.random().toString(36).slice(2, 7)}`;
const t = uebersetzer(Astro);
const KONTAKT_ANKER = kontaktAnker(t.lang);
const betrag = (n: number) => n.toLocaleString(t.lang === "en" ? "en-US" : "de-DE", { maximumFractionDigits: 2 });
const euro = (n: number) => (t.lang === "en" ? `€${betrag(n)}` : `${betrag(n)} €`);
/** Vorlagen für die Neuberechnung im Browser (Regler), in der Seitensprache */
const vorlagen = {
  grundpreis: t("+ {betrag} Grundpreis / Monat"),
  proGeraet: t("pro Gerät / Monat"),
  fuer: t("für {n} {einheit} / Monat"),
  proEinheit: t("/ {einheit} / Monat"),
};
/** Runde 4: reduzierter Jahrespreis wird auf den nächsten vollen Euro aufgerundet */
const jahr = (n: number) => Math.ceil(Math.round(n * (1 - (jahresRabatt ?? 0)) * 100) / 100);
const mitToggle = typeof jahresRabatt === "number";
/** Ersparnis steht seit 22.09.2026 direkt im Umschalt-Button statt als Satz daneben */
const rabattProzent = Math.round((jahresRabatt ?? 0) * 100);
const sliderModus = slider ? (pakete.some((p) => p.geraetPreis !== undefined) ? "geraet" : "menge") : null;
const start = slider?.start ?? 1;
const bruttoStart = (p: (typeof pakete)[number]) => (sliderModus === "geraet" ? (p.geraetPreis ?? 0) * start : sliderModus === "menge" ? p.preis * start : p.preis);
const periodeStart = () => {
  if (!slider) return einheit;
  if (sliderModus === "geraet") return start === 1 ? vorlagen.proGeraet : t("für {n} {einheit} / Monat", { n: start, einheit: slider.mehrzahl });
  return start === 1 ? t("/ {einheit} / Monat", { einheit: slider.einzahl }) : t("für {n} {einheit} / Monat", { n: start, einheit: slider.mehrzahl });
};
---

<section class:list={["preise", { "preise--toggle": mitToggle }]} id="preise" aria-labelledby={`${id}-titel`} data-preise data-rabatt={jahresRabatt ?? 0} data-modus={sliderModus ?? "keiner"} data-lang={t.lang} data-vorlagen={JSON.stringify(vorlagen)}>
  <svg width="0" height="0" class="preise__defs" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="preise-verlauf" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#4FB8A6"></stop>
        <stop offset="1" stop-color="#1B6E7A"></stop>
      </linearGradient>
      <linearGradient id="de-flagge" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1A1A1A"></stop><stop offset="0.333" stop-color="#1A1A1A"></stop>
        <stop offset="0.333" stop-color="#D00000"></stop><stop offset="0.666" stop-color="#D00000"></stop>
        <stop offset="0.666" stop-color="#FFCE00"></stop><stop offset="1" stop-color="#FFCE00"></stop>
      </linearGradient>
    </defs>
  </svg>

  <div class="preise__wrap">
    <div class="preise__kopf" data-reveal>
      <h2 id={`${id}-titel`} class="h2">{titel}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>

    <div class="basis" data-reveal>
      <div class="basis__kopf">
        <span class="basis__ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={chips.icon} />
        </span>
        <div>
          <h3 class="basis__titel">{chips.titel}</h3>
          <p class="basis__sub">{chips.sub}</p>
        </div>
      </div>
      <ul class="basis__chips" role="list">
        {
          chips.items.map((c) => (
            <li class="chip">
              <span class="chip__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              {c}
            </li>
          ))
        }
      </ul>
    </div>

    {
      slider && (
        <div class="rechner" data-reveal>
          <label class="rechner__label" for={`${id}-slider`}>
            {slider.label}
          </label>
          <div class="rechner__zeile">
            <input
              id={`${id}-slider`}
              class="rechner__regler"
              type="range"
              min={slider.min}
              max={slider.max}
              step="1"
              value={slider.start}
              data-slider
              data-einzahl={slider.einzahl}
              data-mehrzahl={slider.mehrzahl}
              style={`--p:${((slider.start - slider.min) / (slider.max - slider.min)) * 100}%`}
            />
            <output class="rechner__wert" for={`${id}-slider`} data-slider-out>
              {slider.start} {slider.start === 1 ? slider.einzahl : slider.mehrzahl}
            </output>
          </div>
          {slider.hinweis && <p class="rechner__hinweis">{slider.hinweis}</p>}
        </div>
      )
    }

    {
      mitToggle && (
        <div class="zahlweise">
          <fieldset class="umschalter">
            <legend class="sr-only">{t("Vertragslaufzeit")}</legend>
            <span class="umschalter__daumen" aria-hidden="true" />
            <label>
              <input type="radio" name={`${id}-zahlweise`} value="monatlich" checked />
              <span>
                {t("Monatlich")}
                {/* unsichtbarer Platzhalter: hält beide Hälften exakt gleich breit */}
                <span class="umschalter__rabatt umschalter__rabatt--platz" aria-hidden="true">{t("−{n} %", { n: rabattProzent })}</span>
              </span>
            </label>
            <label>
              <input type="radio" name={`${id}-zahlweise`} value="jaehrlich" />
              <span>
                {t("Jährlich")}
                <span class="umschalter__rabatt">{t("−{n} %", { n: rabattProzent })}</span>
              </span>
            </label>
          </fieldset>
        </div>
      )
    }

    <ul class="karten" role="list" data-reveal-group>
      {
        pakete.map((p) => (
          <li class:list={["karte", `karte--${p.variante}`, { "on-dark": p.variante === "premium" }]} data-reveal>
            {p.badge && <span class="karte__badge">{p.badge}</span>}
            <h3 class="karte__name">{p.name}</h3>
            <p class="karte__claim">{p.claim}</p>
            <div class="preisblock" data-karte data-preis={p.preis} data-geraet={p.geraetPreis ?? ""}>
              <p class="karte__preis">
                {p.prefix && <span class="karte__prefix">{p.prefix}</span>}
                <span class="preis preis--monat" data-out="gross-monat">{euro(bruttoStart(p))}</span>
                {mitToggle && <span class="preis preis--jahr" data-out="gross-jahr">{euro(jahr(bruttoStart(p)))}</span>}
                <span class="karte__periode" data-out="periode">{periodeStart()}</span>
              </p>
              {sliderModus === "geraet" && p.geraetPreis !== undefined && (
                <p class="karte__klein">
                  {/* Runde 4: Der Grundpreis ist ein Monatspreis und sinkt bei jährlicher Zahlung nicht */}
                  <span data-out="klein-monat">{t("+ {betrag} Grundpreis / Monat", { betrag: euro(p.preis) })}</span>
                </p>
              )}
              {!slider && p.geraetPreis !== undefined && (
                <p class="karte__geraet">
                  <span class="preis--monat">+ {zahl(p.geraetPreis, t.lang)}</span>
                  {mitToggle && <span class="preis--jahr">+ {zahl(jahr(p.geraetPreis), t.lang)}</span>} {geraetEinheit}
                </p>
              )}
            </div>
            <a
              class:list={["btn btn--sm btn--block karte__cta", { "btn--hell": p.variante === "premium" }]}
              href={KONTAKT_ANKER}
              aria-label={t("{cta}: Paket {paket}", { cta: p.cta, paket: p.name })}
            >
              <span>{p.cta}</span>
            </a>
            {p.reaktion && (
              <div class="reaktion">
                <p class="reaktion__label">{t("Reaktionszeit")}</p>
                <p class="reaktion__wert">{p.reaktion.wert}</p>
                <p class="reaktion__sub">{p.reaktion.sub}</p>
              </div>
            )}
            {p.geerbt ? (
              <p class="diff-titel diff-titel--geerbt">
                <span class="plus" aria-hidden="true">
                  +
                </span>
                {p.diffTitel}
              </p>
            ) : (
              <p class="diff-titel">{p.diffTitel}</p>
            )}
            <ul class="diffs" role="list">
              {p.diffs.map((d) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <p class="netto">{t("Alle Preise verstehen sich netto zuzüglich der gesetzlichen Umsatzsteuer.")}</p>

    {
      vergleich && (
        <details class="vergleich">
          <summary>
            {t("Vollständigen Funktionsvergleich anzeigen")}
            <svg class="vergleich__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="vergleich__scroll">
            <table>
              <caption class="sr-only">{t("Funktionsvergleich der Pakete")}</caption>
              <thead>
                <tr>
                  <td />
                  {pakete.map((p) => (
                    <th scope="col">{p.name}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {vergleich.map((z) => (
                  <tr class:list={{ "ist-betont": z.betont }}>
                    <th scope="row">{z.label}</th>
                    {z.preisFeld
                      ? pakete.map((p) => (
                          <td>
                            <span class={z.preisFeld === "preis" && sliderModus === "geraet" ? undefined : "preis--monat"}>{euro(p[z.preisFeld!] ?? 0)}</span>
                            {mitToggle && !(z.preisFeld === "preis" && sliderModus === "geraet") && <span class="preis--jahr">{euro(jahr(p[z.preisFeld!] ?? 0))}</span>}
                          </td>
                        ))
                      : (z.werte ?? []).map((w) => (
                          <td>
                            {w === "✓" ? (
                              <>
                                <span class="wert-ja" aria-hidden="true">✓</span>
                                <span class="sr-only">{t("enthalten")}</span>
                              </>
                            ) : w === "–" ? (
                              <>
                                <span class="wert-nein" aria-hidden="true">–</span>
                                <span class="sr-only">{t("nicht enthalten")}</span>
                              </>
                            ) : (
                              w
                            )}
                          </td>
                        ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )
    }

    {
      zusatz && (
        <div class="zusatz">
          <h3 class="zusatz__titel">{zusatz.titel}</h3>
          <p class="zusatz__sub">{zusatz.sub}</p>
          <ul class:list={["zusatz__grid", { "zusatz__grid--einzeln": zusatz.karten.length === 1, "zusatz__grid--zwei": zusatz.karten.length === 2 }]} role="list">
            {zusatz.karten.map((z) => (
              <li class:list={["karte", z.badge ? "karte--beliebt" : "karte--neutral"]}>
                {z.badge && <span class="karte__badge">{z.badge}</span>}
                <div class="karte__name-zeile">
                  <span class="karte__name-ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="url(#preise-verlauf)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={z.icon} />
                  </span>
                  <h4 class="karte__name">{z.name}</h4>
                </div>
                <p class="karte__claim">{z.claim}</p>
                <a class="btn btn--sm btn--block karte__cta karte__cta--oben" href={KONTAKT_ANKER} aria-label={`${z.cta}: ${z.name}`}>
                  <span>{z.cta}</span>
                </a>
                <div class="zusatz__preis">
                  {z.preisLabel && (
                    <p class="karte__preis">
                      <span class="preis">{z.preisLabel}</span>
                      {z.preisEinheit && <span class="karte__periode">{z.preisEinheit}</span>}
                    </p>
                  )}
                  {z.notiz && <p class="karte__jahresnotiz karte__jahresnotiz--fest">{z.notiz}</p>}
                </div>
                <div class="karte__trenner" />
                <p class="diff-titel">{t("Enthaltene Leistungen")}</p>
                <ul class="diffs" role="list">
                  {z.features.map((f) => (
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
                {z.link ? (
                  <a class="zusatz__link" href={z.link.href}>
                    <span>{z.link.text}</span>
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                ) : (
                  <span class="zusatz__link-platz" aria-hidden="true" />
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<script>
  /**
   * Regler für Geräte-/Serveranzahl: berechnet je Paket den Gesamtpreis neu.
   * Modus "geraet": groß = Gerätepreis × Anzahl, klein = "+ Grundpreis".
   * Modus "menge":  groß = Paketpreis × Anzahl, klein = Preis pro Einheit.
   */
  document.querySelectorAll<HTMLElement>("[data-preise]").forEach((root) => {
    const en = root.dataset.lang === "en";
    const betrag = (n: number) => n.toLocaleString(en ? "en-US" : "de-DE", { maximumFractionDigits: 2 });
    const euro = (n: number) => (en ? `€${betrag(n)}` : `${betrag(n)} €`);
    const v = JSON.parse(root.dataset.vorlagen ?? "{}") as Record<string, string>;
    const fuelle = (vorlage: string, werte: Record<string, string | number>) =>
      Object.entries(werte).reduce((s, [k, w]) => s.replaceAll(`{${k}}`, String(w)), vorlage);
    const regler = root.querySelector<HTMLInputElement>("[data-slider]");
    const ausgabe = root.querySelector<HTMLOutputElement>("[data-slider-out]");
    if (!regler || !ausgabe) return;
    const modus = root.dataset.modus;
    const rabatt = Number(root.dataset.rabatt ?? 0);
    const jahr = (n: number) => Math.ceil(Math.round(n * (1 - rabatt) * 100) / 100);
    const einzahl = regler.dataset.einzahl ?? "";
    const mehrzahl = regler.dataset.mehrzahl ?? "";
    const setze = (el: Element, teil: string, text: string) => {
      const ziel = el.querySelector<HTMLElement>(`[data-out="${teil}"]`);
      if (ziel) ziel.textContent = text;
    };
    const berechne = () => {
      const n = Number(regler.value);
      const min = Number(regler.min);
      const max = Number(regler.max);
      regler.style.setProperty("--p", `${((n - min) / (max - min)) * 100}%`);
      ausgabe.textContent = `${n} ${n === 1 ? einzahl : mehrzahl}`;
      regler.setAttribute("aria-valuetext", ausgabe.textContent);
      root.querySelectorAll<HTMLElement>("[data-karte]").forEach((k) => {
        const preis = Number(k.dataset.preis);
        const geraet = Number(k.dataset.geraet);
        const gross = modus === "geraet" ? geraet * n : preis * n;
        setze(k, "gross-monat", euro(gross));
        setze(k, "gross-jahr", euro(jahr(gross)));
        if (modus === "geraet") {
          setze(k, "klein-monat", fuelle(v.grundpreis, { betrag: euro(preis) }));
          setze(k, "periode", n === 1 ? v.proGeraet : fuelle(v.fuer, { n, einheit: mehrzahl }));
        } else {
          setze(k, "periode", n === 1 ? fuelle(v.proEinheit, { einheit: einzahl }) : fuelle(v.fuer, { n, einheit: mehrzahl }));
        }
      });
    };
    regler.addEventListener("input", berechne);
    berechne();
  });
</script>

<style>
  .preise {
    padding: 96px 24px 104px;
    background: var(--nebel);
  }

  .preise__defs {
    position: absolute;
  }

  .preise__wrap {
    max-width: 980px;
    margin: 0 auto;
  }

  .preise__kopf {
    max-width: 560px;
    margin-bottom: 32px;
  }

  .preise__kopf h2 {
    margin-bottom: 10px;
  }

  /* ---------- Grundausstattung ---------- */
  .basis {
    margin-bottom: 28px;
    padding: 26px 30px;
    border: 1px solid rgba(11, 46, 60, 0.14);
    border-radius: 18px;
    background: #ffffff;
  }

  .basis__kopf {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .basis__ico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 12px;
    background: var(--verlauf);
    box-shadow: 0 4px 12px rgba(27, 110, 122, 0.25);
  }

  .basis__ico svg {
    width: 20px;
    height: 20px;
  }

  .basis__titel {
    font-size: 17px;
    font-weight: 700;
  }

  .basis__sub {
    margin-top: 2px;
    font-size: 13.5px;
    color: var(--ink-72);
  }

  .basis__chips {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 500;
  }

  /* Runde 4: Häkchen ohne Kreis */
  .chip__ico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--petrol);
  }

  .chip__ico svg {
    width: 17px;
    height: 17px;
  }

  /* ---------- Zahlweise (kompakt, direkt über den Paketen) ---------- */
  .zahlweise {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 16px;
    margin-bottom: 26px;
  }

  /* ---------- Regler (Geräte-/Serveranzahl): so breit wie die drei Pakete ---------- */
  .rechner {
    margin: 0 0 20px;
    padding: 22px 26px 20px;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 4px 18px rgba(11, 46, 60, 0.07);
  }

  .rechner__label {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-headline);
    font-size: 16px;
    font-weight: 600;
  }

  .rechner__zeile {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .rechner__regler {
    --p: 0%;
    flex: 1;
    height: 28px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .rechner__regler::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--tuerkis) 0%, var(--petrol) var(--p), rgba(11, 46, 60, 0.14) var(--p));
  }

  .rechner__regler::-moz-range-track {
    height: 6px;
    border-radius: 3px;
    background: rgba(11, 46, 60, 0.14);
  }

  .rechner__regler::-moz-range-progress {
    height: 6px;
    border-radius: 3px;
    background: var(--petrol);
  }

  .rechner__regler::-webkit-slider-thumb {
    width: 24px;
    height: 24px;
    margin-top: -9px;
    border: 3px solid #ffffff;
    border-radius: 50%;
    background: var(--petrol);
    box-shadow: 0 2px 8px rgba(11, 46, 60, 0.35);
    -webkit-appearance: none;
    appearance: none;
    transition: transform 160ms var(--ease-out);
  }

