---
/**
 * „Wie eine Konversation abläuft“ (docs/DESIGNSYSTEM.md → Komponente 22h,
 * referenz/whatsapp-chatbot/wie-konversation-ablaeuft.html). Sticky-Textspalte ab 920px, Schritt 3 als Kernstück.
 * Sticky ohne transform (translateY(-50%) auf sticky Elementen führt zu Überlappungen am Sektionsende).
 */
interface Props {
  eyebrow: string;
  titelVor: string;
  akzent: string;
  titelNach: string;
  intro: string;
  schritte: { icon: string; titel: string; text: string; kern?: boolean; tag?: string; chips?: string[] }[];
  abschluss: { icon: string; titel: string; text: string };
}
const { eyebrow, titelVor, akzent, titelNach, intro, schritte, abschluss } = Astro.props;
---

<section class="ko" aria-labelledby="ko-titel">
  <div class="ko__inner">
    <div class="ko__textspalte">
      <div class="ko__text" data-reveal>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="ko-titel">{titelVor} <span class="text-verlauf">{akzent}</span> {titelNach}</h2>
        <p class="ko__intro">{intro}</p>
      </div>
    </div>

    <div>
      <ol class="prozess" role="list" data-reveal>
        {
          schritte.map((s, i) => (
            <>
              {i > 0 && <li class="verbinder" aria-hidden="true" />}
              <li class:list={["pk", { "pk--kern": s.kern }]}>
                <span class="pk__ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" set:html={s.icon} />
                </span>
                <div>
                  {s.tag && <span class="pk__tag">{s.tag}</span>}
                  <h3>{s.titel}</h3>
                  <p>{s.text}</p>
                  {s.chips && (
                    <ul class="pk__chips" role="list" aria-label="Angebundene Systeme">
                      {s.chips.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            </>
          ))
        }
      </ol>

      <div class="pfeil" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 4 V19 M6 13 L12 19 L18 13" stroke="rgba(11,46,60,0.4)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>

      <div class="abschluss" data-reveal>
        <span class="abschluss__ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" set:html={abschluss.icon} />
        </span>
        <div>
          <h3>{abschluss.titel}</h3>
          <p>{abschluss.text}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ko {
    padding: 96px 32px 104px;
    background: var(--nebel);
  }

  .ko__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 64px;
    align-items: start;
    max-width: 1140px;
    margin: 0 auto;
  }

  .ko__textspalte {
    position: sticky;
    top: calc(var(--header-h) + 48px);
  }

  .ko__text .eyebrow {
    margin-bottom: 18px;
  }

  .ko__text h2 {
    margin-bottom: 20px;
    font-size: 38px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .ko__intro {
    max-width: 380px;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink-72);
  }

  .prozess {
    margin: 0;
    padding: 24px 22px;
    border: 1.5px dashed rgba(11, 46, 60, 0.22);
    border-radius: 22px;
    list-style: none;
  }

  .verbinder {
    display: flex;
    justify-content: center;
    height: 22px;
  }

  .verbinder::before {
    content: "";
    width: 1.5px;
    background: repeating-linear-gradient(180deg, rgba(27, 110, 122, 0.4) 0 5px, transparent 5px 9px);
  }

  .pk,
  .abschluss {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 16px;
    padding: 20px 22px;
    border: 1.5px solid transparent;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 3px 14px rgba(11, 46, 60, 0.055);
    transition:
      transform 200ms var(--ease-out),
      box-shadow 200ms ease,
      border-color 200ms ease;
  }

  .pk__ico,
  .abschluss__ico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 13px;
    background: rgba(79, 184, 166, 0.12);
    transition:
      background-color 200ms ease,
      transform 200ms var(--ease-out);
  }

  .abschluss__ico {
    border-radius: 50%;
  }

  .pk__ico svg,
  .abschluss__ico svg {
    width: 22px;
    height: 22px;
  }

  .abschluss__ico :global(path),
  .abschluss__ico :global(circle) {
    stroke: var(--petrol);
  }

  .pk h3,
  .abschluss h3 {
    margin-bottom: 6px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .abschluss h3 {
    color: var(--petrol);
  }

  .pk p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-72);
  }

  .abschluss {
    border-color: rgba(11, 46, 60, 0.1);
    border-radius: 18px;
  }

  .abschluss p {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-72);
  }

  .pk--kern {
    border-color: rgba(79, 184, 166, 0.3);
    background: linear-gradient(155deg, rgba(79, 184, 166, 0.11), rgba(79, 184, 166, 0.02)), #ffffff;
  }

  .pk--kern .pk__ico {
    background: var(--verlauf);
  }

  .pk--kern .pk__ico :global([stroke]) {
    stroke: #ffffff;
  }

  .pk__tag {
    display: inline-block;
    margin-bottom: 8px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(79, 184, 166, 0.16);
    color: var(--petrol);
    font-family: var(--font-headline);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pk__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .pk__chips li {
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(79, 184, 166, 0.14);
    color: var(--petrol);
    font-family: var(--font-headline);
    font-size: 11px;
    font-weight: 600;
    transition: background-color 200ms ease;
  }

  .pk,
  .abschluss {
    transition:
      transform 260ms var(--ease-out),
      border-color 200ms ease,
      background 260ms ease,
      box-shadow 260ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Deutliche Hervorhebung beim Drüberfahren: Anheben, türkiser Rahmenring, getönter Grund */
    .pk:hover,
    .abschluss:hover {
      transform: translateY(-6px) scale(1.015);
      border-color: var(--tuerkis);
      background: linear-gradient(155deg, rgba(79, 184, 166, 0.2), rgba(79, 184, 166, 0.05)), #ffffff;
      box-shadow:
        0 0 0 3px rgba(79, 184, 166, 0.2),
        0 22px 40px -12px rgba(11, 46, 60, 0.28);
    }

    .pk--kern:hover {
      transform: translateY(-7px) scale(1.02);
    }

    .pk:hover .pk__ico,
    .abschluss:hover .abschluss__ico {
      background: var(--verlauf);
      transform: scale(1.06);
    }

    .pk:hover .pk__ico :global([stroke]),
    .abschluss:hover .abschluss__ico :global(path),
    .abschluss:hover .abschluss__ico :global(circle) {
      stroke: #ffffff;
    }

    .pk:hover .pk__chips li {
      background: rgba(79, 184, 166, 0.22);
    }
  }

  .pfeil {
    display: flex;
    justify-content: center;
    margin: 18px 0;
  }

  .pfeil svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 920px) {
    .ko__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ko__textspalte {
      position: static;
    }

    .ko__intro {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .ko {
      padding: 64px 20px 72px;
    }

    .ko__text h2 {
      font-size: 28px;
    }

    .prozess {
      padding: 16px 12px;
    }

    .pk,
    .abschluss {
      gap: 13px;
      padding: 18px;
    }

    .pk__ico,
    .abschluss__ico {
      width: 42px;
      height: 42px;
    }

    .pk__ico svg,
    .abschluss__ico svg {
      width: 19px;
      height: 19px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pk:hover,
    .abschluss:hover,
    .pk:hover .pk__ico,
    .abschluss:hover .abschluss__ico {
      transform: none;
    }
  }
</style>
