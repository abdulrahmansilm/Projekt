---
/**
 * Ersparnis-Rechner „Rechnen Sie selbst“ (docs/DESIGNSYSTEM.md → Komponente 22g,
 * referenz/ki-telefonassistent/rechnen-sie-selbst.html). Rechenlogik und Standardwerte 1:1 aus der Referenz.
 * Barrierefreiheit: native Slider mit aria-valuetext, Schalter als role="switch", Ergebnis wird beim
 * Loslassen (change) über eine Live-Region angesagt, nicht bei jeder Bewegung.
 * Keine Zahlen-Animation: Werte ändern sich bei jeder Slider-Bewegung (emil-design-eng: häufig → nicht animieren).
 */
import { KONTAKT_ANKER } from "../../lib/config";

interface Props {
  eyebrow?: string;
  titel: string;
  intro?: string;
  hinweis: string;
}
const { eyebrow, titel, intro, hinweis } = Astro.props;

const felder = [
  { id: "anrufe", label: "Anrufe pro Tag", min: 1, max: 100, step: 1, wert: 25, einheit: "" },
  { id: "minuten", label: "Minuten pro Anruf", min: 1, max: 15, step: 1, wert: 4, einheit: "" },
  { id: "anteil", label: "Anteil, den die KI übernimmt", min: 10, max: 100, step: 5, wert: 80, einheit: " %" },
  { id: "lohn", label: "Stundenlohn", min: 12, max: 60, step: 1, wert: 23, einheit: " €" },
];
---

<section class="er" aria-labelledby="er-titel" data-rechner>
  <div class="er__inner">
    <div class="er__kopf" data-reveal>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="er-titel" class="h2">{titel}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>

    <div class="rechner" data-reveal>
      <div class="eingaben" role="group" aria-labelledby="er-angaben">
        <h3 id="er-angaben">Ihre Angaben</h3>
        {
          felder.map((f) => (
            <div class="feld">
              <div class="feld__kopf">
                <label for={`er-${f.id}`}>{f.label}</label>
                <output class="feld__wert" for={`er-${f.id}`} data-anzeige={f.id}>
                  {f.wert}
                  {f.einheit}
                </output>
              </div>
              <input
                type="range"
                id={`er-${f.id}`}
                name={f.id}
                min={f.min}
                max={f.max}
                step={f.step}
                value={f.wert}
                data-einheit={f.einheit}
                aria-valuetext={`${f.wert}${f.einheit}`}
                style={`--fuell:${((f.wert - f.min) / (f.max - f.min)) * 100}%`}
              />
            </div>
          ))
        }
        <div class="schalter-zeile">
          <label for="er-vollkosten">Arbeitgeber-Vollkosten einrechnen</label>
          <span class="schalter">
            <input type="checkbox" role="switch" id="er-vollkosten" name="vollkosten" checked />
            <span class="schalter__spur" aria-hidden="true"></span>
            <span class="schalter__knopf" aria-hidden="true"></span>
          </span>
        </div>
      </div>

      <div class="ergebnis on-dark">
        <p class="ergebnis__label">Ihre Ersparnis</p>
        <div class="stat">
          <p class="stat__k">Eingesparte Zeit pro Monat</p>
          <p class="stat__v"><span data-r="stunden">28</span> <span class="stat__einheit">Std.</span></p>
        </div>
        <div class="paar">
          <div>
            <p class="stat__k">Heutige Kosten</p>
            <p class="paar__v" data-r="heute">837 €</p>
          </div>
          <div>
            <p class="stat__k">Kosten mit Assistent</p>
            <p class="paar__v" data-r="mit">389 €</p>
          </div>
        </div>
        <div class="ersparnis">
          <p class="stat__k">Ersparnis pro Monat</p>
          <p class="ersparnis__v" data-r="ersparnis">+478 €</p>
          <!-- Runde 5: Beratung in derselben Spalte wie „Ersparnis pro Monat“, direkt darunter -->
          <a class="btn btn--sm ergebnis__cta" href={KONTAKT_ANKER}>
            <span>Beratung vereinbaren</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <p class="ergebnis__hinweis">{hinweis}</p>
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-rechner-ansage></p>
  </div>
</section>

<script>
  // Feste Annahmen (referenz/ki-telefonassistent/rechnen-sie-selbst.html)
  const ARBEITSTAGE_PRO_MONAT = 21;
  const ARBEITGEBER_FAKTOR = 1.3;
  // Preisstaffel nach Anrufen/Tag, identisch zum Pricing der Seite
  const kiKosten = (anrufeProTag: number) => (anrufeProTag <= 20 ? 129 : anrufeProTag <= 80 ? 389 : 599);
  const euro = (n: number) => `${Math.round(n).toLocaleString("de-DE")} €`;

  document.querySelectorAll<HTMLElement>("[data-rechner]").forEach((root) => {
    const regler = (name: string) => root.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;
    const vollkosten = root.querySelector<HTMLInputElement>('input[name="vollkosten"]')!;
    const r = (k: string) => root.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
    const ansage = root.querySelector<HTMLElement>("[data-rechner-ansage]");

    const berechne = () => {
      const anrufe = Number(regler("anrufe").value);
      const minuten = Number(regler("minuten").value);
      const anteil = Number(regler("anteil").value);
      const lohn = Number(regler("lohn").value);

      for (const input of root.querySelectorAll<HTMLInputElement>('input[type="range"]')) {
        const text = `${input.value}${input.dataset.einheit ?? ""}`;
        root.querySelector(`[data-anzeige="${input.name}"]`)!.textContent = text;
        input.setAttribute("aria-valuetext", text);
        const fuell = ((Number(input.value) - Number(input.min)) / (Number(input.max) - Number(input.min))) * 100;
        input.style.setProperty("--fuell", `${fuell}%`);
      }

      const effektiverLohn = vollkosten.checked ? lohn * ARBEITGEBER_FAKTOR : lohn;
      const kiMinuten = anrufe * minuten * ARBEITSTAGE_PRO_MONAT * (anteil / 100);
      const stunden = kiMinuten / 60;
      const heute = stunden * effektiverLohn;
      const mit = kiKosten(anrufe);
      const ersparnis = heute - mit;

      r("stunden").textContent = String(Math.round(stunden));
      r("heute").textContent = euro(heute);
      r("mit").textContent = euro(mit);
      r("ersparnis").textContent = `${ersparnis >= 0 ? "+" : "−"}${euro(Math.abs(ersparnis))}`;
      return { stunden, ersparnis };
    };

    root.addEventListener("input", berechne);
    root.addEventListener("change", () => {
      const { stunden, ersparnis } = berechne();
      if (ansage)
        ansage.textContent = `Eingesparte Zeit ${Math.round(stunden)} Stunden pro Monat, Ersparnis ${ersparnis >= 0 ? "" : "minus "}${euro(Math.abs(ersparnis))} pro Monat.`;
    });
    berechne();
  });
</script>

<style>
  .er {
    padding: 96px 32px 104px;
    background: var(--nebel);
  }

  .er__inner {
    max-width: 920px;
    margin: 0 auto;
  }

  .er__kopf {
    max-width: 600px;
    margin-bottom: 44px;
  }

  .er__kopf .eyebrow {
    margin-bottom: 14px;
  }

  .er__kopf h2 {
    margin-bottom: 14px;
  }

  .rechner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    overflow: hidden;
    border-radius: 20px;
    background: #ffffff;
    box-shadow: 0 4px 24px rgba(11, 46, 60, 0.07);
  }

  .eingaben {
    margin: 0;
    padding: 40px 40px 36px;
  }

  .eingaben h3 {
    margin-bottom: 26px;
    font-size: 17px;
    font-weight: 600;
  }

  .feld {
    margin-bottom: 26px;
  }

  .feld__kopf {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .feld__kopf label {
    font-size: 14.5px;
    font-weight: 500;
  }

  .feld__wert {
    font-family: var(--font-headline);
    font-size: 14.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--petrol);
    white-space: nowrap;
  }

  input[type="range"] {
    --fuell: 50%;
    width: 100%;
    height: 24px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #4fb8a6 0%, #1b6e7a var(--fuell), rgba(11, 46, 60, 0.14) var(--fuell));
  }

  input[type="range"]::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: rgba(11, 46, 60, 0.14);
  }

  input[type="range"]::-moz-range-progress {
    height: 4px;
    border-radius: 2px;
    background: var(--verlauf);
  }

  input[type="range"]::-webkit-slider-thumb {
    width: 20px;
    height: 20px;
    margin-top: -8px;
    border: 0;
    border-radius: 50%;
    background: var(--verlauf);
    box-shadow: 0 2px 8px rgba(11, 46, 60, 0.25);
    -webkit-appearance: none;
    transition: transform 160ms var(--ease-out);
  }

  input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border: 0;
    border-radius: 50%;
    background: var(--verlauf);
    box-shadow: 0 2px 8px rgba(11, 46, 60, 0.25);
    transition: transform 160ms var(--ease-out);
  }

  input[type="range"]:active::-webkit-slider-thumb {
    transform: scale(1.12);
  }

  input[type="range"]:active::-moz-range-thumb {
    transform: scale(1.12);
  }

  input[type="range"]:focus-visible {
    outline: none;
  }

  input[type="range"]:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--petrol);
    outline-offset: 3px;
  }

  input[type="range"]:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--petrol);
    outline-offset: 3px;
  }

  .schalter-zeile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid rgba(11, 46, 60, 0.08);
    font-size: 14px;
  }

  .schalter {
    position: relative;
    width: 42px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 16px;
  }

  .schalter input {
    position: absolute;
    inset: -10px;
    z-index: 2;
    width: calc(100% + 20px);
    height: calc(100% + 20px);
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .schalter__spur {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: rgba(11, 46, 60, 0.28);
    transition: background-color 200ms ease;
  }

  .schalter__knopf {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(11, 46, 60, 0.3);
    transition: transform 200ms var(--ease-in-out);
  }

  .schalter input:checked ~ .schalter__spur {
    background: var(--verlauf);
  }

  .schalter input:checked ~ .schalter__knopf {
    transform: translateX(18px);
  }

  .schalter input:focus-visible ~ .schalter__spur {
    outline: 2px solid var(--petrol);
    outline-offset: 3px;
  }

  .ergebnis {
    display: flex;
    flex-direction: column;
    padding: 40px 40px 36px;
    background: var(--tiefsee);
    color: var(--on-dark);
  }

  .ergebnis__label {
    margin-bottom: 18px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(240, 244, 243, 0.12);
    font-family: var(--font-headline);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(240, 244, 243, 0.62);
  }

  .stat {
    margin-bottom: 24px;
  }

  .stat__k {
    margin-bottom: 6px;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(240, 244, 243, 0.68);
  }

  .stat__v {
    font-family: var(--font-headline);
    font-size: 40px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #ffffff;
  }

  .stat__einheit {
    margin-left: 4px;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.72);
  }

  .paar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid rgba(240, 244, 243, 0.12);
  }

  .paar__v {
    font-family: var(--font-headline);
    font-size: 22px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: #ffffff;
  }

  .ersparnis {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid rgba(240, 244, 243, 0.12);
  }

  .ersparnis__v {
    font-family: var(--font-headline);
    font-size: 26px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--helltuerkis);
  }

  .ergebnis__hinweis {
    margin-top: 20px;
    font-size: 12.5px;
    line-height: 1.55;
    color: rgba(240, 244, 243, 0.68);
  }

  /* Runde 5: Beratungsbutton sitzt jetzt in der Ergebnis-Spalte, siehe .ergebnis__cta */
  .ergebnis__cta {
    margin-top: 16px;
  }

  @media (max-width: 780px) {
    .rechner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .er {
      padding: 64px 20px 72px;
    }

    .er__kopf h2 {
      font-size: 27px;
    }

    .eingaben,
    .ergebnis {
      padding: 30px 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .schalter__knopf,
    input[type="range"]::-webkit-slider-thumb {
      transition: none;
    }
  }
</style>
