---
/**
 * Pricing mit Einrichtungs-Karte + 3 Abo-Paketen (docs/DESIGNSYSTEM.md → Komponente 1;
 * referenz/ki-telefonassistent/pricing.html, referenz/whatsapp-chatbot/pricing.html).
 * Tooltips: per Hover UND Fokus, Escape schließt; erster Tooltip mit kurzer Verzögerung, benachbarte sofort
 * (emil-design-eng). Skaliert vom Auslöser aus (transform-origin unten mittig).
 */
import { uebersetzer, euro as euroIn, kontaktAnker } from "../../i18n";

type Eintrag = { text?: string; enthalten: boolean; notiz?: string; tipp?: string; info?: boolean; erbt?: string; hervor?: boolean };
interface Props {
  titel: string;
  intro?: string;
  setup: { name: string; tagline: string; preis: string; features: string[] };
  pakete: {
    name: string;
    variante: "neutral" | "beliebt" | "premium";
    badge?: string;
    tagline: string;
    monatlich: number;
    jaehrlich: number;
    spart: number;
    prefix?: string;
    cta: string;
    inkludiert: Eintrag[];
    /** Runde 7: optional, der WhatsApp-Chatbot zeigt keinen Features-Block mehr */
    features?: Eintrag[];
  }[];
  /** Runde 8: eigenständiges Paket „Laufende Betreuung“ neben der Einrichtung */
  betreuungPaket?: { name: string; tagline: string; preis: string; features: string[] };
  disclaimer: string;
  /** Piktogramme in den Gruppenköpfen entfallen seit 22.09.2026 */
  vergleich?: { titel: string; icon?: string; zeilen: { label: string; tipp?: string; werte: string[] }[] }[];
}

const { titel, intro, setup, pakete, betreuungPaket, disclaimer, vergleich } = Astro.props;
const id = `ps-${Math.random().toString(36).slice(2, 7)}`;
// Zeilen je Karte für das Subgrid (Runde 5): Name, Tagline, Preis, Periode, CTA, Trenner,
// Inkludiert-Label + Liste, [Features-Label + Liste]. Fehlt der Features-Block, schrumpft der Zähler mit.
const zeigeFeatures = pakete.some((p) => p.features?.length);
const kartenZeilen = 8 + (zeigeFeatures ? 2 : 0);
const t = uebersetzer(Astro);
const euro = (n: number) => euroIn(n, t.lang);
const KONTAKT_ANKER = kontaktAnker(t.lang);
// Ersparnis bei jährlichem Vertrag: höchster prozentualer Vorteil über alle Pakete (nur ehrliche Werte zeigen)
const maxSparen = Math.round(Math.max(...pakete.map((p) => ((p.monatlich - p.jaehrlich) / p.monatlich) * 100)));
let tippZaehler = 0;
const tippId = () => `${id}-tipp-${++tippZaehler}`;
---

<section class="ps" id="preise" aria-labelledby={`${id}-titel`} data-tooltips>
  <svg width="0" height="0" class="ps__defs" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`${id}-grad`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#4FB8A6"></stop>
        <stop offset="1" stop-color="#1B6E7A"></stop>
      </linearGradient>
    </defs>
  </svg>

  <div class="ps__wrap">
    <div class="ps__kopf" data-reveal>
      <h2 id={`${id}-titel`} class="h2">{titel}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>

    {/* Runde 8: Einrichtung (einmalig) und Laufende Betreuung (monatlich) nebeneinander, darunter die Abo-Pakete */}
    <div class:list={["zusatzpakete", { "zusatzpakete--paar": !!betreuungPaket }]} data-reveal-group>
      <div class="setup" data-reveal>
        <span class="setup__badge">{t("Einmalig")}</span>
        <div class="setup__oben">
          <div>
            <h3 class="setup__name">{setup.name}</h3>
            <p class="setup__tagline">{setup.tagline}</p>
          </div>
          <div class="setup__preis">
            <p class="setup__preis-zeile"><span class="setup__ab">{t("Ab")}</span> <span class="setup__betrag">{setup.preis}</span></p>
            <p class="setup__einheit">{t("netto, einmalig")}</p>
          </div>
        </div>
        <ul class="setup__features" role="list">
          {
            setup.features.map((f) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke={`url(#${id}-grad)`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        betreuungPaket && (
          <div class="setup setup--betreuung" data-reveal>
            <span class="setup__badge">{t("Monatlich")}</span>
            <div class="setup__oben">
              <div>
                <h3 class="setup__name">{betreuungPaket.name}</h3>
                <p class="setup__tagline">{betreuungPaket.tagline}</p>
              </div>
              <div class="setup__preis">
                <p class="setup__preis-zeile">
                  <span class="setup__betrag">{betreuungPaket.preis}</span>
                </p>
                <p class="setup__einheit">{t("netto / Monat")}</p>
              </div>
            </div>
            <ul class="setup__features" role="list">
              {betreuungPaket.features.map((f) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke={`url(#${id}-grad)`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <div class="zahlweise">
      <fieldset class="umschalter">
        <legend class="sr-only">{t("Vertragslaufzeit")}</legend>
        <span class="umschalter__daumen" aria-hidden="true"></span>
        <label>
          <input type="radio" name={`${id}-zahlweise`} value="monatlich" checked />
          <span>
            {t("Monatlich")}
            {/* unsichtbarer Platzhalter: hält beide Hälften exakt gleich breit */}
            {maxSparen > 0 && <span class="umschalter__rabatt umschalter__rabatt--platz" aria-hidden="true">{t("−{n} %", { n: maxSparen })}</span>}
          </span>
        </label>
        <label>
          <input type="radio" name={`${id}-zahlweise`} value="jaehrlich" />
          <span>
            {t("Jährlich")}
            {maxSparen > 0 && <span class="umschalter__rabatt">{t("−{n} %", { n: maxSparen })}</span>}
          </span>
        </label>
      </fieldset>
    </div>

    <ul class="karten" role="list" data-reveal-group style={`--karte-zeilen:${kartenZeilen}`}>
      {
        pakete.map((p) => (
          <li class:list={["karte", `karte--${p.variante}`, { "on-dark": p.variante === "premium" }]} data-reveal>
            {p.badge && <span class="karte__badge">{p.badge}</span>}
            <h3 class="karte__name">{p.name}</h3>
            <p class="karte__tagline">{p.tagline}</p>
            <p class="karte__preis">
              {p.prefix && <span class="karte__prefix">{p.prefix}</span>}
              <span class="preis preis--monat">{euro(p.monatlich)}</span>
              <span class="preis preis--jahr">{euro(p.jaehrlich)}</span>
              <span class="spar preis--jahr">{t("Sie sparen {betrag}", { betrag: euro(p.spart) })}</span>
            </p>
            <p class="karte__periode">
              <span class="preis--monat">{t("pro Monat")}</span>
              <span class="preis--jahr">{t("pro Monat, jährlich abgerechnet")}</span>
            </p>
            <a
              class:list={["btn btn--sm btn--block karte__cta", { "btn--hell": p.variante === "premium" }]}
              href={KONTAKT_ANKER}
              aria-label={t("{cta}: Paket {paket}", { cta: p.cta, paket: p.name })}
            >
              <span>{p.cta}</span>
            </a>
            <div class="karte__trenner" />
            {[
              { art: "inkludiert", label: t("Inkludiert"), liste: p.inkludiert },
              ...(p.features?.length ? [{ art: "features", label: t("Features"), liste: p.features }] : []),
            ].map((gruppe) => (
              <>
                <p class="gruppe-label">{gruppe.label}</p>
                <ul class:list={["eintraege", { "eintraege--features": gruppe.art === "features" }]} role="list">
                  {gruppe.liste.map((e, nr) =>
                    e.erbt ? (
                      <li class="erbt">
                        <span class="plus" aria-hidden="true">
                          +
                        </span>
                        <span>{nr === gruppe.liste.length - 1 ? t("Alles aus {paket}", { paket: e.erbt }) : t("Alles aus {paket}, außerdem:", { paket: e.erbt })}</span>
                      </li>
                    ) : (
                      <li class:list={{ "ist-aus": !e.enthalten, hervor: e.hervor }}>
                        {e.enthalten ? (
                          <svg viewBox="0 0 24 24" fill="none" stroke={`url(#${id}-grad)`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12" />
                          </svg>
                        ) : (
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                          </svg>
                        )}
                        <span>
                          {!e.enthalten && <span class="sr-only">{t("Nicht enthalten:")} </span>}
                          {e.text}
                          {e.notiz && <span class="notiz">{e.notiz}</span>}
                          {e.tipp &&
                            (() => {
                              const tid = tippId();
                              return (
                                <span class="tipp" data-tipp>
                                  <button type="button" class="tipp__knopf" aria-describedby={tid} aria-label={t("Info zu {thema}", { thema: e.text ?? "" })}>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                      <circle cx="12" cy="12" r="9" />
                                      <line x1="12" y1="11" x2="12" y2="16" />
                                      <circle cx="12" cy="8" r="0.6" fill="currentColor" />
                                    </svg>
                                  </button>
                                  <span class="tipp__blase" role="tooltip" id={tid}>
                                    {e.tipp}
                                  </span>
                                </span>
                              );
                            })()}
                          {e.info && !e.tipp && (
                            <svg class="info-deko" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                              <circle cx="12" cy="12" r="9" />
                              <line x1="12" y1="11" x2="12" y2="16" />
                              <circle cx="12" cy="8" r="0.6" fill="currentColor" />
                            </svg>
                          )}
                        </span>
                      </li>
                    )
                  )}
                </ul>
              </>
            ))}
          </li>
        ))
      }
    </ul>

    <!-- Der Disclaimer enthält den Netto-Hinweis (Anforderung 22.09.2026) -->
    <p class="disclaimer">{disclaimer}</p>

    {
      vergleich && (
        <details class="vergleich">
          <summary>
            {t("Vollständigen Funktionsvergleich anzeigen")}
            <svg class="vergleich__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="vergleich__gruppen">
            {vergleich.map((g) => (
              <div class="vgruppe">
                <div class="vgruppe__kopf">{g.titel}</div>
                <div class="vgruppe__scroll">
                  <table>
                    <caption class="sr-only">{g.titel}</caption>
                    <thead>
                      <tr>
                        <td />
                        {pakete.map((p) => (
                          <th scope="col">{p.name}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {g.zeilen.map((z) => (
                        <tr>
                          <th scope="row">
                            <span class="vlabel">
                              {z.label}
                              {z.tipp &&
                                (() => {
                                  const tid = tippId();
                                  return (
                                    <span class="tipp" data-tipp>
                                      <button type="button" class="tipp__knopf" aria-describedby={tid} aria-label={t("Info zu {thema}", { thema: z.label })}>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                          <circle cx="12" cy="12" r="9" />
                                          <line x1="12" y1="11" x2="12" y2="16" />
                                          <circle cx="12" cy="8" r="0.6" fill="currentColor" />
                                        </svg>
                                      </button>
                                      <span class="tipp__blase" role="tooltip" id={tid}>
                                        {z.tipp}
                                      </span>
                                    </span>
                                  );
                                })()}
                            </span>
                          </th>
                          {z.werte.map((w) => (
                            <td>
                              {w === "✓" ? (
                                <>
                                  <span class="wert-ja" aria-hidden="true">✓</span>
                                  <span class="sr-only">{t("enthalten")}</span>
                                </>
                              ) : w === "–" ? (
                                <>
                                  <span class="wert-nein" aria-hidden="true">–</span>
                                  <span class="sr-only">{t("nicht enthalten")}</span>
                                </>
                              ) : (
                                w
                              )}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        </details>
      )
    }
  </div>
</section>

<script>
  /**
   * Tooltips: erste Anzeige nach 250 ms, solange einer offen ist (bzw. kurz danach) sofort.
   * Runde 4: Die sichtbare Blase ist EIN Element direkt unter <body> („Portal“). Vorher hing sie in der Karte;
   * weil Karten und Reveal-Elemente ein transform tragen, rechnete position: fixed relativ zur Karte –
   * die Blase erschien weit entfernt vom Icon oder gar nicht. Die ursprünglichen Texte bleiben für
   * Screenreader per aria-describedby im Dokument (visuell versteckt).
   */
  const portal = document.createElement("div");
  portal.className = "tipp-portal";
  portal.setAttribute("aria-hidden", "true");
  document.body.append(portal);

  let offen: HTMLElement | null = null;
  let zeigeTimer: number | undefined;
  let versteckTimer: number | undefined;
  let warmBis = 0;

  const ausrichten = (tipp: HTMLElement) => {
    const knopf = tipp.querySelector<HTMLElement>(".tipp__knopf") ?? tipp;
    const k = knopf.getBoundingClientRect();
    const rand = 12;
    const breite = portal.offsetWidth;
    const hoehe = portal.offsetHeight;
    const mitte = k.left + k.width / 2;
    const links = Math.max(rand, Math.min(mitte - breite / 2, window.innerWidth - rand - breite));
    const obenPlatz = k.top - hoehe - 10 >= rand;
    portal.style.left = `${Math.round(links)}px`;
    portal.style.top = `${Math.round(obenPlatz ? k.top - hoehe - 10 : k.bottom + 10)}px`;
    portal.classList.toggle("tipp-portal--unten", !obenPlatz);
    portal.style.setProperty("--pfeil-x", `${Math.round(mitte - links)}px`);
  };

  const zeige = (tipp: HTMLElement, sofort: boolean) => {
    window.clearTimeout(versteckTimer);
    portal.textContent = tipp.querySelector(".tipp__blase")?.textContent?.trim() ?? "";
    portal.classList.toggle("is-sofort", sofort);
    ausrichten(tipp);
    portal.classList.add("is-offen");
    offen = tipp;
  };
  const verstecke = () => {
    window.clearTimeout(zeigeTimer);
    portal.classList.remove("is-offen");
    offen = null;
    warmBis = Date.now() + 400;
  };

  document.querySelectorAll<HTMLElement>("[data-tooltips] [data-tipp]").forEach((tipp) => {
    const knopf = tipp.querySelector<HTMLButtonElement>("button")!;
    tipp.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      window.clearTimeout(zeigeTimer);
      window.clearTimeout(versteckTimer);
      const warm = offen !== null || Date.now() < warmBis;
      if (warm) zeige(tipp, true);
      else zeigeTimer = window.setTimeout(() => zeige(tipp, false), 250);
    });
    tipp.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return;
      window.clearTimeout(zeigeTimer);
      versteckTimer = window.setTimeout(verstecke, 80);
    });
    knopf.addEventListener("focus", () => zeige(tipp, offen !== null));
    knopf.addEventListener("blur", verstecke);
    knopf.addEventListener("click", () => (offen === tipp ? verstecke() : zeige(tipp, false)));
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && offen) verstecke();
  });
  // Auf Touch-Geräten schließt ein Tipp außerhalb die Blase
  document.addEventListener("pointerdown", (e) => {
    if (offen && !(e.target as Element).closest?.("[data-tipp]")) verstecke();
  });
  const nachfuehren = () => offen && ausrichten(offen);
  window.addEventListener("scroll", nachfuehren, { passive: true, capture: true });
  window.addEventListener("resize", nachfuehren);
</script>

<style>
  .ps {
    padding: 96px 24px 104px;
    /* versteckte Tooltip-Blasen am Rand dürfen keinen horizontalen Scroll erzeugen */
    overflow-x: clip;
    background: var(--nebel);
  }

  .ps__defs {
    position: absolute;
  }

  .ps__wrap {
    max-width: 1040px;
    margin: 0 auto;
  }

  .ps__kopf {
    max-width: 560px;
    margin-bottom: 32px;
  }

  .ps__kopf h2 {
    margin-bottom: 10px;
  }

  /* ---------- Einrichtung + Laufende Betreuung ---------- */
  .zusatzpakete {
    margin-bottom: 24px;
  }

  /* Runde 8: beide Pakete nebeneinander, gleich hoch; Punkte einspaltig, Preis bleibt rechts oben */
  .zusatzpakete--paar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .zusatzpakete--paar .setup__oben {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .zusatzpakete--paar .setup__features {
    grid-template-columns: 1fr;
  }

  .setup {
    position: relative;
    padding: 28px 30px;
    border: 1.5px dashed var(--tuerkis);
    border-radius: 18px;
    background: #ffffff;
  }

  /* Monatliches Paket: durchgezogener Rahmen statt gestrichelt, einheitliche Fläche (Runde 10: ohne Verlauf) */
  .setup--betreuung {
    border-style: solid;
    background: #ffffff;
  }

  .setup--betreuung .setup__badge {
    background: var(--verlauf);
  }

  .setup__badge {
    display: inline-flex;
    margin-bottom: 14px;
    padding: 5px 13px;
    border-radius: 999px;
    background: var(--tiefsee);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .setup__oben {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .setup__name {
    margin-bottom: 6px;
    font-size: 20px;
    font-weight: 600;
  }

  .setup__tagline {
    max-width: 440px;
    font-size: 13.5px;
    color: var(--ink-72);
  }

  .setup__preis {
    flex: none;
    text-align: right;
  }

  .setup__preis-zeile {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 6px;
  }

  .setup__ab,
  .setup__einheit {
    font-size: 13px;
    color: var(--ink-72);
  }

  .setup__betrag {
    font-family: var(--font-headline);
    font-size: 28px;
    font-weight: 700;
  }

  .setup__features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .setup__features li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.4;
  }

  .setup__features svg,
  .eintraege svg {
    width: 15px;
    height: 15px;
    flex: none;
    margin-top: 2px;
  }

  /* ---------- Zahlweise ---------- */
  .zahlweise {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 16px;
    margin-bottom: 36px;
  }

  .umschalter {
    position: relative;
    display: inline-flex;
    margin: 0;
    padding: 4px;
    border: 1px solid rgba(11, 46, 60, 0.14);
    border-radius: 999px;
    background: #ffffff;
  }

  /* beide Hälften gleich breit, damit der Daumen exakt sitzt */
  .umschalter label {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    cursor: pointer;
  }

  /* Ersparnis sitzt im Umschalt-Button (Anforderung 22.09.2026) */
  .umschalter__rabatt {
    flex: none;
    white-space: nowrap;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(79, 184, 166, 0.18);
    color: var(--petrol);
    font-size: 11.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .umschalter__rabatt--platz {
    visibility: hidden;
  }

  .umschalter input:checked + span .umschalter__rabatt {
    background: rgba(255, 255, 255, 0.24);
    color: #ffffff;
  }

  .umschalter input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .umschalter label > span {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 7px;
    white-space: nowrap;
    min-height: 34px;
    padding: 0 18px;
    border-radius: 999px;
    color: var(--ink-72);
    font-size: 13.5px;
    font-weight: 500;
    transition: color 200ms ease;
  }

  .umschalter input:checked + span {
    color: #ffffff;
  }

  .umschalter input:focus-visible + span {
    outline: 2px solid var(--petrol);
    outline-offset: 2px;
  }

  .umschalter__daumen {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    z-index: 1;
    width: calc(50% - 4px);
    border-radius: 999px;
    background: var(--verlauf);
