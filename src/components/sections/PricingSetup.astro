---
/**
 * Pricing mit Einrichtungs-Karte + 3 Abo-Paketen (docs/DESIGNSYSTEM.md → Komponente 1;
 * referenz/ki-telefonassistent/pricing.html, referenz/whatsapp-chatbot/pricing.html).
 * Tooltips: per Hover UND Fokus, Escape schließt; erster Tooltip mit kurzer Verzögerung, benachbarte sofort
 * (emil-design-eng). Skaliert vom Auslöser aus (transform-origin unten mittig).
 */
import { KONTAKT_ANKER } from "../../lib/config";

type Eintrag = { text?: string; enthalten: boolean; notiz?: string; tipp?: string; info?: boolean; erbt?: string; hervor?: boolean };
interface Props {
  titel: string;
  intro?: string;
  setup: { name: string; tagline: string; preis: string; features: string[] };
  pakete: {
    name: string;
    variante: "neutral" | "beliebt";
    badge?: string;
    tagline: string;
    monatlich: number;
    jaehrlich: number;
    spart: number;
    prefix?: string;
    cta: string;
    inkludiert: Eintrag[];
    features: Eintrag[];
  }[];
  disclaimer: string;
  vergleich?: { titel: string; icon: string; zeilen: { label: string; tipp?: string; werte: string[] }[] }[];
}

const { titel, intro, setup, pakete, disclaimer, vergleich } = Astro.props;
const id = `ps-${Math.random().toString(36).slice(2, 7)}`;
const euro = (n: number) => `${n.toLocaleString("de-DE")} €`;
// Ersparnis bei jährlichem Vertrag: höchster prozentualer Vorteil über alle Pakete (nur ehrliche Werte zeigen)
const maxSparen = Math.round(Math.max(...pakete.map((p) => ((p.monatlich - p.jaehrlich) / p.monatlich) * 100)));
let tippZaehler = 0;
const tippId = () => `${id}-tipp-${++tippZaehler}`;
---

<section class="ps" id="preise" aria-labelledby={`${id}-titel`} data-tooltips>
  <svg width="0" height="0" class="ps__defs" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={`${id}-grad`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#4FB8A6"></stop>
        <stop offset="1" stop-color="#1B6E7A"></stop>
      </linearGradient>
    </defs>
  </svg>

  <div class="ps__wrap">
    <div class="ps__kopf" data-reveal>
      <h2 id={`${id}-titel`} class="h2">{titel}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>

    <div class="setup" data-reveal>
      <span class="setup__badge">Einmalig</span>
      <div class="setup__oben">
        <div>
          <h3 class="setup__name">{setup.name}</h3>
          <p class="setup__tagline">{setup.tagline}</p>
        </div>
        <div class="setup__preis">
          <p class="setup__preis-zeile"><span class="setup__ab">Ab</span> <span class="setup__betrag">{setup.preis}</span></p>
          <p class="setup__einheit">einmalig</p>
        </div>
      </div>
      <ul class="setup__features" role="list">
        {
          setup.features.map((f) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke={`url(#${id}-grad)`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{f}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="zahlweise">
      <fieldset class="umschalter">
        <legend class="sr-only">Vertragslaufzeit</legend>
        <span class="umschalter__daumen" aria-hidden="true"></span>
        <label><input type="radio" name={`${id}-zahlweise`} value="monatlich" checked /><span>Monatlich</span></label>
        <label><input type="radio" name={`${id}-zahlweise`} value="jaehrlich" /><span>Jährlich</span></label>
      </fieldset>
      {maxSparen > 0 && <span class="zahlweise__hinweis">{maxSparen === 10 ? "10 %" : `bis zu ${maxSparen} %`} sparen bei jährlichem Vertrag</span>}
    </div>

    <ul class="karten" role="list" data-reveal-group>
      {
        pakete.map((p) => (
          <li class:list={["karte", `karte--${p.variante}`]} data-reveal>
            {p.badge && <span class="karte__badge">{p.badge}</span>}
            <h3 class="karte__name">{p.name}</h3>
            <p class="karte__tagline">{p.tagline}</p>
            <p class="karte__preis">
              {p.prefix && <span class="karte__prefix">{p.prefix}</span>}
              <span class="preis preis--monat">{euro(p.monatlich)}</span>
              <span class="preis preis--jahr">{euro(p.jaehrlich)}</span>
              <span class="spar preis--jahr">Sie sparen {euro(p.spart)}</span>
            </p>
            <p class="karte__periode">
              <span class="preis--monat">pro Monat</span>
              <span class="preis--jahr">pro Monat, jährlich abgerechnet</span>
            </p>
            <a
              class:list={["btn btn--sm btn--block karte__cta", { "btn--dunkel": p.variante !== "beliebt" }]}
              href={KONTAKT_ANKER}
              aria-label={`${p.cta}: Paket ${p.name}`}
            >
              <span>{p.cta}</span>
            </a>
            <div class="karte__trenner" />
            {[
              { label: "Inkludiert", liste: p.inkludiert },
              { label: "Features", liste: p.features },
            ].map((gruppe) => (
              <>
                <p class="gruppe-label">{gruppe.label}</p>
                <ul class:list={["eintraege", { "eintraege--features": gruppe.label === "Features" }]} role="list">
                  {gruppe.liste.map((e) =>
                    e.erbt ? (
                      <li class="erbt">
                        <svg viewBox="0 0 24 24" fill="none" stroke={`url(#${id}-grad)`} stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="19" y1="12" x2="5" y2="12" />
                          <polyline points="11 18 5 12 11 6" />
                        </svg>
                        <span>Alles in</span>
                        <span class="erbt__pill">{e.erbt}</span>
                      </li>
                    ) : (
                      <li class:list={{ "ist-aus": !e.enthalten, hervor: e.hervor }}>
                        {e.enthalten ? (
                          <svg viewBox="0 0 24 24" fill="none" stroke={`url(#${id}-grad)`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12" />
                          </svg>
                        ) : (
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                          </svg>
                        )}
                        <span>
                          {!e.enthalten && <span class="sr-only">Nicht enthalten: </span>}
                          {e.text}
                          {e.notiz && <span class="notiz">{e.notiz}</span>}
                          {e.tipp &&
                            (() => {
                              const tid = tippId();
                              return (
                                <span class="tipp" data-tipp>
                                  <button type="button" class="tipp__knopf" aria-describedby={tid} aria-label={`Info zu ${e.text}`}>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                      <circle cx="12" cy="12" r="9" />
                                      <line x1="12" y1="11" x2="12" y2="16" />
                                      <circle cx="12" cy="8" r="0.6" fill="currentColor" />
                                    </svg>
                                  </button>
                                  <span class="tipp__blase" role="tooltip" id={tid}>
                                    {e.tipp}
                                  </span>
                                </span>
                              );
                            })()}
                          {e.info && !e.tipp && (
                            <svg class="info-deko" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                              <circle cx="12" cy="12" r="9" />
                              <line x1="12" y1="11" x2="12" y2="16" />
                              <circle cx="12" cy="8" r="0.6" fill="currentColor" />
                            </svg>
                          )}
                        </span>
                      </li>
                    )
                  )}
                </ul>
              </>
            ))}
          </li>
        ))
      }
    </ul>

    <p class="disclaimer">{disclaimer}</p>

    {
      vergleich && (
        <details class="vergleich">
          <summary>
            Vollständigen Funktionsvergleich anzeigen
            <svg class="vergleich__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="vergleich__gruppen">
            {vergleich.map((g) => (
              <div class="vgruppe">
                <div class="vgruppe__kopf">
                  <svg viewBox="0 0 24 24" fill="none" stroke={`url(#${id}-grad)`} stroke-width="2" aria-hidden="true" set:html={g.icon} />
                  {g.titel}
                </div>
                <div class="vgruppe__scroll">
                  <table>
                    <caption class="sr-only">{g.titel}</caption>
                    <thead>
                      <tr>
                        <td />
                        {pakete.map((p) => (
                          <th scope="col">{p.name}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {g.zeilen.map((z) => (
                        <tr>
                          <th scope="row">
                            <span class="vlabel">
                              {z.label}
                              {z.tipp &&
                                (() => {
                                  const tid = tippId();
                                  return (
                                    <span class="tipp" data-tipp>
                                      <button type="button" class="tipp__knopf" aria-describedby={tid} aria-label={`Info zu ${z.label}`}>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                          <circle cx="12" cy="12" r="9" />
                                          <line x1="12" y1="11" x2="12" y2="16" />
                                          <circle cx="12" cy="8" r="0.6" fill="currentColor" />
                                        </svg>
                                      </button>
                                      <span class="tipp__blase" role="tooltip" id={tid}>
                                        {z.tipp}
                                      </span>
                                    </span>
                                  );
                                })()}
                            </span>
                          </th>
                          {z.werte.map((w) => (
                            <td>
                              {w === "✓" ? (
                                <>
                                  <span class="wert-ja" aria-hidden="true">✓</span>
                                  <span class="sr-only">enthalten</span>
                                </>
                              ) : w === "–" ? (
                                <>
                                  <span class="wert-nein" aria-hidden="true">–</span>
                                  <span class="sr-only">nicht enthalten</span>
                                </>
                              ) : (
                                w
                              )}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        </details>
      )
    }
  </div>
</section>

<script>
  // Tooltips: erste Anzeige nach 300ms, solange einer offen ist (bzw. kurz danach) sofort und ohne Animation
  document.querySelectorAll<HTMLElement>("[data-tooltips]").forEach((bereich) => {
    let offen: HTMLElement | null = null;
    let zeigeTimer: number | undefined;
    let versteckTimer: number | undefined;
    let warmBis = 0;

    // Blase horizontal im Viewport halten (12px Rand), Pfeil bleibt über dem Auslöser
    const ausrichten = (tipp: HTMLElement) => {
      const blase = tipp.querySelector<HTMLElement>(".tipp__blase");
      if (!blase) return;
      const k = tipp.getBoundingClientRect();
      const mitte = k.left + k.width / 2;
      const halb = blase.offsetWidth / 2;
      const rand = 12;
      let dx = 0;
      if (mitte - halb < rand) dx = rand - (mitte - halb);
      else if (mitte + halb > window.innerWidth - rand) dx = window.innerWidth - rand - (mitte + halb);
      tipp.style.setProperty("--tipp-x", `${Math.round(dx)}px`);
    };

    const zeige = (tipp: HTMLElement, sofort: boolean) => {
      window.clearTimeout(versteckTimer);
      if (offen && offen !== tipp) offen.classList.remove("is-offen", "is-sofort");
      ausrichten(tipp);
      tipp.classList.toggle("is-sofort", sofort);
      tipp.classList.add("is-offen");
      offen = tipp;
    };
    const verstecke = (tipp: HTMLElement) => {
      window.clearTimeout(zeigeTimer);
      tipp.classList.remove("is-offen");
      if (offen === tipp) offen = null;
      warmBis = Date.now() + 400;
    };

    bereich.querySelectorAll<HTMLElement>("[data-tipp]").forEach((tipp) => {
      const knopf = tipp.querySelector<HTMLButtonElement>("button")!;
      tipp.addEventListener("pointerenter", (e) => {
        if (e.pointerType !== "mouse") return;
        window.clearTimeout(zeigeTimer);
        const warm = offen !== null || Date.now() < warmBis;
        if (warm) zeige(tipp, true);
        else zeigeTimer = window.setTimeout(() => zeige(tipp, false), 300);
      });
      tipp.addEventListener("pointerleave", (e) => {
        if (e.pointerType !== "mouse") return;
        window.clearTimeout(zeigeTimer);
        versteckTimer = window.setTimeout(() => verstecke(tipp), 80);
      });
      knopf.addEventListener("focus", () => zeige(tipp, offen !== null));
      knopf.addEventListener("blur", () => verstecke(tipp));
      knopf.addEventListener("click", () => (tipp.classList.contains("is-offen") ? verstecke(tipp) : zeige(tipp, false)));
      knopf.addEventListener("keydown", (e) => {
        if (e.key === "Escape") verstecke(tipp);
      });
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && offen) verstecke(offen);
    });
  });
</script>

<style>
  .ps {
    padding: 96px 24px 104px;
    /* versteckte Tooltip-Blasen am Rand dürfen keinen horizontalen Scroll erzeugen */
    overflow-x: clip;
    background: var(--nebel);
  }

  .ps__defs {
    position: absolute;
  }

  .ps__wrap {
    max-width: 1040px;
    margin: 0 auto;
  }

  .ps__kopf {
    max-width: 560px;
    margin-bottom: 32px;
  }

  .ps__kopf h2 {
    margin-bottom: 10px;
  }

  /* ---------- Einrichtung ---------- */
  .setup {
    position: relative;
    margin-bottom: 24px;
    padding: 28px 30px;
    border: 1.5px dashed var(--tuerkis);
    border-radius: 18px;
    background: #ffffff;
  }

  .setup__badge {
    display: inline-flex;
    margin-bottom: 14px;
    padding: 5px 13px;
    border-radius: 999px;
    background: var(--tiefsee);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .setup__oben {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .setup__name {
    margin-bottom: 6px;
    font-size: 20px;
    font-weight: 600;
  }

  .setup__tagline {
    max-width: 440px;
    font-size: 13.5px;
    color: var(--ink-72);
  }

  .setup__preis {
    flex: none;
    text-align: right;
  }

  .setup__preis-zeile {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 6px;
  }

  .setup__ab,
  .setup__einheit {
    font-size: 13px;
    color: var(--ink-72);
  }

  .setup__betrag {
    font-family: var(--font-headline);
    font-size: 28px;
    font-weight: 700;
  }

  .setup__features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .setup__features li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.4;
  }

  .setup__features svg,
  .eintraege svg {
    width: 15px;
    height: 15px;
    flex: none;
    margin-top: 2px;
  }

  /* ---------- Zahlweise ---------- */
  .zahlweise {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 16px;
    margin-bottom: 36px;
  }

  .zahlweise__hinweis {
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(79, 184, 166, 0.14);
    color: var(--petrol);
    font-size: 13px;
    font-weight: 500;
  }

  .umschalter {
    position: relative;
    display: inline-flex;
    margin: 0;
    padding: 4px;
    border: 1px solid rgba(11, 46, 60, 0.14);
    border-radius: 999px;
    background: #ffffff;
  }

  .umschalter label {
    position: relative;
    z-index: 2;
    cursor: pointer;
  }

  .umschalter input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .umschalter span:not(.umschalter__daumen) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 22px;
    border-radius: 999px;
    color: var(--ink-72);
    font-size: 14px;
    font-weight: 500;
    transition: color 200ms ease;
  }

  .umschalter input:checked + span {
    color: #ffffff;
  }

  .umschalter input:focus-visible + span {
    outline: 2px solid var(--petrol);
    outline-offset: 2px;
  }

  .umschalter__daumen {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    z-index: 1;
    width: calc(50% - 4px);
    border-radius: 999px;
    background: var(--verlauf);
    transition: transform 220ms var(--ease-in-out);
  }

  .umschalter:has(input[value="jaehrlich"]:checked) .umschalter__daumen {
    transform: translateX(100%);
  }

  .preis--jahr {
    display: none;
  }

  .ps:has(input[value="jaehrlich"]:checked) .preis--monat {
    display: none;
  }

  .ps:has(input[value="jaehrlich"]:checked) .preis--jahr {
    display: inline;
  }

  /* ---------- Karten ---------- */
  .karten {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .karte {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px 24px 24px;
    border: 1px solid rgba(11, 46, 60, 0.14);
    border-radius: 18px;
    background: #ffffff;
    transition:
      box-shadow 200ms ease,
      transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .karte:hover {
      box-shadow: 0 10px 28px rgba(11, 46, 60, 0.09);
      transform: translateY(-2px);
    }
  }

  .karte--beliebt {
    border: 2px solid var(--tuerkis);
  }

  .karte__badge {
    position: absolute;
    top: -13px;
    right: 24px;
    padding: 5px 14px;
    border-radius: 999px;
    background: var(--verlauf-hell);
    color: var(--tiefsee);
    font-family: var(--font-headline);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .karte__name {
    margin-bottom: 6px;
    font-size: 21px;
    font-weight: 600;
  }

  .karte__tagline {
    min-height: 20px;
    margin-bottom: 20px;
    font-size: 13.5px;
    color: var(--ink-72);
  }

  .karte__preis {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 2px;
  }

  .karte__prefix {
    font-size: 13px;
    color: var(--ink-72);
  }

  .preis {
    font-family: var(--font-headline);
    font-size: 32px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .spar {
    padding: 3px 10px;
    border: 1px solid var(--tuerkis);
    border-radius: 999px;
    color: var(--petrol);
    font-size: 12px;
    font-weight: 600;
  }

  .karte__periode {
    margin-bottom: 20px;
    font-size: 12.5px;
    color: var(--ink-72);
  }

  .karte__cta {
    margin-bottom: 22px;
  }

  .karte__trenner {
    height: 1px;
    margin-bottom: 20px;
    background: rgba(11, 46, 60, 0.1);
  }

  .gruppe-label {
    margin-bottom: 12px;
    font-family: var(--font-headline);
    font-size: 13px;
    font-weight: 700;
  }

  .eintraege {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }

  .eintraege--features {
    margin-bottom: 0;
  }

  .eintraege li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.4;
  }

  /* Besonders hervorgehobene Leistungen (z. B. laufende Betreuung, Optimierung) */
  .eintraege li.hervor {
    padding: 7px 10px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(79, 184, 166, 0.18), rgba(27, 110, 122, 0.1));
    box-shadow: inset 3px 0 0 var(--tuerkis);
    font-weight: 600;
  }

  .eintraege li.ist-aus {
    color: var(--ink-68);
  }

  .notiz {
    margin-left: 4px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink-72);
  }

  .erbt {
    align-items: center !important;
  }

  .erbt__pill {
    padding: 2px 10px;
    border: 1px solid rgba(11, 46, 60, 0.1);
    border-radius: 999px;
    background: var(--nebel);
    font-size: 12.5px;
    font-weight: 600;
  }

  .info-deko {
    display: inline-block;
    width: 13px !important;
    height: 13px !important;
    margin: 0 0 -2px 4px !important;
    color: var(--ink-55);
  }

  /* ---------- Tooltip ---------- */
  .tipp {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
    margin-left: 2px;
  }

  .tipp__knopf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
