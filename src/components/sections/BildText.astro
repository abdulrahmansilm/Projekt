---
/**
 * Bild-Text-Split (docs/DESIGNSYSTEM.md → Komponente 22b, referenz/hardware-beschaffung/ausstattung.html).
 * Bildfläche als beschrifteter Platzhalter, bis ein echtes Foto vorliegt (dann Astro <Image> einsetzen).
 */
interface Props {
  eyebrow?: string;
  titel: string;
  absaetze: string[];
  bildLabel: string;
}
const { eyebrow, titel, absaetze, bildLabel } = Astro.props;
---

<section class="bt" aria-labelledby="bt-titel">
  <div class="bt__inner">
    <div class="bt__text" data-reveal>
      {
        eyebrow && (
          <p class="eyebrow">
            <span class="eyebrow__dot" aria-hidden="true" />
            {eyebrow}
          </p>
        )
      }
      <h2 id="bt-titel">{titel}</h2>
      {absaetze.map((a) => <p class="bt__absatz">{a}</p>)}
    </div>
    <div class="bt__bild" role="img" aria-label={`${bildLabel}: Foto folgt`} data-reveal>
      <span class="bt__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="3" y="4" width="18" height="14" rx="2" stroke="#1B6E7A" stroke-width="1.6"></rect>
          <circle cx="9" cy="9.5" r="2" stroke="#1B6E7A" stroke-width="1.6"></circle>
          <path d="M4.5 16 L9 11.8 L12 14.5 L15.5 10.5 L19.5 16" stroke="#1B6E7A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="bt__label" aria-hidden="true">{bildLabel}</span>
    </div>
  </div>
</section>

<style>
  .bt {
    padding: 96px 32px 100px;
    background: var(--nebel);
  }

  .bt__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  .bt__text .eyebrow {
    margin-bottom: 16px;
  }

  .bt__text h2 {
    margin-bottom: 18px;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: -0.01em;
  }

  .bt__absatz {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink-72);
  }

  .bt__absatz + .bt__absatz {
    margin-top: 14px;
  }

  .bt__bild {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 32px;
    border: 1.5px dashed rgba(11, 46, 60, 0.22);
    border-radius: 20px;
    background: rgba(11, 46, 60, 0.03);
    text-align: center;
    aspect-ratio: 4 / 5;
  }

  .bt__ico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(79, 184, 166, 0.1);
  }

  .bt__ico svg {
    width: 26px;
    height: 26px;
  }

  .bt__label {
    font-family: var(--font-headline);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-68);
  }

  @media (max-width: 820px) {
    .bt__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .bt__bild {
      order: -1;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 560px) {
    .bt {
      padding: 64px 20px 72px;
    }

    .bt__text h2 {
      font-size: 25px;
    }
  }
</style>
