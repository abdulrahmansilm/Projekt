---
/**
 * Text-Bild-Sektion (docs/DESIGNSYSTEM.md → Komponente 22b).
 * Beim Scrollen gleiten Text und Bild von den Seiten herein und treffen sich in der Mitte
 * (transform + opacity, einmalig). Unter dem Text steht immer ein Beratungs-Button.
 * Bild links / Text rechts ist der Standard, `bildRechts` dreht die Reihenfolge um.
 */
import { uebersetzer, kontaktAnker } from "../../i18n";

interface Props {
  eyebrow?: string;
  titel: string;
  absaetze: string[];
  /** Beschreibung des Bildes (Alt-Text, leer = dekorativ) */
  bildLabel?: string;
  /** Pfad unter public/, z. B. /bildtext/startseite.svg */
  bild?: string;
  bildRechts?: boolean;
  ctaText?: string;
  /** Ziel des Buttons; Standard ist die Kontakt-Sektion der Seite (Runde 5: Über uns verlinkt stattdessen auf /leitbild) */
  ctaHref?: string;
}
const t = uebersetzer(Astro);
const { titel, absaetze, bildLabel = "", bild, bildRechts = false, ctaText = t("Beratung anfragen"), ctaHref = kontaktAnker(t.lang) } = Astro.props;
const id = `bt-${Math.random().toString(36).slice(2, 7)}`;
---

<section class:list={["bt", { "bt--rechts": bildRechts }]} aria-labelledby={`${id}-titel`}>
  <div class="bt__inner">
    <div class="bt__text" data-reveal>
      <h2 id={`${id}-titel`}>{titel}</h2>
      {absaetze.map((a) => <p class="bt__absatz">{a}</p>)}
      <a class="btn bt__cta" href={ctaHref}>
        <span>{ctaText}</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
    <div class="bt__bild" data-reveal>
      {
        bild ? (
          <img src={bild} alt={bildLabel} width="560" height="560" loading="lazy" decoding="async" />
        ) : (
          <span class="bt__platzhalter" role="img" aria-label={t("{label}: Foto folgt", { label: bildLabel })}>
            {bildLabel}
          </span>
        )
      }
    </div>
  </div>
</section>

<style>
  .bt {
    padding: 96px 32px 100px;
    background: var(--nebel);
    overflow: hidden;
  }

  .bt__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  /* Standard: Bild links, Text rechts */
  .bt__bild {
    order: 1;
  }

  .bt__text {
    order: 2;
  }

  .bt--rechts .bt__bild {
    order: 2;
  }

  .bt--rechts .bt__text {
    order: 1;
  }

  .bt__text h2 {
    margin-bottom: 18px;
    font-size: 34px;
    font-weight: 500;
    line-height: 1.24;
    letter-spacing: -0.01em;
  }

  .bt__absatz {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-72);
  }

  .bt__absatz + .bt__absatz {
    margin-top: 14px;
  }

  .bt__cta {
    margin-top: 28px;
  }

  .bt__bild {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bt__bild img {
    width: 100%;
    max-width: 520px;
    height: auto;
  }

  .bt__platzhalter {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 32px;
    border: 1.5px dashed rgba(11, 46, 60, 0.22);
    border-radius: 20px;
    background: rgba(11, 46, 60, 0.03);
    font-family: var(--font-headline);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-68);
  }

  /* Hereingleiten: Bild und Text von den gegenüberliegenden Seiten, Treffpunkt in der Mitte */
  .js .bt__bild[data-reveal] {
    transform: translateX(-72px);
    transition:
      opacity 900ms var(--ease-out),
      transform 1000ms var(--ease-out);
  }

  .js .bt__text[data-reveal] {
    transform: translateX(72px);
    transition:
      opacity 900ms var(--ease-out) 120ms,
      transform 1000ms var(--ease-out) 120ms;
  }

  .js .bt--rechts .bt__bild[data-reveal] {
    transform: translateX(72px);
  }

  .js .bt--rechts .bt__text[data-reveal] {
    transform: translateX(-72px);
  }

  .js .bt__bild[data-reveal].is-revealed,
  .js .bt__text[data-reveal].is-revealed,
  .js .bt--rechts .bt__bild[data-reveal].is-revealed,
  .js .bt--rechts .bt__text[data-reveal].is-revealed {
    transform: none;
  }

  @media (max-width: 820px) {
    .bt__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .bt__bild,
    .bt--rechts .bt__bild {
      order: 1;
    }

    .bt__text,
    .bt--rechts .bt__text {
      order: 2;
    }

    .bt__bild img {
      max-width: 400px;
    }

    .js .bt__bild[data-reveal],
    .js .bt--rechts .bt__bild[data-reveal] {
      transform: translateX(-36px);
    }

    .js .bt__text[data-reveal],
    .js .bt--rechts .bt__text[data-reveal] {
      transform: translateX(36px);
    }
  }

  @media (max-width: 560px) {
    .bt {
      padding: 64px 20px 72px;
    }

    .bt__text h2 {
      font-size: 27px;
    }

    .bt__absatz {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .bt__bild[data-reveal],
    .js .bt__text[data-reveal] {
      transform: none;
      transition: none;
    }
  }
</style>
