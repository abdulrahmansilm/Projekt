---
/**
 * Kennzahlen-Sektion mit großformatigen Zahlen (besondere Sektion: dunkles Petrol, weißer Rand,
 * vollständig abgerundete Ecken, siehe Anforderungen 17.09.2026). Reine Fakten-Darstellung ohne Diagramm,
 * für Seiten, auf denen wenige, aussagekräftige Zahlen mehr Wirkung haben als ein Chart.
 */
interface Props {
  titel: string;
  intro?: string;
  quelle?: string;
  zahlen: { wert: string; label: string }[];
}
const { titel, intro, quelle, zahlen } = Astro.props;
---

<section class="kz section-dark besondere-sektion" aria-labelledby="kz-titel" data-kz>
  <div class="kz__inner">
    <div class="kz__kopf" data-reveal>
      <h2 id="kz-titel" class="h2">{titel}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>
    <ul class="kz__grid" role="list" data-reveal-group>
      {
        zahlen.map((z, i) => (
          <li data-reveal style={`--reveal-index:${i}`}>
            <span class="kz__wert text-verlauf-hell" data-kz-wert>{z.wert}</span>
            <span class="kz__label">{z.label}</span>
          </li>
        ))
      }
    </ul>
    {quelle && <p class="kz__quelle">{quelle}</p>}
  </div>
</section>

<script>
  /**
   * Count-up: Sobald die Sektion im Viewport erscheint, zählen die Zahlen schnell bis zum Endwert hoch.
   * Format wie im Text („3,4 Mrd.“, „87 %“): Zahl mit deutschem Dezimalkomma plus Suffix.
   */
  document.querySelectorAll<HTMLElement>("[data-kz]").forEach((root) => {
    const felder = Array.from(root.querySelectorAll<HTMLElement>("[data-kz-wert]")).map((el) => {
      const text = el.textContent?.trim() ?? "";
      const m = /^([\d.,]+)(.*)$/.exec(text);
      if (!m) return null;
      const ziel = parseFloat(m[1].replace(/\./g, "").replace(",", "."));
      const nachkomma = m[1].includes(",") ? m[1].split(",")[1].length : 0;
      return { el, ziel, nachkomma, suffix: m[2], text };
    });
    const brauchbar = felder.filter((f): f is NonNullable<typeof f> => f !== null && Number.isFinite(f.ziel));
    if (!brauchbar.length) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;

    const format = (wert: number, nachkomma: number) => wert.toLocaleString("de-DE", { minimumFractionDigits: nachkomma, maximumFractionDigits: nachkomma });
    brauchbar.forEach((f) => (f.el.textContent = format(0, f.nachkomma) + f.suffix));

    const DAUER = 1400;
    const start = () => {
      const t0 = performance.now();
      const schritt = (jetzt: number) => {
        const p = Math.min(1, (jetzt - t0) / DAUER);
        const eased = 1 - Math.pow(1 - p, 3);
        brauchbar.forEach((f) => (f.el.textContent = format(f.ziel * eased, f.nachkomma) + f.suffix));
        if (p < 1) requestAnimationFrame(schritt);
        else brauchbar.forEach((f) => (f.el.textContent = f.text));
      };
      requestAnimationFrame(schritt);
    };
    const beobachter = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        beobachter.disconnect();
        start();
      },
      { threshold: 0.35 }
    );
    beobachter.observe(root);
  });
</script>

<style>
  .kz {
    padding: 96px 32px 100px;
  }

  .kz__inner {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .kz__kopf {
    max-width: 640px;
    margin: 0 auto 56px;
  }

  .kz__kopf h2 {
    margin-bottom: 14px;
    color: #ffffff;
  }

  .kz__kopf .lead {
    color: var(--on-dark-72);
  }

  .kz__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kz__grid li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 16px;
  }

  .kz__grid li + li {
    border-left: 1px solid var(--line-dark);
  }

  .kz__wert {
    font-family: var(--font-headline);
    font-size: clamp(38px, 4.6vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .kz__label {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--on-dark-72);
  }

  .kz__quelle {
    margin-top: 44px;
    font-size: 12.5px;
    color: var(--on-dark-55);
  }

  @media (max-width: 760px) {
    .kz__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .kz__grid li + li {
      border-left: 0;
      padding-top: 24px;
      border-top: 1px solid var(--line-dark);
    }
  }

  @media (max-width: 560px) {
    .kz {
      padding: 64px 20px 72px;
    }

    .kz__kopf h2 {
      font-size: 27px;
    }
  }
</style>
