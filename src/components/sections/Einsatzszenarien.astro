---
/**
 * Einsatzszenarien als Hub-and-Spoke-Diagramm (docs/DESIGNSYSTEM.md → Komponente 22a, referenz/vpn/einsatzszenarien.html).
 * Hover/Fokus auf einen Knoten hebt dessen Leitung hervor, die übrigen dimmen ab (200ms). Unter 820px Kartenliste.
 * Laufende Leitungen und Hub-Puls sind Dauerschleifen; bei prefers-reduced-motion aus.
 * Hub-Puls über opacity eines Pseudo-Elements statt animiertem box-shadow (GPU-freundlich).
 */
import { uebersetzer, kontaktAnker } from "../../i18n";

interface Props {
  eyebrow?: string;
  titel: string;
  intro?: string;
  hub: string;
  knoten: { pos: "tl" | "tr" | "bl" | "br"; tag: string; titel: string; titelLang: string; kurz: string; lang: string; icon: string }[];
}
const { eyebrow, titel, intro, hub, knoten } = Astro.props;
const t = uebersetzer(Astro);
const KONTAKT_ANKER = kontaktAnker(t.lang);
const pfade: Record<string, string> = {
  tl: "M170,90 Q 340,90 460,250",
  tr: "M750,90 Q 580,90 460,250",
  bl: "M170,410 Q 340,410 460,250",
  br: "M750,410 Q 580,410 460,250",
};
---

<section class="es section-dark" aria-labelledby="es-titel">
  <div class="es__inner">
    <div class="es__kopf" data-reveal>
      {
        eyebrow && (
          <p class="eyebrow">
            <span class="eyebrow__dot" aria-hidden="true" />
            {eyebrow}
          </p>
        )
      }
      <h2 id="es-titel" class="h2">{titel}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>

    <div class="diagramm" data-es-diagramm>
      <svg class="linien" viewBox="0 0 920 500" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="es-tunnel" x1="0" y1="0" x2="920" y2="500" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#7FD9C4"></stop>
            <stop offset="1" stop-color="#4FB8A6"></stop>
          </linearGradient>
        </defs>
        {knoten.map((k) => <path d={pfade[k.pos]} data-knoten={k.pos} />)}
      </svg>

      <div class="hub" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="5" y="10.5" width="14" height="9.5" rx="2.2" stroke="#7FD9C4" stroke-width="1.7"></rect>
          <path d="M8 10.5 V7.2 C8 4.9 9.8 3 12 3 C14.2 3 16 4.9 16 7.2 V10.5" stroke="#7FD9C4" stroke-width="1.7" stroke-linecap="round"></path>
          <circle cx="12" cy="15" r="1.4" fill="#7FD9C4"></circle>
        </svg>
        <span>{hub}</span>
      </div>

      <ul class="knoten-liste" role="list">
        {
          knoten.map((k) => (
            <li class="knoten" data-pos={k.pos} data-knoten={k.pos} tabindex="0">
              <span class="knoten__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" set:html={k.icon} />
              </span>
              <span class="knoten__tag">{k.tag}</span>
              <h3>{k.titel}</h3>
              <p>{k.kurz}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="mobil-liste" role="list">
      {
        knoten.map((k) => (
          <li class="mkarte">
            <span class="mkarte__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" set:html={k.icon} />
            </span>
            <div>
              <span class="knoten__tag">{k.tag}</span>
              <h3>{k.titelLang}</h3>
              <p>{k.lang}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="es__cta" data-reveal>
      <a class="btn" href={KONTAKT_ANKER}>
        <span>{t("Beratung anfragen")}</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-es-diagramm]").forEach((diagramm) => {
    const linien = diagramm.querySelectorAll<SVGPathElement>(".linien path");
    const setze = (schluessel: string | null) => {
      diagramm.classList.toggle("has-active", !!schluessel);
      linien.forEach((l) => l.classList.toggle("is-active", l.dataset.knoten === schluessel));
    };
    diagramm.querySelectorAll<HTMLElement>(".knoten").forEach((k) => {
      k.addEventListener("pointerenter", () => setze(k.dataset.knoten ?? null));
      k.addEventListener("pointerleave", () => setze(null));
      k.addEventListener("focus", () => setze(k.dataset.knoten ?? null));
      k.addEventListener("blur", () => setze(null));
    });
  });
</script>

<style>
  .es {
    --glow-pos: 50% 8%;
    padding: 96px 32px 100px;
  }

  .es__inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .es__kopf {
    max-width: 620px;
    margin: 0 auto 20px;
    text-align: center;
  }

  .es__kopf .eyebrow {
    margin-bottom: 14px;
  }

  .es__kopf h2 {
    margin-bottom: 14px;
    color: #ffffff;
  }

  .es__cta {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }

  .diagramm {
    position: relative;
    width: 100%;
    max-width: 920px;
    margin: 56px auto 0;
    aspect-ratio: 920 / 500;
  }

  .linien {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .linien path {
    fill: none;
    stroke: url(#es-tunnel);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.4;
    transition:
      opacity 250ms ease,
      stroke-width 250ms var(--ease-out);
  }

  .diagramm.has-active .linien path {
    opacity: 0.22;
  }

  .diagramm .linien path.is-active {
    opacity: 1;
    stroke-width: 2.8;
  }

  .hub {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 118px;
    height: 118px;
    border: 1.5px solid rgba(79, 184, 166, 0.45);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(79, 184, 166, 0.28), rgba(11, 46, 60, 0.9));
    box-shadow:
      0 0 0 10px rgba(79, 184, 166, 0.06),
      0 0 40px rgba(79, 184, 166, 0.18);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  /* Puls: stärkerer Glow als eigene Ebene, nur opacity animiert */
  .hub::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    box-shadow:
      0 0 0 10px rgba(79, 184, 166, 0.08),
      0 0 52px rgba(79, 184, 166, 0.28);
    opacity: 0;
    animation: es-puls 3.2s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes es-puls {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }

  .hub svg {
    width: 26px;
    height: 26px;
  }

  .hub span {
    font-family: var(--font-headline);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.25;
    color: #ffffff;
    hyphens: auto;
  }

  .knoten-liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .knoten {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 220px;
    border-radius: 12px;
  }

  .knoten[data-pos="tl"] {
    left: 0;
    top: 0;
    align-items: flex-start;
    text-align: left;
  }

  .knoten[data-pos="tr"] {
    right: 0;
    top: 0;
    align-items: flex-end;
    text-align: right;
  }

  .knoten[data-pos="bl"] {
    left: 0;
    bottom: 0;
    align-items: flex-start;
    text-align: left;
  }

  .knoten[data-pos="br"] {
    right: 0;
    bottom: 0;
    align-items: flex-end;
    text-align: right;
  }

  .knoten:focus-visible {
    outline-offset: 8px;
  }

  .knoten__ico,
  .mkarte__ico {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .knoten__ico {
    width: 52px;
    height: 52px;
    border: 1.5px solid rgba(240, 244, 243, 0.16);
    background: rgba(240, 244, 243, 0.05);
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      transform 200ms var(--ease-out);
  }

  .knoten__ico svg {
    width: 22px;
    height: 22px;
  }

  .knoten__tag {
    font-family: var(--font-headline);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--helltuerkis);
  }

  .knoten h3,
  .mkarte h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: #ffffff;
  }

  .knoten p {
    font-size: 13px;
    line-height: 1.55;
    color: rgba(240, 244, 243, 0.72);
  }

  .knoten:focus-visible .knoten__ico {
    border-color: transparent;
    background: var(--verlauf-hell);
    transform: scale(1.06);
  }

  .knoten:focus-visible .knoten__ico :global(path),
  .knoten:focus-visible .knoten__ico :global(circle),
  .knoten:focus-visible .knoten__ico :global(rect) {
    stroke: #0b2e3c;
  }

  @media (hover: hover) and (pointer: fine) {
    .knoten:hover .knoten__ico {
      border-color: transparent;
      background: var(--verlauf-hell);
      transform: scale(1.06);
    }

    .knoten:hover .knoten__ico :global(path),
    .knoten:hover .knoten__ico :global(circle),
    .knoten:hover .knoten__ico :global(rect) {
      stroke: #0b2e3c;
    }
  }

  .mobil-liste {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 820px) {
    .diagramm {
      display: none;
    }

    .mobil-liste {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 44px;
    }

    .mkarte {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 18px 20px;
      border: 1px solid rgba(240, 244, 243, 0.1);
      border-radius: 16px;
      background: rgba(240, 244, 243, 0.05);
    }

    .mkarte__ico {
      width: 44px;
      height: 44px;
      background: var(--verlauf-hell);
    }

    .mkarte__ico svg {
      width: 20px;
      height: 20px;
    }

    .mkarte__ico :global(path),
    .mkarte__ico :global(circle),
    .mkarte__ico :global(rect) {
      stroke: #0b2e3c;
    }

    .mkarte h3 {
      margin: 2px 0 6px;
    }

    .mkarte p {
      font-size: 13.5px;
      line-height: 1.6;
      color: rgba(240, 244, 243, 0.75);
    }
  }

  @media (max-width: 560px) {
    .es {
      padding: 64px 20px 72px;
    }

    .es__kopf h2 {
      font-size: 27px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .linien path,
    .hub::after {
      animation: none;
    }

    .knoten__ico {
      transition: background-color 200ms ease;
    }

    .knoten:hover .knoten__ico,
    .knoten:focus-visible .knoten__ico {
      transform: none;
    }
  }
</style>
