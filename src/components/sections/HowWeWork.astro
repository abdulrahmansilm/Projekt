---
/**
 * „So arbeiten wir“ (Redesign 17.09.2026, Vorlage referenz/startseite/claude_components_howwework-redesign-startseite.html).
 * Karussell: große Geisterzahl + Illustration links, Schritt-Text rechts, Pfeile + Punkte zur Navigation.
 * Autoplay alle 6s, pausiert bei Hover/Fokus und bei prefers-reduced-motion aus (emil-design-eng).
 * Bilder liegen unter public/hww/schritt-N.svg (aus der Referenzdatei extrahiert).
 */
const schritte = [
  { titel: "Kennenlernen", text: "Ein unverbindliches Gespräch, in dem Sie Ihre Situation schildern. Wir hören zu, ohne Fachjargon." },
  { titel: "Analyse", text: "Wir prüfen Hardware, Software, Sicherheit und Prozesse und zeigen konkrete Schwachstellen auf." },
  { titel: "Umsetzung", text: "Wir setzen die passende Lösung um, mit möglichst wenig Unterbrechung Ihres Tagesgeschäfts." },
  { titel: "Betreuung", text: "Danach bleiben wir Ihr fester Ansprechpartner. Eine Nummer, ein Name, keine wechselnden Zuständigkeiten." },
];
---

<section class="hww2 section-dark" aria-labelledby="hww2-titel" data-hww>
  <div class="container-site">
    <div class="hww2-head" data-reveal>
      <h2 id="hww2-titel" class="h2">So arbeiten wir</h2>
      <p class="lead">Vier klare Schritte, ein fester Ansprechpartner: von der ersten Frage bis zur laufenden Betreuung.</p>
    </div>

    <div class="hww2-grid">
      <div class="hww2-visual" data-hww-visual>
        <div class="hww2-dots-bg" aria-hidden="true"><span></span><span></span><span></span></div>
        {
          schritte.map((_, i) => (
            <span class:list={["hww2-num", { show: i === 0 }]} data-num={i} aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
          ))
        }
        {
          schritte.map((_, i) => (
            <div class:list={["hww2-illustration", { show: i === 0 }]} data-illu={i}>
              <img src={`/hww/schritt-${i + 1}.svg`} alt="" width="500" height="500" loading={i === 0 ? "eager" : "lazy"} />
            </div>
          ))
        }
      </div>

      <div class="hww2-content">
        <div class="hww2-steps" data-hww-steps>
          {
            schritte.map((s, i) => (
              <div class:list={["hww2-step", { show: i === 0 }]} data-step={i}>
                <h3>{s.titel}</h3>
                <p>{s.text}</p>
              </div>
            ))
          }
        </div>

        <div class="hww2-nav">
          <button class="hww2-arrow" data-hww-prev aria-label="Vorheriger Schritt" type="button">
            <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg>
          </button>
          <div class="hww2-dashes" role="tablist" aria-label="Schritte">
            {
              schritte.map((s, i) => (
                <button
                  class:list={["hww2-dash", { active: i === 0 }]}
                  data-hww-idx={i}
                  aria-label={`Schritt ${i + 1}: ${s.titel}`}
                  type="button"
                />
              ))
            }
          </div>
          <button class="hww2-arrow" data-hww-next aria-label="Nächster Schritt" type="button">
            <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hww]").forEach((root) => {
    const total = 4;
    let current = 0;
    let timer: number | undefined;
    const AUTOPLAY_MS = 6000;

    const nums = Array.from(root.querySelectorAll<HTMLElement>(".hww2-num"));
    const illus = Array.from(root.querySelectorAll<HTMLElement>(".hww2-illustration"));
    const steps = Array.from(root.querySelectorAll<HTMLElement>(".hww2-step"));
    const dashes = Array.from(root.querySelectorAll<HTMLElement>(".hww2-dash"));
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-hww-prev]")!;
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-hww-next]")!;
    const visual = root.querySelector<HTMLElement>("[data-hww-visual]")!;

    const gehe = (idx: number) => {
      current = (idx + total) % total;
      nums.forEach((el) => el.classList.toggle("show", el.dataset.num === String(current)));
      illus.forEach((el) => el.classList.toggle("show", el.dataset.illu === String(current)));
      steps.forEach((el) => el.classList.toggle("show", el.dataset.step === String(current)));
      dashes.forEach((el, i) => {
        el.classList.toggle("active", i === current);
        el.setAttribute("aria-current", i === current ? "true" : "false");
      });
    };

    const weiter = () => gehe(current + 1);
    const zurueck = () => gehe(current - 1);

    const neuStarten = () => {
      window.clearInterval(timer);
      timer = window.setInterval(weiter, AUTOPLAY_MS);
    };

    nextBtn.addEventListener("click", () => {
      weiter();
      neuStarten();
    });
    prevBtn.addEventListener("click", () => {
      zurueck();
      neuStarten();
    });
    dashes.forEach((el, i) => {
      el.addEventListener("click", () => {
        gehe(i);
        neuStarten();
      });
    });

    visual.addEventListener("mouseenter", () => window.clearInterval(timer));
    visual.addEventListener("mouseleave", neuStarten);
    root.addEventListener("focusin", () => window.clearInterval(timer));
    root.addEventListener("focusout", neuStarten);

    const reduziert = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduziert) neuStarten();
  });
</script>

<style>
  .hww2 {
    --glow-pos: 14% 8%;
    padding: 120px 0 130px;
    overflow: hidden;
  }

  .hww2-head {
    max-width: 640px;
    margin: 0 0 64px;
  }

  .hww2-head .h2 {
    margin-bottom: 14px;
  }

  .hww2-grid {
    display: grid;
    grid-template-columns: 0.86fr 1.14fr;
    gap: 16px;
    align-items: center;
  }

  /* ---------- Visual ---------- */
  .hww2-visual {
    position: relative;
    height: 460px;
    display: flex;
    align-items: center;
    padding-left: clamp(60px, 9vw, 130px);
  }

  .hww2-num {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(110px, 11vw, 180px);
    line-height: 1;
    color: rgba(240, 244, 243, 0.07);
    -webkit-text-stroke: 1.5px rgba(240, 244, 243, 0.24);
    letter-spacing: -0.02em;
    z-index: 0;
    user-select: none;
    opacity: 0;
    transition: opacity 500ms ease;
    pointer-events: none;
  }

  .hww2-num.show {
    opacity: 1;
  }

  .hww2-illustration {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    opacity: 0;
    transform: translateY(14px) scale(0.97);
    transition:
      opacity 500ms ease,
      transform 500ms ease;
    pointer-events: none;
    z-index: 1;
  }

  .hww2-illustration.show {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hww2-illustration img {
    width: 100%;
    max-width: 400px;
    height: auto;
    display: block;
    filter: drop-shadow(0 22px 40px rgba(0, 0, 0, 0.35));
  }

  .hww2-dots-bg {
    position: absolute;
    right: 6%;
    top: 14%;
    display: flex;
    gap: 9px;
    z-index: 0;
  }

  .hww2-dots-bg span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(240, 244, 243, 0.22);
  }

  /* ---------- Content ---------- */
  .hww2-content {
    position: relative;
    padding-left: 8px;
  }

  .hww2-steps {
    position: relative;
    min-height: 172px;
    margin-bottom: 36px;
  }

  .hww2-step {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 450ms ease,
      transform 450ms ease;
    pointer-events: none;
  }

  .hww2-step.show {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    position: relative;
  }

  .hww2-step h3 {
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 600;
    margin-bottom: 14px;
    line-height: 1.2;
  }

  .hww2-step p {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--on-dark-72);
    max-width: 480px;
  }

  /* ---------- Nav ---------- */
  .hww2-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .hww2-arrow {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-dark);
    background: rgba(240, 244, 243, 0.04);
    color: var(--on-dark);
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      transform 160ms var(--ease-out);
  }

  .hww2-arrow svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .hww2-arrow:hover {
      background: rgba(240, 244, 243, 0.09);
      border-color: rgba(240, 244, 243, 0.28);
    }
  }

  .hww2-arrow:active {
    transform: scale(0.94);
  }

  .hww2-dashes {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hww2-dash {
    width: 22px;
    height: 3px;
    border-radius: 2px;
    background: rgba(240, 244, 243, 0.18);
    border: none;
    padding: 0;
    cursor: pointer;
    transition:
      width 350ms ease,
      background-color 350ms ease;
  }

  .hww2-dash:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .hww2-dash.active {
    width: 38px;
    background: var(--verlauf);
  }

  @media (max-width: 980px) {
    .hww2-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hww2-visual {
      height: 320px;
      margin-bottom: 20px;
      padding-left: clamp(40px, 14vw, 90px);
    }

    .hww2-num {
      font-size: clamp(80px, 20vw, 130px);
    }

    .hww2-content {
      padding-left: 0;
    }
  }

  @media (max-width: 600px) {
    .hww2 {
      padding: 80px 0 90px;
    }

    .hww2-head {
      margin-bottom: 44px;
    }

    .hww2-visual {
      height: 250px;
      padding-left: 38px;
    }

    .hww2-illustration img {
      max-width: 270px;
    }

    .hww2-num {
      font-size: clamp(64px, 26vw, 100px);
      -webkit-text-stroke: 1px rgba(240, 244, 243, 0.22);
    }

    .hww2-steps {
      min-height: 200px;
      margin-bottom: 26px;
    }

    .hww2-dots-bg {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hww2-illustration,
    .hww2-step,
    .hww2-num,
    .hww2-dash {
      transition: none;
    }
  }
</style>
