---
/**
 * „So arbeiten wir“ (Redesign, Vorlage referenz/startseite/claude_components_howwework-redesign-startseite.html).
 * Besondere Sektion. Kleine Schrittzahl oben links am Bild, Illustration rechts daneben, Schritt-Text rechts.
 * Navigation über Schritt-Reiter (kein Autoplay, keine Pfeile): Der Wechsel passiert nur auf Klick oder per Tastatur.
 * Bilder unter public/hww/schritt-N.svg.
 */
const schritte = [
  { titel: "Kennenlernen", text: "Ein unverbindliches Gespräch, in dem Sie Ihre Situation schildern. Wir hören zu, ohne Fachjargon." },
  { titel: "Analyse", text: "Wir prüfen Hardware, Software, Sicherheit und Prozesse und zeigen konkrete Schwachstellen auf." },
  { titel: "Umsetzung", text: "Wir setzen die passende Lösung um, mit möglichst wenig Unterbrechung Ihres Tagesgeschäfts." },
  { titel: "Betreuung", text: "Danach bleiben wir Ihr fester Ansprechpartner. Eine Nummer, ein Name, keine wechselnden Zuständigkeiten." },
];
const id = `hww-${Math.random().toString(36).slice(2, 7)}`;
---

<section class="hww2 section-dark besondere-sektion" aria-labelledby={`${id}-titel`} data-hww>
  <div class="hww2__inner">
    <div class="hww2-head" data-reveal>
      <h2 id={`${id}-titel`} class="h2">So arbeiten wir</h2>
      <p class="lead">Vier klare Schritte, ein fester Ansprechpartner: von der ersten Frage bis zur laufenden Betreuung.</p>
    </div>

    <div class="hww2-grid">
      <div class="hww2-visual" data-hww-visual>
        {
          schritte.map((_, i) => (
            <div class:list={["hww2-illustration", { show: i === 0 }]} data-illu={i}>
              <span class="hww2-num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <img src={`/hww/schritt-${i + 1}.svg`} alt="" width="500" height="500" loading={i === 0 ? "eager" : "lazy"} />
            </div>
          ))
        }
      </div>

      <div class="hww2-content">
        <div class="hww2-steps">
          {
            schritte.map((s, i) => (
              <div
                class:list={["hww2-step", { show: i === 0 }]}
                role="tabpanel"
                id={`${id}-panel-${i}`}
                aria-labelledby={`${id}-tab-${i}`}
                data-step={i}
                aria-hidden={i === 0 ? undefined : "true"}
              >
                <h3>{s.titel}</h3>
                <p>{s.text}</p>
              </div>
            ))
          }
        </div>

        <div class="hww2-tabs" role="tablist" aria-label="Schritte">
          {
            schritte.map((s, i) => (
              <button
                type="button"
                role="tab"
                id={`${id}-tab-${i}`}
                aria-controls={`${id}-panel-${i}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class:list={["hww2-tab", { active: i === 0 }]}
                data-hww-idx={i}
              >
                <span class="hww2-tab__nr">{String(i + 1).padStart(2, "0")}</span>
                <span class="hww2-tab__name">{s.titel}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hww]").forEach((root) => {
    const illus = Array.from(root.querySelectorAll<HTMLElement>(".hww2-illustration"));
    const steps = Array.from(root.querySelectorAll<HTMLElement>(".hww2-step"));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".hww2-tab"));

    const gehe = (idx: number, fokus = false) => {
      const n = (idx + tabs.length) % tabs.length;
      illus.forEach((el, i) => el.classList.toggle("show", i === n));
      steps.forEach((el, i) => {
        el.classList.toggle("show", i === n);
        if (i === n) el.removeAttribute("aria-hidden");
        else el.setAttribute("aria-hidden", "true");
      });
      tabs.forEach((t, i) => {
        t.classList.toggle("active", i === n);
        t.setAttribute("aria-selected", String(i === n));
        t.tabIndex = i === n ? 0 : -1;
      });
      if (fokus) tabs[n].focus();
    };

    tabs.forEach((t, i) => t.addEventListener("click", () => gehe(i)));
    root.querySelector(".hww2-tabs")?.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      const aktuell = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
      if (ev.key === "ArrowRight") {
        ev.preventDefault();
        gehe(aktuell + 1, true);
      } else if (ev.key === "ArrowLeft") {
        ev.preventDefault();
        gehe(aktuell - 1, true);
      } else if (ev.key === "Home") {
        ev.preventDefault();
        gehe(0, true);
      } else if (ev.key === "End") {
        ev.preventDefault();
        gehe(tabs.length - 1, true);
      }
    });
  });
</script>

<style>
  .hww2 {
    --glow-pos: 14% 8%;
    padding: 110px 32px 120px;
  }

  .hww2__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .hww2-head {
    max-width: 640px;
    margin: 0 0 56px;
  }

  .hww2-head .h2 {
    margin-bottom: 14px;
  }

  .hww2-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 40px;
    align-items: center;
  }

  /* ---------- Bild + kleine Schrittzahl ---------- */
  .hww2-visual {
    position: relative;
    height: 460px;
  }

  .hww2-illustration {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition:
      opacity 500ms ease,
      transform 500ms ease;
    pointer-events: none;
  }

  .hww2-illustration.show {
    opacity: 1;
    transform: none;
  }

  .hww2-illustration img {
    width: 100%;
    max-width: 380px;
    height: auto;
    filter: drop-shadow(0 22px 40px rgba(0, 0, 0, 0.35));
  }

  /* Klein und oben links vom Bild: keine Überschneidung mit der Illustration */
  .hww2-num {
    position: absolute;
    top: 6px;
    left: 0;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: rgba(240, 244, 243, 0.14);
    -webkit-text-stroke: 1.2px rgba(240, 244, 243, 0.4);
    user-select: none;
  }

  /* ---------- Text ---------- */
  .hww2-content {
    padding-left: 8px;
  }

  .hww2-steps {
    position: relative;
    min-height: 180px;
    margin-bottom: 34px;
  }

  .hww2-step {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 450ms ease,
      transform 450ms ease;
    pointer-events: none;
  }

  .hww2-step.show {
    position: relative;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hww2-step h3 {
    margin-bottom: 14px;
    font-size: clamp(26px, 2.8vw, 34px);
    font-weight: 600;
    line-height: 1.2;
  }

  .hww2-step p {
    max-width: 500px;
    font-size: 17.5px;
    line-height: 1.7;
    color: var(--on-dark-72);
  }

  /* ---------- Schritt-Reiter statt Pfeile ---------- */
  .hww2-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 6px;
  }

  .hww2-tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    min-height: 44px;
    padding: 10px 16px 12px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--on-dark-55);
    font-family: var(--font-headline);
    cursor: pointer;
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .hww2-tab::after {
    content: "";
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 6px;
    height: 3px;
    border-radius: 2px;
    background: var(--verlauf);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms var(--ease-out);
  }

  .hww2-tab.active {
    color: #ffffff;
  }

  .hww2-tab.active::after {
    transform: scaleX(1);
  }

  .hww2-tab__nr {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--helltuerkis);
  }

  .hww2-tab__name {
    font-size: 16px;
    font-weight: 600;
  }

  @media (hover: hover) and (pointer: fine) {
    .hww2-tab:hover {
      background: rgba(240, 244, 243, 0.07);
      color: #ffffff;
    }
  }

  .hww2-tab:active {
    transform: scale(0.97);
  }

  @media (max-width: 980px) {
    .hww2-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .hww2-visual {
      height: 340px;
    }

    .hww2-illustration {
      justify-content: center;
    }

    .hww2-content {
      padding-left: 0;
    }
  }

  @media (max-width: 600px) {
    .hww2 {
      padding: 72px 20px 80px;
    }

    .hww2-head {
      margin-bottom: 32px;
    }

    .hww2-visual {
      height: 270px;
    }

    .hww2-illustration img {
      max-width: 270px;
    }

    .hww2-num {
      font-size: 34px;
    }

    .hww2-steps {
      min-height: 210px;
    }

    .hww2-tab {
      padding: 8px 12px 12px;
    }

    .hww2-tab::after {
      left: 12px;
      right: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hww2-illustration,
    .hww2-step,
    .hww2-tab::after {
      transition: none;
    }
  }
</style>
