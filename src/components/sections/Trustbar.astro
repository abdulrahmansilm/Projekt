---
/**
 * Trustbar: Partner-Logo-Marquee (docs/DESIGNSYSTEM.md → Komponente 20).
 * Konstante, lineare Bewegung, die nie anhält (Anforderung 22.09.2026 – auch kein Pausieren bei Hover).
 * Nahtloser Loop: zwei identische Gruppen, jede mit eigenem Abstand am Ende, Verschiebung um exakt -50 %.
 * Runde 4: Jede Gruppe enthält die Logos mehrfach hintereinander, damit eine Gruppe breiter ist als jeder
 * Bildschirm (auch 2560 px). Sonst wurde auf breiten Monitoren rechts eine leere Stelle sichtbar.
 * prefers-reduced-motion: keine Bewegung, statische Reihe.
 * Logos: src/lib/partner.ts (Dateien unter public/partner/).
 */
import { PARTNER } from "../../lib/partner";

interface Props {
  label: string;
  /** steht vor einer dunklen Sektion (Abstände oben/unten tauschen) */
  vorDunkel?: boolean;
}
const { label, vorDunkel = false } = Astro.props;
/** so oft stehen die Logos pro Gruppe hintereinander (5 Logos ≈ 1.100 px → 3× ≈ 3.300 px) */
const WIEDERHOLUNGEN = 3;
const reihe = Array.from({ length: WIEDERHOLUNGEN }, (_, r) => PARTNER.map((p) => ({ ...p, kopie: r > 0 }))).flat();
---

<section class:list={["tb", "section-light", { "tb--vor-dunkel": vorDunkel }]} aria-label={label}>
  <div class="tb__kopf">
    <p class="tb__label">{label}</p>
  </div>
  <div class="tb__marquee">
    <div class="tb__spur" style={`--tb-dauer:${34 * WIEDERHOLUNGEN}s`}>
      {
        [0, 1].map((kopie) => (
          <ul class:list={["tb__gruppe", { "tb__gruppe--kopie": kopie === 1 }]} role="list" aria-hidden={kopie === 1 ? "true" : undefined}>
            {reihe.map((p) => (
              <li class="tb__logo" aria-hidden={p.kopie ? "true" : undefined}>
                {p.nurText ? (
                  <span class="tb__name">{p.name}</span>
                ) : (
                  <img src={p.bild} alt={kopie === 0 && !p.kopie ? p.name : ""} style={`--h:${p.hoehe ?? 30}px`} loading="eager" decoding="async" />
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tb {
    padding: 28px 0 88px;
  }

  .tb--vor-dunkel {
    padding: 88px 0 12px;
  }

  .tb__kopf {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 32px;
    padding: 0 20px;
  }

  .tb__label {
    font-family: var(--font-headline);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
    color: var(--ink-68);
  }

  .tb__marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 80px, #000 calc(100% - 80px), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 80px, #000 calc(100% - 80px), transparent 100%);
  }

  .tb__spur {
    --tb-gap: 72px;
    display: flex;
    align-items: center;
    gap: 0;
    width: max-content;
    animation: tb-lauf var(--tb-dauer, 102s) linear infinite;
    will-change: transform;
  }

  /* Gruppe trägt ihren Abstand selbst → beide Hälften exakt gleich breit, kein Sprung im Loop */
  .tb__gruppe {
    display: flex;
    align-items: center;
    gap: var(--tb-gap);
    margin: 0;
    padding: 0 var(--tb-gap) 0 0;
    list-style: none;
  }

  @keyframes tb-lauf {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .tb__logo {
    display: flex;
    align-items: center;
    flex: none;
    height: 56px;
  }

  .tb__logo img {
    height: var(--h);
    width: auto;
    opacity: 0.88;
  }

  .tb__name {
    font-family: var(--font-headline);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--ink-72);
  }

  @media (max-width: 560px) {
    .tb {
      padding: 16px 0 64px;
    }

    .tb__spur {
      --tb-gap: 48px;
    }

    .tb__logo {
      height: 44px;
    }

    .tb__logo img {
      height: calc(var(--h) * 0.82);
    }

    .tb__name {
      font-size: 19px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tb__spur {
      width: auto;
      animation: none;
    }

    .tb__gruppe {
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px 44px;
      padding: 0 20px;
    }

    .tb__marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .tb__gruppe--kopie,
    .tb__logo[aria-hidden="true"] {
      display: none;
    }
  }
</style>
