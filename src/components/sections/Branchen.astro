---
/**
 * „Für wen sich das eignet“: zwei gegenläufige Branchen-Laufbänder (referenz/ki-telefonassistent/branchen.html).
 * Nahtloser Endlos-Loop: die Spur besteht aus zwei identischen Gruppen; jede Gruppe trägt ihren eigenen
 * Abstand am Ende (padding-right = gap), damit translateX(-50%) exakt eine Gruppenbreite entspricht und
 * nie eine Lücke sichtbar wird. Die Chips stehen pro Gruppe doppelt, damit eine Gruppe auch auf sehr
 * breiten Bildschirmen (2560 px) breiter ist als das Fenster (Runde 4). Bewegung ist konstant und hält nie an (Anforderung 22.09.2026);
 * reduzierte Bewegung → statische Liste.
 */
interface Props {
  eyebrow?: string;
  titel: string;
  intro?: string;
  reihen: { icon: string; label: string }[][];
}
const { eyebrow, titel, intro, reihen } = Astro.props;
---

<section class="br" aria-labelledby="br-titel">
  <div class="br__inner">
    <div class="br__kopf" data-reveal>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id="br-titel" class="h2">{titel}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>
  </div>

  <div class="br__bahnen">
    {
      reihen.map((reihe, i) => (
        <div class="bahn">
          <div class:list={["spur", { "spur--rueckwaerts": i % 2 === 1 }]}>
            {[0, 1].map((kopie) => (
              <ul class:list={["gruppe", { "gruppe--kopie": kopie === 1 }]} role="list" aria-hidden={kopie === 1 ? "true" : undefined}>
                {[...reihe, ...reihe].map((b, n) => (
                  <li class="chip" aria-hidden={n >= reihe.length ? "true" : undefined}>
                    <span class="chip__ico" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" set:html={b.icon} />
                    </span>
                    <span>{b.label}</span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .br {
    padding: 80px 0 88px;
    background: var(--nebel);
  }

  .br__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    max-width: 1120px;
    margin: 0 auto 40px;
    padding: 0 32px;
  }

  .br__kopf {
    max-width: 600px;
  }

  .br__kopf .eyebrow {
    margin-bottom: 14px;
  }

  .br__kopf h2 {
    margin-bottom: 12px;
    font-size: 34px;
  }

  .br__bahnen {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .bahn {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 64px, #000 calc(100% - 64px), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 64px, #000 calc(100% - 64px), transparent 100%);
  }

  .spur {
    --spur-gap: 12px;
    display: flex;
    align-items: center;
    gap: 0;
    width: max-content;
    animation: br-links 84s linear infinite;
    will-change: transform;
  }

  /* Jede Gruppe trägt ihren Abstand selbst → beide Gruppen sind exakt gleich breit */
  .gruppe {
    display: flex;
    align-items: center;
    gap: var(--spur-gap);
    margin: 0;
    padding-right: var(--spur-gap);
    list-style: none;
  }

  .spur--rueckwaerts {
    animation-name: br-rechts;
  }

  @keyframes br-links {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes br-rechts {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    padding: 10px 20px 10px 12px;
    border: 1px solid rgba(11, 46, 60, 0.09);
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(11, 46, 60, 0.04);
    font-family: var(--font-headline);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  .chip__ico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(79, 184, 166, 0.12);
  }

  .chip__ico svg {
    width: 15px;
    height: 15px;
  }

  @media (max-width: 560px) {
    .br {
      padding: 56px 0 64px;
    }

    .br__inner {
      padding: 0 20px;
    }

    .br__kopf h2 {
      font-size: 25px;
    }

    .chip {
      padding: 9px 16px 9px 10px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spur {
      width: auto;
      animation: none;
    }

    .gruppe {
      flex-wrap: wrap;
      justify-content: center;
      padding: 0 20px;
    }

    .bahn {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .gruppe--kopie,
    .chip[aria-hidden="true"] {
      display: none;
    }
  }
</style>
