---
/**
 * Universelle Hero Section (docs/DESIGNSYSTEM.md → Komponente 9) inkl. Hero-Zitat-Block (Komponente 7).
 * Hintergrund: referenz/global/hero-hintergrund.html (atmender 135°-Verlauf, ~22s, ohne Randkontur).
 * Die Kopfzeile liegt im BaseLayout (DOM vor <main>) und wird hier nur räumlich eingeplant.
 */
import { KONTAKT_ANKER } from "../../lib/config";

interface Props {
  headline: string;
  subline?: string;
  cta?: { text: string; href?: string };
  sekundaer?: { text: string; href: string };
  /** kompakte Variante ohne Visual (Rechtsseiten, Über uns) */
  kompakt?: boolean;
  visualLabel?: string;
}

const {
  headline,
  subline,
  cta = { text: "Anfragen", href: KONTAKT_ANKER },
  sekundaer,
  kompakt = false,
  visualLabel,
} = Astro.props;
const hatVisual = Astro.slots.has("visual") && !kompakt;
---

<section class:list={["hero on-dark", { "hero--kompakt": kompakt }]} data-hero aria-labelledby="hero-titel">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class:list={["hero__inner", { "hero__inner--solo": !hatVisual }]}>
    <div class="hero__text">
      <h1 id="hero-titel" class="hero__titel" set:html={headline} />
      {subline && <p class="hero__sub">{subline}</p>}
      {
        !kompakt && (
          <div class="hero__aktionen">
            <a class="btn" href={cta.href ?? KONTAKT_ANKER}>
              <span>{cta.text}</span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            {sekundaer && (
              <a class="btn-ghost" href={sekundaer.href}>
                <span>{sekundaer.text}</span>
              </a>
            )}
          </div>
        )
      }
      <slot name="nach-text" />
    </div>
    {
      hatVisual && (
        <div class="hero__visual" role={visualLabel ? "img" : undefined} aria-label={visualLabel}>
          <slot name="visual" />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    /* Nur links/rechts ein weißer Rand (größer als vorher), oben kantenbündig,
       unten vollständig abgerundet statt an allen vier Ecken. */
    --hero-rand: 22px;
    position: relative;
    margin: 0 var(--hero-rand);
    padding: 136px 48px 56px;
    border-radius: 0 0 28px 28px;
    overflow: hidden;
    isolation: isolate;
    background: #0b2e3c;
    color: var(--on-dark);
  }

  /* Atmende Verlaufsfläche: 250%-Fläche wird per transform verschoben (entspricht background-position 0% → 80%) */
  .hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 250%;
    height: 250%;
    background: linear-gradient(
      135deg,
      #1b6e7a 0%,
      #0b2e3c 38%,
      #0b2e3c 62%,
      color-mix(in srgb, #4fb8a6 65%, #0b2e3c 35%) 100%
    );
    transform: translate3d(0, 0, 0);
    animation: hero-atmen 22s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes hero-atmen {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-48%, -48%, 0);
    }
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    max-width: 1280px;
    min-height: min(640px, calc(100svh - 220px));
    margin: 0 auto;
  }

  .hero__text {
    flex: 1 1 400px;
    max-width: 480px;
    min-width: min(320px, 100%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .hero__inner--solo .hero__text {
    max-width: 760px;
  }

  .hero__visual {
    flex: 1.6 1 460px;
    min-width: min(340px, 100%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__titel {
    font-family: var(--font-headline);
    font-weight: 600;
    /* deutlich größer als vorher (46px) */
    font-size: 58px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #f0f4f3;
    max-width: 16ch;
  }

  .hero__inner--solo .hero__titel {
    max-width: 22ch;
  }

  .hero__titel :global(.akzent) {
    background: var(--verlauf-hell);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__sub {
    max-width: 460px;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(240, 244, 243, 0.78);
  }

  .hero__aktionen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
    margin-top: 4px;
  }

  .hero--kompakt {
    padding-bottom: 64px;
  }

  .hero--kompakt .hero__inner {
    min-height: 0;
    padding-top: 12px;
  }

  @media (max-width: 1100px) {
    .hero__titel {
      font-size: 48px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      --hero-rand: 10px;
      padding: 96px 20px 40px;
      border-radius: 0 0 20px 20px;
    }

    .hero__inner {
      gap: 40px;
      min-height: 0;
    }

    .hero__titel {
      font-size: clamp(32px, 9.2vw, 40px);
      max-width: none;
      hyphens: auto;
      overflow-wrap: break-word;
    }

    .hero__sub {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bg {
      animation: none;
    }
  }
</style>
