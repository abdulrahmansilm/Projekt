---
/**
 * „Ein Projekt aus der Praxis“ (Redesign 17.09.2026, Vorlage
 * referenz/startseite/claude_components_praxisbeispiel-redesign-startseite.html).
 * Zeitstrahl (Ausgangssituation → Ziele → Lösung) links, Bewertungs-Karte rechts.
 * Kundenzitat wörtlich (Runde 9, 23.09.2026), Vereinslogo unter public/praxis/. Die Badges unter
 * dem Zitat („IT-Strategieplanung“ / „Keine Ausfälle mehr“) sind seit Runde 9 entfernt.
 */
import { uebersetzer } from "../../i18n";

const t = uebersetzer(Astro);
const punkte = [
  {
    icon: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="1.6" fill="#fff" stroke="none"/>`,
    titel: t("Ausgangssituation"),
    liste: [t("Veraltete Hardware ohne Support"), t("Ständige Ausfälle im Betrieb"), t("Niemand zuständig bei Problemen"), t("Server ohne Wartung und Backup")],
  },
  {
    icon: `<path d="M5 21V4"/><path d="M5 4h13l-3 4.5L18 13H5"/>`,
    titel: t("Ziele"),
    liste: [
      t("Verlässliche IT ohne ständige Ausfälle"),
      t("Ein fester Ansprechpartner statt wechselnder Zuständigkeiten"),
      t("Daten zuverlässig sichern und im Ernstfall wiederherstellen können"),
    ],
  },
  {
    icon: `<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a6 6 0 0 0-4 10.5c.6.55 1 1.34 1 2.5h6c0-1.16.4-1.95 1-2.5A6 6 0 0 0 12 2z"/>`,
    titel: t("Lösung"),
    check: true,
    liste: [
      t("Beratung & Konzept: Bestand aufgenommen, Weg gemeinsam festgelegt"),
      t("Moderne, sichere Arbeitsplätze mit Microsoft 365, Datensicherung und E-Mail-Schutz"),
      t("Physischen Server durch eine Azure-Cloud-Lösung ersetzt"),
      t("Laufende Betreuung mit festem Ansprechpartner"),
    ],
  },
];
---

<section class="praxis section-light" aria-labelledby="praxis-titel">
  <div class="container-site">
    <div class="praxis__kopf" data-reveal>
      <h2 id="praxis-titel" class="h2">{t("Ein Projekt aus der Praxis")}</h2>
    </div>

    <div class="praxis__main">
      <ol class="zeitstrahl" data-reveal>
        {
          punkte.map((p) => (
            <li class="pkt">
              <span class="pkt__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
              </span>
              <div class="pkt__body">
                <h3>{p.titel}</h3>
                <ul class:list={["pkt__liste", { "pkt__liste--check": p.check }]}>
                  {
                    p.liste.map((l) => (
                      <li>
                        {p.check ? (
                          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12" />
                          </svg>
                        ) : (
                          <span class="pkt__bullet" aria-hidden="true" />
                        )}
                        {l}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </li>
          ))
        }
      </ol>

      <figure class="bewertung" data-reveal style="--reveal-index:1">
        <div class="bewertung__logo">
          <img src="/praxis/jugend-braucht-arbeit.png" alt="Jugend braucht Arbeit e.V." width="351" height="360" loading="lazy" decoding="async" />
        </div>
        <figcaption>
          <h3>Jugend braucht Arbeit e.V.</h3>
          <div class="bewertung__sterne" role="img" aria-label={t("5 von 5 Sternen")}>
            {
              [0, 1, 2, 3, 4].map(() => (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.6l2.85 5.93 6.5.86-4.76 4.5 1.2 6.44L12 17.1l-5.79 3.23 1.2-6.44-4.76-4.5 6.5-.86L12 2.6Z" />
                </svg>
              ))
            }
          </div>
          <blockquote>
            <p>{t("„Wir haben in Selim IT einen zuverlässigen Partner für unsere Hardware- und Software-Bedürfnisse gefunden. Unsere Software-Ausstattung wird gut verwaltet, sie ist stets auf dem neuesten Stand. Unsere Datensicherung verläuft ohne Probleme. Im Notfall ist immer ein Ansprechpartner persönlich verfügbar.“")}</p>
          </blockquote>
          <div class="bewertung__trenner" aria-hidden="true"></div>
          <p class="bewertung__person">
            <strong>Mara Plumari</strong>
            {t("Jugend braucht Arbeit e.V.")}
          </p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .praxis {
    padding: 110px 0 130px;
  }

  .praxis__kopf {
    margin-bottom: 52px;
  }

  .praxis__tag {
    display: inline-block;
    margin-bottom: 16px;
    padding: 6px 15px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffff;
    color: var(--petrol);
    font-size: 12px;
    font-weight: 500;
  }

  .praxis__main {
    display: grid;
    grid-template-columns: 1.4fr 0.82fr;
    gap: 56px;
    align-items: stretch;
  }

  /* ---------- Zeitstrahl ---------- */
  .zeitstrahl {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pkt {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 22px;
    padding-bottom: 44px;
  }

  .pkt:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 23px;
    top: 48px;
    bottom: 0;
    z-index: 0;
    border-left: 2px dotted var(--line-strong);
  }

  .pkt:last-child {
    padding-bottom: 0;
  }

  .pkt__ico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 50%;
    background: var(--verlauf);
    box-shadow: 0 6px 16px -6px rgba(27, 110, 122, 0.45);
  }

  .pkt__ico svg {
    width: 21px;
    height: 21px;
  }

  .pkt__body {
    padding-top: 6px;
  }

  .pkt__body h3 {
    margin-bottom: 13px;
    font-size: 19px;
    font-weight: 600;
  }

  .pkt__liste {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pkt__liste li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-72);
  }

  .pkt__bullet {
    width: 6px;
    height: 6px;
    margin-top: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--ink-55);
  }

  .pkt__liste--check svg {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    flex: none;
    stroke: var(--petrol);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Bewertungskarte ---------- */
  .bewertung {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: 32px 28px;
    border-radius: 24px;
    background: var(--tiefsee);
    color: var(--on-dark);
  }

  /* Runde 4: größer und ohne Beschnitt – das Bild behält sein Seitenverhältnis innerhalb der Fläche */
  .bewertung__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 168px;
    margin-bottom: 22px;
    padding: 14px;
    border-radius: 14px;
    background: #ffffff;
  }

  .bewertung__logo img {
    display: block;
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  .bewertung h3 {
    margin-bottom: 14px;
    font-size: 16.5px;
    line-height: 1.3;
  }

  /* Fünf Sterne im Stil der Google-Bewertungen */
  .bewertung__sterne {
    display: flex;
    gap: 3px;
    margin: -2px 0 14px;
  }

  .bewertung__sterne svg {
    width: 22px;
    height: 22px;
    fill: #fbbc04;
  }

  .bewertung blockquote {
    margin: 0;
  }

  .bewertung blockquote p {
    font-size: 15px;
    line-height: 1.6;
    font-style: italic;
    color: #ffffff;
  }

  .bewertung__trenner {
    height: 1px;
    margin: 26px 0 16px;
    background: var(--line-dark);
  }

  .bewertung__person {
    margin-top: auto;
    font-size: 13px;
    line-height: 1.5;
    color: var(--on-dark-55);
  }

  .bewertung__person strong {
    display: block;
    margin-bottom: 2px;
    font-family: var(--font-headline);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--on-dark);
  }

  @media (max-width: 900px) {
    .praxis__main {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  @media (max-width: 600px) {
    .praxis {
      padding: 80px 0 90px;
    }

    .praxis__kopf {
      margin-bottom: 40px;
    }

    .pkt {
      grid-template-columns: 40px 1fr;
      gap: 16px;
      padding-bottom: 36px;
    }

    .pkt__ico {
      width: 40px;
      height: 40px;
    }

    .pkt__ico svg {
      width: 18px;
      height: 18px;
    }

    .pkt:not(:last-child)::before {
      left: 19px;
    }
  }
</style>
