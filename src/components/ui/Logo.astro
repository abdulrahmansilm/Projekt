---
/**
 * Selim-IT Wortmarke (docs/DESIGNSYSTEM.md → Logo).
 * variant "hell": weißer Schriftzug für dunkle Flächen, "dunkel": #0B2E3C für helle Flächen.
 * Der i-Punkt trägt immer den Verlauf.
 */
import { WORTMARKE_PFADE as P, WORTMARKE_VIEWBOX } from "../../lib/brand";

interface Props {
  variant?: "hell" | "dunkel";
  class?: string;
  title?: string;
  /** „IT“ wechselt dezent zu „KI“ (Navbar): das I gleitet nach rechts, T blendet aus, K blendet ein */
  wechsel?: boolean;
}

const { variant = "hell", class: className = "", title, wechsel = false } = Astro.props;
const gid = `logo-grad-${Math.random().toString(36).slice(2, 8)}`;
const fill = variant === "hell" ? "#FFFFFF" : "#0B2E3C";
---

<svg
  class:list={[className, { "logo--wechsel": wechsel }]}
  data-logo-wechsel={wechsel ? "" : undefined}
  viewBox={WORTMARKE_VIEWBOX}
  xmlns="http://www.w3.org/2000/svg"
  role={title ? "img" : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : "true"}
  focusable="false"
>
  <defs>
    <linearGradient id={gid} x1="382.03" y1="33.05" x2="355.69" y2="6.72" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#1b6e7a"></stop>
      <stop offset="1" stop-color="#4fb8a6"></stop>
    </linearGradient>
  </defs>
  <path fill={fill} d={P.s}></path>
  <path fill={fill} d={P.e}></path>
  <path fill={fill} d={P.lim}></path>
  <path fill={`url(#${gid})`} d={P.punkt}></path>
  <path class="lg-i" fill={fill} d={P.i}></path>
  <path class="lg-t" fill={fill} d={P.t}></path>
  {
    wechsel && (
      <path
        class="lg-k"
        fill={fill}
        d="M579.89 173.33V105.42H591.63V173.33ZM591.63 131 612.09 105.42H627.14L591.63 149.81ZM591.63 149.81 599.32 140.2 621.41 173.33H607.31Z"
      ></path>
    )
  }
</svg>

<style>
  svg {
    width: auto;
    aspect-ratio: 652.94 / 218.71;
  }

  .lg-i,
  .lg-t,
  .lg-k {
    transform-box: fill-box;
  }

  .logo--wechsel .lg-i {
    transition: transform 650ms var(--ease-in-out);
  }

  .logo--wechsel .lg-t {
    transition:
      opacity 300ms ease,
      transform 400ms var(--ease-out);
  }

  .logo--wechsel .lg-k {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 300ms ease,
      transform 400ms var(--ease-out);
  }

  /* I gleitet auf den zweiten Platz, T macht Platz für das K.
     Runde 4: Das K ist jetzt eine gefüllte Glyphe mit derselben Strichstärke wie I und T (11,74)
     statt einer Kontur – dadurch wirken K und I gleich kräftig, ohne das I zu verzerren. */
  .logo--wechsel.ist-ki .lg-i {
    transform: translateX(55.5px);
  }

  .logo--wechsel.ist-ki .lg-t {
    opacity: 0;
    transform: translateY(8px);
  }

  .logo--wechsel.ist-ki .lg-k {
    opacity: 1;
    transform: none;
    transition-delay: 220ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo--wechsel .lg-i,
    .logo--wechsel .lg-t,
    .logo--wechsel .lg-k {
      transition: opacity 200ms ease;
    }
  }
</style>
