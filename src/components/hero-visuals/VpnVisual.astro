---
/**
 * Hero-Visual Fernzugriff/VPN (referenz/vpn/hero.html): vertikaler Tunnel zwischen „Überall“ und „Firmennetzwerk“,
 * Datenpunkte fließen in beide Richtungen (3.5s linear, versetzt). Konstante Bewegung → linear.
 */
import HeroStage from "./HeroStage.astro";
---

<HeroStage breite={350} hoehe={520}>
  <div class="vpn">
    <svg class="tunnel" viewBox="0 0 350 520" width="350" height="520" aria-hidden="true">
      <polyline points="175,148 175,372" fill="none" stroke="#F0F4F3" stroke-width="10" stroke-linejoin="miter" stroke-linecap="square"></polyline>
    </svg>

    <span class="punkt punkt--runter" style="animation-delay:0s"></span>
    <span class="punkt punkt--runter" style="animation-delay:1.8s"></span>
    <span class="punkt punkt--hoch" style="animation-delay:1.2s"></span>
    <span class="punkt punkt--hoch" style="animation-delay:2.6s"></span>

    <span class="schloss">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="11" width="14" height="9" rx="2"></rect>
        <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
      </svg>
    </span>
    <span class="schloss__label">Verschlüsselt</span>

    <div class="knoten knoten--oben">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#1B6E7A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="12" rx="1"></rect>
        <path d="M2 20h20"></path>
      </svg>
      <span>Überall</span>
    </div>
    <div class="knoten knoten--unten">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#1B6E7A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="3" width="16" height="6" rx="1"></rect>
        <rect x="4" y="11" width="16" height="6" rx="1"></rect>
        <circle cx="7.5" cy="6" r="0.8" fill="#1B6E7A" stroke="none"></circle>
        <circle cx="7.5" cy="14" r="0.8" fill="#1B6E7A" stroke="none"></circle>
      </svg>
      <span>Firmennetzwerk</span>
    </div>
  </div>
</HeroStage>

<style>
  .vpn {
    position: relative;
    width: 350px;
    height: 520px;
    font-family: var(--font-body);
  }

  .tunnel {
    position: absolute;
    left: 0;
    top: 0;
    filter: drop-shadow(0 0 12px rgba(240, 244, 243, 0.4));
  }

  .punkt {
    position: absolute;
    left: 171.5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #1b6e7a;
    box-shadow: 0 0 8px rgba(27, 110, 122, 0.6);
    opacity: 0;
  }

  .punkt--runter {
    top: 158px;
    animation: vpn-runter 3.5s linear infinite;
  }

  .punkt--hoch {
    top: 362px;
    animation: vpn-hoch 3.5s linear infinite;
  }

  @keyframes vpn-runter {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    10%,
    88% {
      opacity: 1;
    }
    100% {
      transform: translateY(204px);
      opacity: 0;
    }
  }

  @keyframes vpn-hoch {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    10%,
    88% {
      opacity: 1;
    }
    100% {
      transform: translateY(-204px);
      opacity: 0;
    }
  }

  .schloss {
    position: absolute;
    left: 153px;
    top: 238px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--verlauf);
  }

  .schloss__label {
    position: absolute;
    left: 205px;
    top: 260px;
    font-family: var(--font-headline);
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    transform: translateY(-50%);
  }

  .knoten {
    position: absolute;
    left: 95px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 160px;
    padding: 24px;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.35);
  }

  .knoten--oben {
    top: 20px;
  }

  .knoten--unten {
    top: 372px;
  }

  .knoten span {
    font-family: var(--font-headline);
    font-size: 16px;
    font-weight: 600;
    color: #0b2e3c;
  }

  @media (prefers-reduced-motion: reduce) {
    .punkt {
      animation: none;
    }

    .punkt--runter {
      opacity: 1;
      transform: translateY(60px);
    }

    .punkt--hoch {
      opacity: 1;
      transform: translateY(-60px);
    }
  }
</style>
