---
/**
 * Hero-Visual IT-Betreuung (referenz/it-betreuung/hero.html): Dashboard „Ihre Geräte im Blick“ + zwei Toasts.
 * Toast-Positionen nach docs/DESIGNSYSTEM.md (Karte 250px): oben rechts top:-58/right:-210, unten links bottom:-88/left:-240.
 */
import HeroStage from "./HeroStage.astro";
import HeroToast from "./HeroToast.astro";
import LogoMarke from "../ui/LogoMarke.astro";

const geraete = [
  { name: "Empfang", typ: "laptop" },
  { name: "Buchhaltung", typ: "desktop" },
  { name: "Lager-PC", typ: "desktop" },
  { name: "Geschäftsführung", typ: "laptop" },
];
---

<HeroStage breite={1130}>
  <div class="itv">
    <div class="panel">
      <div class="panel__kopf">
        <span class="panel__logo"><LogoMarke /></span>
        <div>
          <p class="panel__titel">Ihre Geräte im Blick</p>
          <p class="panel__status"><span class="puls"></span>Alle Arbeitsplätze werden laufend überwacht</p>
        </div>
      </div>
      <ul class="liste">
        {
          geraete.map((g) => (
            <li class="zeile">
              {g.typ === "laptop" ? (
                <span class="laptop">
                  <span />
                  <span />
                </span>
              ) : (
                <span class="desktop" />
              )}
              <span class="zeile__name">{g.name}</span>
              <span class="pill">
                <span class="pill__dot" />
                Geschützt
              </span>
            </li>
          ))
        }
        <li class="mehr">+3 weitere Arbeitsplätze</li>
      </ul>
      <div class="panel__fuss">
        <span>Geprüft vor 3 Min.</span>
        <span>Update: heute Nacht</span>
      </div>

      <HeroToast titel="Ticket #142 gelöst, Antwortzeit 8 Min." sub="3 offene Tickets insgesamt" breite={250} style="top:-58px;right:-210px">
        <svg slot="icon" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </HeroToast>
      <HeroToast titel="Support-Hotline erreichbar" sub="Ø 12 Min. Antwortzeit" breite={250} verzoegerung={-2.5} style="bottom:-88px;left:-240px">
        <svg slot="icon" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.5 2.5.8 3.8.9.6 0 1 .5 1 1.1v3.6c0 .6-.5 1.1-1.1 1.1C10.9 21.7 2.3 13.1 2.3 3.9 2.3 3.3 2.8 2.8 3.4 2.8H7c.6 0 1.1.4 1.1 1 .1 1.3.4 2.6.9 3.8.1.4.1.8-.2 1.1L6.6 10.8Z" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"></path></svg>
      </HeroToast>
    </div>
  </div>
</HeroStage>

<style>
  .itv {
    padding: 58px 210px 88px 240px;
  }

  .panel {
    position: relative;
    width: 680px;
    padding: 36px 36px 28px;
    border-radius: 28px 28px 12px 12px;
    background: #f0f4f3;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.35);
    font-family: var(--font-body);
    color: #0b2e3c;
  }

  .panel__kopf {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }

  .panel__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }

  .panel__logo :global(svg) {
    height: 32px;
    width: auto;
  }

  .panel__titel {
    font-family: var(--font-headline);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .panel__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
    font-size: 15px;
    color: rgba(11, 46, 60, 0.68);
  }

  .puls {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--verlauf);
    box-shadow: 0 0 0 4px rgba(79, 184, 166, 0.18);
    animation: itv-puls 2s ease-in-out infinite;
  }

  @keyframes itv-puls {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .liste {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zeile {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border: 1px solid rgba(11, 46, 60, 0.08);
    border-radius: 14px;
    background: #ffffff;
  }

  .zeile__name {
    flex: 1;
    font-size: 16px;
    font-weight: 500;
  }

  .laptop {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 40px;
    flex-shrink: 0;
  }

  .laptop span:first-child {
    width: 34px;
    height: 20px;
    border: 2px solid #1b6e7a;
    border-radius: 4px;
  }

  .laptop span:last-child {
    width: 40px;
    height: 3px;
    margin-top: 2px;
    border-radius: 2px;
    background: #1b6e7a;
  }

  .desktop {
    position: relative;
    width: 34px;
    height: 26px;
    margin: 0 3px 6px;
    flex-shrink: 0;
    border: 2px solid #1b6e7a;
    border-radius: 4px;
  }

  .desktop::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -8px;
    width: 14px;
    height: 5px;
    border-radius: 0 0 3px 3px;
    background: #1b6e7a;
    transform: translateX(-50%);
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 4px 8px;
    border-radius: 999px;
    background: rgba(79, 184, 166, 0.14);
    color: #1b6e7a;
    font-size: 14px;
    font-weight: 600;
  }

  .pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--verlauf);
  }

  .mehr {
    padding: 6px 18px;
    font-size: 14px;
    color: var(--ink-68);
  }

  .panel__fuss {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(11, 46, 60, 0.1);
    color: #1b6e7a;
    font-size: 13px;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .puls {
      animation: none;
    }
  }
</style>
