---
/**
 * Hero-Visual Microsoft 365 (referenz/m365/hero.html): sechs schwebende App-Kacheln mit eigenem Float+Rotate-Loop.
 * Kacheln im hellen Verlauf (#4FB8A6 → #7FD9C4) wie in der Referenz.
 */
import HeroStage from "./HeroStage.astro";

const kacheln = [
  { l: 30, t: 40, g: 84, d: 4.2, dl: -0.3, r: -6, y: -16, icon: '<rect x="2.5" y="5.5" width="19" height="13" rx="2" stroke="#FFFFFF" stroke-width="1.7"/><path d="M3.5 6.5L12 13L20.5 6.5" stroke="#FFFFFF" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>', ig: 38 },
  { l: 230, t: 10, g: 74, d: 3.6, dl: -1.1, r: 5, y: -12, icon: '<path d="M4 5.5H20C20.83 5.5 21.5 6.17 21.5 7V15.5C21.5 16.33 20.83 17 20 17H10L5 21V17H4C3.17 17 2.5 16.33 2.5 15.5V7C2.5 6.17 3.17 5.5 4 5.5Z" stroke="#FFFFFF" stroke-width="1.7" stroke-linejoin="round"/>', ig: 32 },
  { l: 160, t: 150, g: 90, d: 4.8, dl: -2.2, r: -4, y: 14, icon: '<path d="M4 4H10L12 6.5H20C20.55 6.5 21 6.95 21 7.5V18C21 18.55 20.55 19 20 19H4C3.45 19 3 18.55 3 18V5C3 4.45 3.45 4 4 4Z" stroke="#FFFFFF" stroke-width="1.7" stroke-linejoin="round"/>', ig: 40 },
  { l: 10, t: 220, g: 78, d: 3.9, dl: -0.7, r: 7, y: -18, icon: '<rect x="3" y="5" width="18" height="16" rx="2" stroke="#FFFFFF" stroke-width="1.7"/><path d="M3 9.5H21" stroke="#FFFFFF" stroke-width="1.7"/><path d="M7.5 3V6.5" stroke="#FFFFFF" stroke-width="1.7" stroke-linecap="round"/><path d="M16.5 3V6.5" stroke="#FFFFFF" stroke-width="1.7" stroke-linecap="round"/>', ig: 34 },
  { l: 280, t: 250, g: 80, d: 4.4, dl: -1.6, r: -8, y: 10, icon: '<path d="M12 3L20 6.5V11.5C20 16.5 16.5 19.5 12 21C7.5 19.5 4 16.5 4 11.5V6.5L12 3Z" stroke="#FFFFFF" stroke-width="1.7" stroke-linejoin="round"/>', ig: 34 },
  { l: 120, t: 330, g: 72, d: 3.4, dl: -2.6, r: 3, y: -14, icon: '<circle cx="8.5" cy="8" r="2.6" stroke="#FFFFFF" stroke-width="1.7"/><circle cx="16" cy="9" r="2.2" stroke="#FFFFFF" stroke-width="1.7"/><path d="M3 19C3 15.5 5.5 13.3 8.5 13.3C11 13.3 13.1 14.8 13.8 17" stroke="#FFFFFF" stroke-width="1.7" stroke-linecap="round"/><path d="M14 14C17 14 19.5 16 19.5 19" stroke="#FFFFFF" stroke-width="1.7" stroke-linecap="round"/>', ig: 32 },
];
---

<HeroStage breite={420} hoehe={460}>
  <div class="m365">
    {
      kacheln.map((k) => (
        <span
          class="kachel"
          style={`left:${k.l}px;top:${k.t}px;width:${k.g}px;height:${k.g}px;--d:${k.d}s;--dl:${k.dl}s;--r:${k.r}deg;--y:${k.y}px`}
        >
          <svg viewBox="0 0 24 24" fill="none" style={`width:${k.ig}px;height:${k.ig}px`} set:html={k.icon} />
        </span>
      ))
    }
  </div>
</HeroStage>

<style>
  .m365 {
    position: relative;
    width: 420px;
    height: 460px;
  }

  .kachel {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background:
      radial-gradient(circle at 25% 20%, rgba(255, 255, 255, 0.28) 0%, transparent 55%),
      linear-gradient(135deg, #4fb8a6, #7fd9c4);
    box-shadow: 0 16px 32px -8px rgba(11, 46, 60, 0.35);
    transform: rotate(var(--r));
    animation: m365-schweben var(--d) ease-in-out infinite;
    animation-delay: var(--dl);
  }

  @keyframes m365-schweben {
    0%,
    100% {
      transform: translateY(0) rotate(var(--r));
    }
    50% {
      transform: translateY(var(--y)) rotate(var(--r));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kachel {
      animation: none;
    }
  }
</style>
