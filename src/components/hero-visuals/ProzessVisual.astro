---
/**
 * Hero-Visual Prozessautomatisierung (referenz/prozessautomatisierung/hero.html): Zahnrad-Hub mit fünf Knoten
 * in Pentagon-Anordnung, Datenpunkte fließen zum Hub (2.6s linear, je Knoten versetzt).
 */
import HeroStage from "./HeroStage.astro";

const knoten = [
  { t: 38, l: 198, icon: '<path d="M7 3h7l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v4h4"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/>' },
  { t: 148, l: 350, icon: '<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>' },
  { t: 327, l: 292, icon: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>' },
  { t: 327, l: 104, icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>' },
  { t: 148, l: 46, icon: '<rect x="2" y="3" width="8" height="8" rx="2"/><rect x="14" y="13" width="8" height="8" rx="2"/><path d="M10 7h4a2 2 0 0 1 2 2v4"/>' },
];
// Startpunkte = Knotenzentren, Zielvektor Richtung Hub-Zentrum (230,230), 1:1 aus der Referenz
const punkte = [
  { t: 66, l: 226, x: 4, y: 160, d: 0 },
  { t: 176, l: 378, x: -148, y: 54, d: 0.5 },
  { t: 355, l: 320, x: -90, y: -125, d: 1 },
  { t: 355, l: 132, x: 98, y: -125, d: 1.5 },
  { t: 176, l: 74, x: 156, y: 54, d: 2 },
];
---

<HeroStage breite={460} hoehe={460}>
  <div class="pa">
    <svg class="linien" viewBox="0 0 460 460" aria-hidden="true">
      <line x1="230" y1="70" x2="230" y2="230"></line>
      <line x1="382" y1="180" x2="230" y2="230"></line>
      <line x1="324" y1="359" x2="230" y2="230"></line>
      <line x1="136" y1="359" x2="230" y2="230"></line>
      <line x1="78" y1="180" x2="230" y2="230"></line>
    </svg>

    {
      punkte.map((p) => (
        <span class="punkt" style={`top:${p.t}px;left:${p.l}px;--x:${p.x}px;--y:${p.y}px;animation-delay:${p.d}s`} />
      ))
    }

    <span class="hub">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
    </span>

    {
      knoten.map((k) => (
        <span class="knoten" style={`top:${k.t}px;left:${k.l}px`}>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0B2E3C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={k.icon} />
        </span>
      ))
    }
  </div>
</HeroStage>

<style>
  .pa {
    position: relative;
    width: 460px;
    height: 460px;
  }

  .linien {
    position: absolute;
    inset: 0;
    width: 460px;
    height: 460px;
  }

  .linien line {
    stroke: #f0f4f3;
    stroke-width: 2;
    opacity: 0.3;
  }

  .hub {
    position: absolute;
    top: 185px;
    left: 185px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 90px;
    height: 90px;
    border-radius: 24px;
    background: var(--verlauf);
    box-shadow: 0 16px 34px -8px rgba(0, 0, 0, 0.45);
  }

  .knoten {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: #f0f4f3;
    box-shadow: 0 10px 22px -6px rgba(0, 0, 0, 0.35);
  }

  .punkt {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--verlauf-hell);
    box-shadow: 0 0 8px rgba(79, 184, 166, 0.7);
    opacity: 0;
    animation: pa-fluss 2.6s linear infinite;
  }

  @keyframes pa-fluss {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    10%,
    85% {
      opacity: 1;
    }
    100% {
      transform: translate(var(--x), var(--y));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .punkt {
      animation: none;
      opacity: 1;
      transform: translate(calc(var(--x) * 0.5), calc(var(--y) * 0.5));
    }
  }
</style>
