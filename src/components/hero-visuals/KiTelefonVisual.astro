---
/**
 * Hero-Visual KI-Telefonassistent (referenz/ki-telefonassistent/hero.html): funktionaler Audio-Player mit
 * Play/Pause (Glow-Puls), scrubbarer Wellenform, Zeitanzeige und Transkript (<details>, immer im DOM).
 * Barrierefreiheit: Wellenform als role="slider" (Pfeiltasten ±5s), Transkript direkt auf der Seite.
 * Die Audiodatei muss vor Go-Live unter public/audio/ki-telefonassistent-beispiel.mp3 abgelegt werden.
 * Solange sie fehlt, ist der Player deaktiviert und weist darauf hin; das Transkript bleibt nutzbar.
 */
import fs from "node:fs";
import path from "node:path";
import HeroStage from "./HeroStage.astro";

const AUDIO_PFAD = "/audio/ki-telefonassistent-beispiel.mp3";
const audioVorhanden = fs.existsSync(path.join(process.cwd(), "public", AUDIO_PFAD));

// Deterministische Balkenhöhen (kein Audio-Sampling nötig), 1:1 aus der Referenz
const muster = [0.4, 0.65, 0.5, 0.85, 0.6, 0.3, 0.55, 0.9, 0.7, 0.45, 0.6, 0.35, 0.8, 0.5, 0.65, 0.95, 0.55, 0.4, 0.7, 0.5, 0.3, 0.6, 0.85, 0.45, 0.65, 0.5, 0.75, 0.35, 0.6, 0.9, 0.5, 0.4, 0.7, 0.55, 0.8, 0.45, 0.6, 0.35, 0.5, 0.65];

const transkript = [
  { wer: "KI-Assistent", text: "Guten Tag, hier ist der digitale Assistent. Womit kann ich Ihnen helfen?" },
  { wer: "Anrufer", text: "Ich möchte gerne einen Termin vereinbaren." },
  { wer: "KI-Assistent", text: "Sehr gerne. Welcher Tag und welche Uhrzeit würden Ihnen passen?" },
  { wer: "Anrufer", text: "Nächsten Dienstag am Vormittag, wenn möglich." },
  { wer: "KI-Assistent", text: "Das passt. Ich trage Dienstag, 10:00 Uhr für Sie ein und sende Ihnen eine Bestätigung." },
];
---

<HeroStage breite={400}>
  <div class="ki">
    <div class:list={["player", { "player--ohne-audio": !audioVorhanden }]} data-player>
      <p class="player__titel" id="ki-player-titel">Jetzt anhören</p>

      <div class="player__steuerung">
        <button
          type="button"
          class="play"
          data-play
          aria-label={audioVorhanden ? "Beispielgespräch abspielen" : "Hörbeispiel folgt in Kürze"}
          aria-disabled={audioVorhanden ? undefined : "true"}
        >
          <span class="play__glanz" aria-hidden="true"></span>
          <svg class="play__icon-play" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
          <svg class="play__icon-pause" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true">
            <rect x="6" y="5" width="4" height="14" rx="1"></rect>
            <rect x="14" y="5" width="4" height="14" rx="1"></rect>
          </svg>
        </button>

        <div
          class="welle"
          role="slider"
          tabindex={audioVorhanden ? 0 : -1}
          aria-labelledby="ki-player-titel"
          aria-valuemin="0"
          aria-valuemax="60"
          aria-valuenow="0"
          aria-valuetext="0:00 von 1:00"
          aria-disabled={audioVorhanden ? undefined : "true"}
          data-welle
        >
          {muster.map((h) => <span class="balken" style={`height:${Math.round(h * 28) + 4}px`} />)}
        </div>
      </div>

      <div class="zeit" aria-hidden="true">
        <span data-zeit-aktuell>0:00</span>
        <span data-zeit-gesamt>1:00</span>
      </div>

      {!audioVorhanden && <p class="player__hinweis">Hörbeispiel folgt in Kürze. Das Gespräch können Sie im Transkript nachlesen.</p>}

      {audioVorhanden && <audio preload="metadata" src={AUDIO_PFAD} data-audio />}

      <details class="transkript" open={!audioVorhanden}>
        <summary>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          Transkript
        </summary>
        <div class="transkript__text" tabindex="0" role="region" aria-label="Transkript des Beispielgesprächs">
          {
            transkript.map((z) => (
              <p>
                <strong>{z.wer}:</strong> {z.text}
              </p>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</HeroStage>

<script>
  const format = (s: number) => {
    if (!isFinite(s) || s < 0) s = 0;
    return `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
  };

  document.querySelectorAll<HTMLElement>("[data-player]").forEach((player) => {
    const audio = player.querySelector<HTMLAudioElement>("[data-audio]");
    const play = player.querySelector<HTMLButtonElement>("[data-play]")!;
    const welle = player.querySelector<HTMLElement>("[data-welle]")!;
    const balken = Array.from(welle.querySelectorAll<HTMLElement>(".balken"));
    const aktuell = player.querySelector<HTMLElement>("[data-zeit-aktuell]")!;
    const gesamt = player.querySelector<HTMLElement>("[data-zeit-gesamt]")!;
    if (!audio) return;

    const STANDARD = 60;
    const dauer = () => (audio.duration && isFinite(audio.duration) ? audio.duration : STANDARD);

    const zeichne = () => {
      const anteil = dauer() > 0 ? audio.currentTime / dauer() : 0;
      const aktiv = Math.round(anteil * balken.length);
      balken.forEach((b, i) => {
        b.classList.toggle("is-gespielt", i < aktiv);
        b.classList.toggle("is-aktuell", !audio.paused && i === aktiv);
      });
      aktuell.textContent = format(audio.currentTime);
      welle.setAttribute("aria-valuenow", String(Math.round(audio.currentTime)));
      welle.setAttribute("aria-valuetext", `${format(audio.currentTime)} von ${format(dauer())}`);
    };

    audio.addEventListener("loadedmetadata", () => {
      gesamt.textContent = format(dauer());
      welle.setAttribute("aria-valuemax", String(Math.round(dauer())));
      zeichne();
    });
    audio.addEventListener("timeupdate", zeichne);
    audio.addEventListener("play", () => {
      player.classList.add("is-spielt");
      play.setAttribute("aria-label", "Beispielgespräch pausieren");
    });
    const pausiert = () => {
      player.classList.remove("is-spielt");
      play.setAttribute("aria-label", "Beispielgespräch abspielen");
      zeichne();
    };
    audio.addEventListener("pause", pausiert);
    audio.addEventListener("ended", pausiert);

    play.addEventListener("click", () => {
      if (audio.paused) audio.play().catch(() => {});
      else audio.pause();
    });

    // Scrubbing per Zeiger (Pointer Capture: Ziehen funktioniert auch außerhalb der Wellenform weiter)
    const springe = (clientX: number) => {
      const rect = welle.getBoundingClientRect();
      const anteil = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      audio.currentTime = anteil * dauer();
      zeichne();
    };
    let ziehen = false;
    welle.addEventListener("pointerdown", (e) => {
      if (!e.isPrimary) return;
      ziehen = true;
      welle.setPointerCapture(e.pointerId);
      springe(e.clientX);
    });
    welle.addEventListener("pointermove", (e) => ziehen && springe(e.clientX));
    const ende = () => (ziehen = false);
    welle.addEventListener("pointerup", ende);
    welle.addEventListener("pointercancel", ende);

    welle.addEventListener("keydown", (e) => {
      const schritt = e.key === "ArrowRight" || e.key === "ArrowUp" ? 5 : e.key === "ArrowLeft" || e.key === "ArrowDown" ? -5 : 0;
      if (e.key === "Home") audio.currentTime = 0;
      else if (e.key === "End") audio.currentTime = dauer();
      else if (schritt) audio.currentTime = Math.min(dauer(), Math.max(0, audio.currentTime + schritt));
      else return;
      e.preventDefault();
      zeichne();
    });
  });
</script>

<style>
  .ki {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 400px;
    padding: 40px 0;
    font-family: var(--font-body);
  }

  .player {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 320px;
    padding: 24px;
    border-radius: 20px;
    background: #f0f4f3;
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.35);
    color: #0b2e3c;
  }

  .player__titel {
    font-family: var(--font-headline);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .player__steuerung {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .play {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--verlauf);
    cursor: pointer;
    animation: ki-glow 2.4s ease-in-out infinite;
    transition: transform 160ms var(--ease-out);
  }

  .play:active {
    transform: scale(0.95);
  }

  .play:focus-visible {
    outline: 2px solid #1b6e7a;
    outline-offset: 4px;
  }

  @keyframes ki-glow {
    0%,
    100% {
      box-shadow:
        0 8px 24px -4px rgba(27, 110, 122, 0.55),
        0 0 0 0 rgba(79, 184, 166, 0.45);
    }
    50% {
      box-shadow:
        0 8px 28px -2px rgba(27, 110, 122, 0.65),
        0 0 0 10px rgba(79, 184, 166, 0);
    }
  }

  .play__glanz {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.45) 0%, transparent 55%);
    pointer-events: none;
  }

  .play svg {
    position: relative;
  }

  .play__icon-play {
    width: 20px;
    height: 20px;
    margin-left: 2px;
  }

  .play__icon-pause {
    display: none;
    width: 18px;
    height: 18px;
  }

  .is-spielt .play__icon-play {
    display: none;
  }

  .is-spielt .play__icon-pause {
    display: block;
  }

  .player--ohne-audio .play {
    opacity: 0.55;
    cursor: not-allowed;
    animation: none;
  }

  .welle {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 3px;
    height: 36px;
    cursor: pointer;
    touch-action: none;
    border-radius: 6px;
  }

  .welle:focus-visible {
    outline: 2px solid #1b6e7a;
    outline-offset: 4px;
  }

  .player--ohne-audio .welle {
    cursor: default;
  }

  .balken {
    flex: 1;
    border-radius: 2px;
    background: rgba(11, 46, 60, 0.2);
    transition: background-color 150ms ease;
  }

  .balken.is-gespielt {
    background: linear-gradient(180deg, #4fb8a6, #1b6e7a);
  }

  .balken.is-aktuell {
    animation: ki-balken 0.9s ease-in-out infinite;
  }

  @keyframes ki-balken {
    0%,
    100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(1.35);
    }
  }

  .zeit {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-mono);
    font-size: 12px;
    color: rgba(11, 46, 60, 0.68);
  }

  .player__hinweis {
    width: 100%;
    font-size: 12px;
    line-height: 1.45;
    color: rgba(11, 46, 60, 0.72);
  }

  .transkript {
    width: 100%;
  }

  .transkript summary {
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 24px;
    color: rgba(11, 46, 60, 0.68);
    font-size: 12px;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  .transkript summary::-webkit-details-marker {
    display: none;
  }

  .transkript summary svg {
    width: 10px;
    height: 10px;
    transition: transform 200ms var(--ease-out);
  }

  .transkript[open] summary svg {
    transform: rotate(180deg);
  }

  .transkript__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 150px;
    margin-top: 10px;
    padding-top: 10px;
    overflow-y: auto;
    border-top: 1px solid rgba(11, 46, 60, 0.08);
  }

  .transkript__text p {
    font-size: 12px;
    line-height: 1.5;
    color: rgba(11, 46, 60, 0.72);
  }

  .transkript__text strong {
    color: #0b2e3c;
  }

  @media (prefers-reduced-motion: reduce) {
    .play,
    .balken.is-aktuell {
      animation: none;
    }
  }
</style>
