---
/**
 * Kopfzeile mit Logo, 4-Kategorien-Navigation, Telefon und CTA „Beratung vereinbaren“.
 * variant "hero": liegt auf dem dunklen Hero-Verlauf (Logo hell).
 * variant "sticky": kompakter Header auf hellem Grund (Logo dunkel), erscheint nach Verlassen des Heros.
 * Verhalten (Dropdowns, Sticky, Mobile-Menü) in src/lib/navigation.ts.
 */
import Logo from "../ui/Logo.astro";
import { firma, navigation, leistungHref, NAV_ICONS, type NavKategorie } from "../../lib/config";

interface Props {
  variant: "hero" | "sticky";
  aktuellerPfad?: string;
  /** "#kontakt" auf Seiten mit Anfrage-Wizard, sonst "/kontakt" */
  kontaktHref: string;
}

const { variant, aktuellerPfad = "", kontaktHref } = Astro.props;
const suffix = variant;
const istAktiv = (href: string) => aktuellerPfad.replace(/\/$/, "") === href.replace(/\/$/, "");

/** Piktogramm mit Ids, die pro Kopfzeile eindeutig sind (Hero- und Sticky-Kopf rendern dasselbe Menü) */
const piktogramm = (slug: string) => (NAV_ICONS[slug] ?? "").replaceAll("{ID}", `nav-${slug}-${suffix}`);

/** Einträge einer Kategorie nach Dropdown-Spalten gruppieren (ohne Spalten → eine Spalte ohne Überschrift) */
function spaltenVon(kat: NavKategorie) {
  const titel = kat.spalten ?? [""];
  return titel.map((t, i) => ({ titel: t, eintraege: kat.eintraege.filter((e) => (e.spalte ?? 0) === i) }));
}
---

<div class:list={["kopf", `kopf--${variant}`, { "on-dark": variant === "hero" }]}>
  <a href="/" class="kopf__logo" aria-label="Selim-IT, zur Startseite">
    <Logo variant={variant === "hero" ? "hell" : "dunkel"} class="kopf__logo-svg" wechsel />
  </a>

  <nav class="kopf__nav" aria-label={variant === "hero" ? "Hauptnavigation" : "Hauptnavigation (fixiert)"}>
    <ul class="nav-liste" role="list">
      {
        navigation.map((kat) =>
          kat.href ? (
            <li class="nav-eintrag">
              <a
                class="nav-link"
                href={kat.href}
                aria-current={istAktiv(kat.href) ? "page" : undefined}
              >
                {kat.label}
              </a>
            </li>
          ) : (
            <li class="nav-eintrag" data-dropdown>
              <button
                type="button"
                class="nav-link nav-trigger"
                aria-expanded="false"
                aria-controls={`dd-${kat.id}-${suffix}`}
                data-dropdown-trigger
              >
                {kat.label}
                <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div
                class:list={["nav-panel", { "nav-panel--spalten": (kat.spalten?.length ?? 0) > 1 }]}
                id={`dd-${kat.id}-${suffix}`}
                data-dropdown-panel
              >
                {spaltenVon(kat).map((spalte) => (
                  <div class="nav-panel__spalte">
                    {spalte.titel && <p class="nav-panel__kopf">{spalte.titel}</p>}
                    <ul class="nav-panel__liste" role="list">
                      {spalte.eintraege.map((e) =>
                        e.bald ? (
                          <li>
                            <span class="nav-panel__link nav-panel__link--bald" aria-disabled="true">
                              <span class="nav-panel__ico" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={piktogramm(e.slug)} />
                              </span>
                              <span class="nav-panel__titel">{e.label}</span>
                              <span class="nav-panel__bald-tag">bald verfügbar</span>
                            </span>
                          </li>
                        ) : (
                          <li>
                            <a
                              class="nav-panel__link"
                              href={leistungHref(e.slug)}
                              aria-current={istAktiv(leistungHref(e.slug)) ? "page" : undefined}
                            >
                              <span class:list={["nav-panel__ico", { "nav-panel__ico--gross": e.slug === "datensicherung" }]} aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={piktogramm(e.slug)} />
                              </span>
                              <span class="nav-panel__titel">{e.label}</span>
                            </a>
                          </li>
                        )
                      )}
                    </ul>
                  </div>
                ))}
              </div>
            </li>
          )
        )
      }
    </ul>
  </nav>

  <div class="kopf__aktionen">
    <a class="kopf__telefon" href={firma.telefon.href}>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.5 2.5.8 3.8.9.6 0 1 .5 1 1.1v3.6c0 .6-.5 1.1-1.1 1.1C10.9 21.7 2.3 13.1 2.3 3.9c0-.6.5-1.1 1.1-1.1H7c.6 0 1.1.4 1.1 1 .1 1.3.4 2.6.9 3.8.1.4.1.8-.2 1.1L6.6 10.8Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"></path>
      </svg>
      <span class:list={{ platzhalter: firma.telefon.platzhalter }}>{firma.telefon.anzeige}</span>
    </a>
    <a class="btn btn--sm kopf__cta" href={kontaktHref}><span>Beratung vereinbaren</span></a>
    <button
      type="button"
      class="kopf__burger"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  .kopf {
    display: flex;
    align-items: center;
    gap: 24px;
    color: var(--ink);
  }

  .kopf--hero {
    color: rgba(240, 244, 243, 0.82);
  }

  .kopf__logo {
    display: inline-flex;
    flex: none;
    border-radius: 6px;
  }

  .kopf__logo :global(.kopf__logo-svg) {
    height: 38px;
    width: auto;
  }

  .kopf--sticky .kopf__logo :global(.kopf__logo-svg) {
    height: 32px;
  }

  .kopf__nav {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .nav-liste {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-eintrag {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .kopf--hero .nav-link[aria-current="page"],
  .kopf--hero .nav-trigger[aria-expanded="true"] {
    color: #ffffff;
  }

  .kopf--sticky .nav-link[aria-current="page"],
  .kopf--sticky .nav-trigger[aria-expanded="true"] {
    color: var(--petrol);
  }

  @media (hover: hover) and (pointer: fine) {
    .kopf--hero .nav-link:hover {
      color: #ffffff;
      background: rgba(240, 244, 243, 0.08);
    }

    .kopf--sticky .nav-link:hover {
      color: var(--petrol);
      background: rgba(27, 110, 122, 0.07);
    }
  }

  .nav-chevron {
    width: 14px;
    height: 14px;
    transition: transform 200ms var(--ease-out);
  }

  .nav-trigger[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown: ursprungsbewusst (skaliert vom Trigger aus), 200ms ein / 140ms aus */
  .nav-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    z-index: 60;
    min-width: 280px;
    padding: 10px;
    border-radius: 16px;
    background: #ffffff;
    color: var(--ink);
    box-shadow:
      0 24px 48px -16px rgba(11, 46, 60, 0.28),
      0 0 0 1px rgba(11, 46, 60, 0.06);
    transform-origin: top center;
    transform: translateX(-50%) translateY(-4px) scale(0.97);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 140ms ease,
      transform 140ms var(--ease-out),
      visibility 0s linear 140ms;
  }

  /* Zwei Spalten mit Überschrift (Anforderung Runde 4) */
  .nav-panel--spalten {
    display: grid;
    grid-template-columns: repeat(2, minmax(230px, auto));
    gap: 4px 10px;
    min-width: 520px;
    padding: 14px 12px 12px;
  }

  [data-dropdown].is-open > .nav-panel {
    transform: translateX(-50%) translateY(0) scale(1);
    opacity: 1;
    visibility: visible;
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out),
      visibility 0s;
  }

  /* Unsichtbare Brücke, damit der Hover beim Weg vom Trigger zum Panel nicht abreißt */
  .nav-panel::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -12px;
    height: 12px;
  }

  .nav-panel__kopf {
    margin: 2px 14px 8px;
    font-family: var(--font-headline);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  .nav-panel__liste {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Runde 7: keine Hervorhebungsfläche mehr. Beim Hover wechseln nur noch Text- und Piktogrammfarbe. */
  .nav-panel__link {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    padding: 9px 14px;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-panel__link:not(.nav-panel__link--bald):hover .nav-panel__titel,
    .nav-panel__link:not(.nav-panel__link--bald):hover .nav-panel__ico {
      color: var(--tuerkis);
    }
  }

  .nav-panel__link[aria-current="page"] .nav-panel__titel,
  .nav-panel__link[aria-current="page"] .nav-panel__ico {
    color: var(--petrol);
  }

  .nav-panel__titel {
    font-family: var(--font-headline);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    transition: color 150ms ease;
  }

  /* Piktogramm ohne Rahmen (Anforderung Runde 4), ohne Skalierung beim Hover (Runde 6, Ruckel-Bug) */
  .nav-panel__ico {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--petrol);
    transition: color 150ms ease;
  }

  .nav-panel__ico svg {
    width: 22px;
    height: 22px;
  }

  /* Datensicherung-Piktogramm etwas größer (Anforderung Runde 5) */
  .nav-panel__ico--gross {
    width: 28px;
    height: 28px;
  }

  .nav-panel__ico--gross svg {
    width: 26px;
    height: 26px;
  }

  /* Noch nicht verfügbare Leistungen: blass, nicht klickbar */
  .nav-panel__link--bald {
    cursor: default;
  }

  .nav-panel__link--bald .nav-panel__ico,
  .nav-panel__link--bald .nav-panel__titel {
    opacity: 0.45;
  }

  .nav-panel__bald-tag {
    margin-left: 2px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(11, 46, 60, 0.06);
    color: var(--ink-68);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .kopf__aktionen {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: none;
  }

  .kopf__telefon {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: inherit;
    font-size: 14.5px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .kopf__telefon svg {
    width: 17px;
    height: 17px;
  }

  @media (hover: hover) and (pointer: fine) {
    .kopf--hero .kopf__telefon:hover {
      color: #ffffff;
    }

    .kopf--sticky .kopf__telefon:hover {
      color: var(--petrol);
    }
  }

  .kopf__burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }

  .kopf--hero .kopf__burger {
    color: #ffffff;
    background: rgba(240, 244, 243, 0.08);
  }

  .kopf--sticky .kopf__burger {
    background: rgba(11, 46, 60, 0.06);
  }

  .kopf__burger:active {
    transform: scale(0.95);
  }

  .kopf__burger svg {
    width: 22px;
    height: 22px;
  }

  @media (max-width: 1240px) {
    .kopf__telefon {
      display: none;
    }
  }

  @media (max-width: 1040px) {
    .kopf__nav {
      display: none;
    }

    .kopf__aktionen {
      margin-left: auto;
    }

    .kopf__burger {
      display: inline-flex;
    }
  }

  @media (max-width: 560px) {
    .kopf__cta {
      display: none;
    }

    .kopf__logo :global(.kopf__logo-svg) {
      height: 30px;
    }
  }
</style>
