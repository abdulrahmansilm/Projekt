---
/**
 * Leistungsseiten (docs/ANFORDERUNGEN.md → Leistungsseiten-Template und die 11 konkreten Sektionsreihenfolgen).
 * Die Reihenfolge der Sektionen kommt vollständig aus src/content/leistungen/<slug>.json → sektionen.
 */
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import ProblemLoesung from "../components/sections/ProblemLoesung.astro";
import Trustbar from "../components/sections/Trustbar.astro";
import Zeitstrahl from "../components/sections/Zeitstrahl.astro";
import PricingPakete from "../components/sections/PricingPakete.astro";
import PricingSetup from "../components/sections/PricingSetup.astro";
import PreiseAufAnfrage from "../components/sections/PreiseAufAnfrage.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import Einsatzszenarien from "../components/sections/Einsatzszenarien.astro";
import BildText from "../components/sections/BildText.astro";
import FeatureGrid from "../components/sections/FeatureGrid.astro";
import ToolGrid from "../components/sections/ToolGrid.astro";
import Kreislauf from "../components/sections/Kreislauf.astro";
import Kostenvergleich from "../components/sections/Kostenvergleich.astro";
import ErsparnisRechner from "../components/sections/ErsparnisRechner.astro";
import Branchen from "../components/sections/Branchen.astro";
import Konversation from "../components/sections/Konversation.astro";
import Anwendungsfaelle from "../components/sections/Anwendungsfaelle.astro";
import EbenenStapel from "../components/sections/EbenenStapel.astro";
import Kennzahlen from "../components/sections/Kennzahlen.astro";
import PraxisBeispiele from "../components/sections/PraxisBeispiele.astro";
import Siegel from "../components/sections/Siegel.astro";
import KontaktWizard from "../components/kontakt/KontaktWizard.astro";
import WissenTeaser from "../components/sections/WissenTeaser.astro";
import HeroBildVisual from "../components/hero-visuals/HeroBildVisual.astro";
import KiTelefonVisual from "../components/hero-visuals/KiTelefonVisual.astro";
import { breadcrumbJsonLd, faqJsonLd, nurText, serviceJsonLd } from "../lib/seo";
import { uebersetzer, lokalisiere } from "../i18n";

interface Props {
  leistung: CollectionEntry<"leistungen">;
}

const { leistung } = Astro.props;
const t = uebersetzer(Astro);
const d = lokalisiere(leistung.data, t.lang);
/** deutscher Pfad = Identität der Seite; t.pfad() liefert die englische URL */
const pfad = `/leistungen/${leistung.id}`;

// KI-Telefonassistent behält sein interaktives Visual (Audio-Player); alle anderen Seiten
// zeigen das neue statische Hero-Bild (referenz/Hero Images, 17.09.2026).
const visualInteraktiv = leistung.id === "ki-telefonassistent";

const faqSektion = d.sektionen.find((s) => s.typ === "faq");
const jsonLd: Record<string, unknown>[] = [
  serviceJsonLd({ name: d.titel, beschreibung: d.kurz, pfad: t.pfad(pfad), kategorie: d.kategorieLabel, lang: t.lang }),
  breadcrumbJsonLd([
    { name: t("Startseite"), pfad: t.pfad("/") },
    { name: d.kategorieLabel, pfad: t.pfad("/#leistungen-titel") },
    { name: d.titel, pfad: t.pfad(pfad) },
  ]),
];
if (faqSektion && faqSektion.typ === "faq") {
  jsonLd.push(faqJsonLd(faqSektion.fragen.slice(0, 6).map((f) => ({ frage: f.frage, antwortText: nurText(f.antwort) }))));
}
---

<BaseLayout title={d.seo.titel} description={d.seo.beschreibung} pfad={pfad} jsonLd={jsonLd} mitKontaktformular>
  <Hero
    headline={d.hero.headline}
    subline={d.hero.subline}
    cta={{ text: d.hero.cta }}
    visualLabel={visualInteraktiv ? undefined : d.hero.visualLabel}
  >
    {visualInteraktiv ? <KiTelefonVisual slot="visual" /> : <HeroBildVisual slug={leistung.id} slot="visual" alt="" />}
  </Hero>

  {
    d.sektionen.map((s, i) => {
      const naechste = d.sektionen[i + 1];
      switch (s.typ) {
        case "problemLoesung":
          return <ProblemLoesung {...s} />;
        case "trustbar":
          return <Trustbar label={s.label} vorDunkel={naechste?.typ === "problemLoesung"} />;
        case "zeitstrahl":
          return <Zeitstrahl {...s} />;
        case "pricingPakete":
          return <PricingPakete {...s} />;
        case "pricingSetup":
          return <PricingSetup {...s} />;
        case "preiseAufAnfrage":
          return <PreiseAufAnfrage {...s} />;
        case "faq":
          return <FaqSection titel={s.titel} intro={s.intro} fragen={s.fragen} />;
        case "einsatzszenarien":
          return <Einsatzszenarien {...s} />;
        case "bildText":
          return <BildText {...s} />;
        case "featureGrid":
          return <FeatureGrid {...s} />;
        case "toolGrid":
          return <ToolGrid {...s} />;
        case "kreislauf":
          return <Kreislauf {...s} />;
        case "kostenvergleich":
          return <Kostenvergleich {...s} />;
        case "ersparnisRechner":
          return <ErsparnisRechner {...s} />;
        case "branchen":
          return <Branchen {...s} />;
        case "konversation":
          return <Konversation {...s} />;
        case "anwendungsfaelle":
          return <Anwendungsfaelle {...s} />;
        case "ebenen":
          return <EbenenStapel {...s} />;
        case "kennzahlen":
          return <Kennzahlen {...s} />;
        case "praxisbeispiele":
          return <PraxisBeispiele {...s} />;
        case "siegel":
          return <Siegel punkte={s.punkte} />;
        case "kontakt":
          return <KontaktWizard vorauswahl={d.kontaktVorauswahl} leistung={leistung.id} />;
        case "wissenTeaser":
          return <WissenTeaser artikel={d.wissenArtikel} />;
        default:
          return null;
      }
    })
  }
</BaseLayout>
