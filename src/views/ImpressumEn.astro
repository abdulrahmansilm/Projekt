---
/**
 * Legal Notice – englische Fassung des Impressums (Runde 8).
 * Nur zur Information; rechtlich maßgeblich ist die deutsche Fassung (Hinweis auf der Seite).
 * Gleiche Angaben wie src/views/Impressum.astro – bei Änderungen beide Fassungen anpassen.
 *
 * HINWEIS – KEINE GEWÄHR, KEINE RECHTSBERATUNG: vor Veröffentlichung fachkundig prüfen lassen.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Rechtstext from "../components/sections/Rechtstext.astro";
import { firma } from "../lib/config";
---

<BaseLayout
  title="Legal Notice"
  description="Legal notice of Selim-IT, an IT service provider based in Frankfurt am Main, as required by Section 5 of the German Digital Services Act (DDG)."
  pfad="/impressum"
>
  <Hero kompakt headline="Legal Notice" subline="Information pursuant to Section 5 of the German Digital Services Act (DDG)" />

  <Rechtstext stand="September 16, 2026">
    <p class="rt__hinweis">
      This English version is provided for convenience only. The <a href="/impressum" hreflang="de" lang="de">German version</a> is
      legally binding.
    </p>

    <h2>Service provider</h2>
    <address class="rt__karte">
      {firma.name}<br />
      Owner: {firma.inhaber}<br />
      Legal form: Sole proprietorship<br />
      {firma.adresse.strasse}<br />
      <span class:list={{ platzhalter: firma.adresse.plz.platzhalter }}>{firma.adresse.plz.platzhalter ? "[postal code to follow]" : firma.adresse.plz.wert}</span>
      {" "}{firma.adresse.stadt}<br />
      Germany
    </address>

    <h2>Contact</h2>
    <p class="rt__karte">
      Phone:{" "}
      {
        firma.telefon.platzhalter ? (
          <span class="platzhalter">[phone number to follow]</span>
        ) : (
          <a href={firma.telefon.href}>{firma.telefon.anzeige}</a>
        )
      }
      <br />
      Email: <a href={`mailto:${firma.email.adresse}`}>{firma.email.adresse}</a>
    </p>

    <h2>VAT</h2>
    <p>
      VAT identification number pursuant to Section 27a of the German VAT Act (UStG):{" "}
      <span class:list={{ platzhalter: firma.ustIdNr.platzhalter }}>{firma.ustIdNr.platzhalter ? "[VAT ID to follow]" : firma.ustIdNr.wert}</span>
    </p>

    <h2>Responsible for content pursuant to Section 18(2) of the German Interstate Media Treaty (MStV)</h2>
    <p>{firma.inhaber}, address as above.</p>

    <h2>Consumer dispute resolution</h2>
    <p>We are neither willing nor obliged to take part in dispute resolution proceedings before a consumer arbitration board.</p>

    <h2>Liability and copyright</h2>
    <p>
      The content of this website has been prepared with the greatest care. However, we cannot guarantee that it is accurate,
      complete or up to date. The providers of linked external websites are solely responsible for their content. All content
      created by us is subject to German copyright law; any use beyond the limits permitted by law requires our written consent.
    </p>

    <h2>Web design &amp; development</h2>
    <p>{firma.name}</p>
  </Rechtstext>
</BaseLayout>
