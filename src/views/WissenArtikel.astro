---
/**
 * Wissen-Artikel (docs/DESIGNSYSTEM.md → Komponente 23, referenz/wissen/blog-*.html).
 * Artikel-Hero mit Breadcrumb, Badge, H1, Standfirst, Meta. Body 760px mit Keypoint-Callouts und Tabellen,
 * FAQ-Block (alle Antworten sichtbar, deckungsgleich mit FAQPage), Abschluss-CTA.
 * JSON-LD: BlogPosting + FAQPage + BreadcrumbList.
 */
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WissenTeaser from "../components/sections/WissenTeaser.astro";
import { breadcrumbJsonLd, faqJsonLd, ORGANISATION_ID } from "../lib/seo";
import { SITE_URL } from "../lib/config";
import { uebersetzer, datum, kontaktAnker } from "../i18n";
import { artikelListe, type Artikel } from "../i18n/inhalte";

interface Props {
  artikel: Artikel;
}

const { artikel } = Astro.props;
const t = uebersetzer(Astro);
const d = artikel.data;
const { Content, headings } = await render(artikel);
/** Inhaltsverzeichnis: alle H2 des Artikels plus die feste FAQ-Sektion (Anforderung 22.09.2026) */
const inhalt = [...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })), { slug: "artikel-faq", text: t("Häufige Fragen") }];
/** deutscher Pfad = Identität; die englische URL liefert t.pfad() */
const pfad = `/wissen/${artikel.id}`;
const url = `${SITE_URL}${t.pfad(pfad)}`;
const datumIso = d.datum.toISOString().slice(0, 10);
const datumLesbar = datum(d.datum, t.lang);

const alle = await artikelListe(t.lang);
const verwandt = alle
  .filter((a) => a.id !== artikel.id)
  .map((a) => ({
    id: a.id,
    punkte: (a.data.kategorie === d.kategorie ? 2 : 0) + a.data.leistungen.filter((l) => d.leistungen.includes(l)).length,
    reihenfolge: a.data.reihenfolge,
  }))
  .sort((a, b) => b.punkte - a.punkte || a.reihenfolge - b.reihenfolge)
  .slice(0, 3)
  .map((a) => a.id);

const jsonLd = [
  {
    "@type": "BlogPosting",
    "@id": `${url}#artikel`,
    headline: d.titel,
    description: d.beschreibung,
    datePublished: datumIso,
    dateModified: datumIso,
    inLanguage: t.lang === "en" ? "en-US" : "de-DE",
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    author: { "@id": ORGANISATION_ID },
    publisher: { "@id": ORGANISATION_ID },
  },
  faqJsonLd(d.faq.map((f) => ({ frage: f.frage, antwortText: f.antwort }))),
  breadcrumbJsonLd([
    { name: t("Startseite"), pfad: t.pfad("/") },
    { name: t("Wissen"), pfad: t.pfad("/wissen") },
    { name: d.titel, pfad: t.pfad(pfad) },
  ]),
];
---

<BaseLayout title={d.seoTitel} description={d.beschreibung} pfad={pfad} ogTyp="article" jsonLd={jsonLd}>
  <article>
    <header class="ah on-dark" data-hero>
      <div class="ah__inner">
        <div class="ah__text">
          <nav class="ah__brotkrumen" aria-label={t("Brotkrumen")}>
            <ol role="list">
              <li><a href={t.pfad("/")}>{t("Startseite")}</a></li>
              <li><a href={t.pfad("/wissen")}>{t("Wissen")}</a></li>
              <li aria-current="page">{d.kategorie}</li>
            </ol>
          </nav>
          <span class="ah__tag">{d.kategorie}</span>
          <h1>{d.titel}</h1>
          <p class="ah__standfirst">{d.standfirst}</p>
          <p class="ah__meta">
            {t("{n} Min. Lesezeit", { n: d.lesezeit })} · {t("Zuletzt aktualisiert:")} <time datetime={datumIso}>{datumLesbar}</time>
          </p>
        </div>
        <div class="ah__bild" aria-hidden="true">
          <img src={`/wissen/${artikel.id}.svg`} alt="" width="500" height="500" loading="eager" />
        </div>
      </div>
    </header>

    <div class="artikel-layout">
      <aside class="toc" aria-labelledby="toc-titel">
        <div class="toc__box">
          <p id="toc-titel" class="toc__titel">{t("Inhalt")}</p>
          <nav aria-labelledby="toc-titel">
            <ol class="toc__liste" role="list">
              {inhalt.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc-link>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>

      <div class="artikel">
      <Content />

      <section class="faq-block" aria-labelledby="artikel-faq">
        <h2 id="artikel-faq">{t("Häufige Fragen")}</h2>
        {
          d.faq.map((f) => (
            <div class="faq-q">
              <h3>{f.frage}</h3>
              <p>{f.antwort}</p>
            </div>
          ))
        }
      </section>

      <aside class="cta" aria-labelledby="artikel-cta">
        <h2 id="artikel-cta">{d.cta.titel}</h2>
        <p>{d.cta.text}</p>
        <a class="btn btn--hell" href={`${t.pfad("/")}${kontaktAnker(t.lang)}`}><span>{d.cta.link}</span></a>
      </aside>
      </div>
    </div>
  </article>

  <script>
    /** Aktiven Abschnitt im Inhaltsverzeichnis markieren */
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    if (links.length && "IntersectionObserver" in window) {
      const ziele = links
        .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
        .filter((el): el is HTMLElement => el !== null);
      const setzeAktiv = (id: string) => {
        links.forEach((a) => a.classList.toggle("ist-aktiv", decodeURIComponent(a.hash.slice(1)) === id));
      };
      const beobachter = new IntersectionObserver(
        (eintraege) => {
          const sichtbar = eintraege.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (sichtbar[0]) setzeAktiv(sichtbar[0].target.id);
        },
        { rootMargin: "-90px 0px -65% 0px", threshold: 0 }
      );
      ziele.forEach((el) => beobachter.observe(el));
    }
  </script>

  <WissenTeaser titel={t("Weiterlesen")} intro={t("Passende Beiträge zum Thema.")} artikel={verwandt} />
</BaseLayout>

<style>
  .ah {
    margin: 12px;
    padding: 136px 32px 72px;
    border-radius: 18px;
    background: linear-gradient(150deg, #1b6e7a 0%, #0b2e3c 100%);
    color: var(--on-dark);
  }

  .ah__inner {
    display: flex;
    align-items: center;
    gap: 40px;
    max-width: 1080px;
    margin: 0 auto;
  }

  .ah__text {
    flex: 1 1 460px;
    min-width: 0;
    max-width: 760px;
  }

  .ah__bild {
    flex: 1 1 220px;
    display: flex;
    justify-content: center;
  }

  .ah__bild img {
    width: 100%;
    max-width: 260px;
    height: auto;
  }

  @media (max-width: 760px) {
    .ah__inner {
      flex-direction: column-reverse;
      gap: 24px;
    }

    .ah__bild img {
      max-width: 160px;
    }
  }

  .ah__brotkrumen ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
    color: rgba(240, 244, 243, 0.72);
  }

  .ah__brotkrumen li + li::before {
    content: "›";
    margin: 0 8px;
    color: rgba(240, 244, 243, 0.55);
  }

  .ah__brotkrumen a {
    color: rgba(240, 244, 243, 0.82);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .ah__brotkrumen a:hover {
      color: #ffffff;
      text-decoration: underline;
    }
  }

  .ah__tag {
    display: inline-block;
    margin-bottom: 20px;
    padding: 5px 13px;
    border-radius: 999px;
    background: rgba(79, 184, 166, 0.16);
    color: var(--helltuerkis);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .ah h1 {
    margin-bottom: 20px;
    font-size: clamp(28px, 4.2vw, 42px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #ffffff;
  }

  .ah__standfirst {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(240, 244, 243, 0.88);
  }

  .ah__meta {
    margin-top: 28px;
    font-size: 13.5px;
    color: rgba(240, 244, 243, 0.72);
  }

  /* ---------- Inhaltsverzeichnis links neben dem Artikel ---------- */
  .artikel-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 824px);
    gap: 32px;
    justify-content: center;
    max-width: 1220px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .toc {
    padding-top: 72px;
  }

  .toc__box {
    position: sticky;
    top: 96px;
    padding: 24px 22px 26px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #ffffff;
  }

  .toc__titel {
    margin-bottom: 14px;
    font-family: var(--font-headline);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-55);
  }

  .toc__liste {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }

  .toc__liste a {
    display: block;
    padding: 7px 10px 7px 12px;
    border-left: 2px solid transparent;
    border-radius: 0 8px 8px 0;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink-72);
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .toc__liste a:hover {
      background: rgba(79, 184, 166, 0.09);
      color: var(--ink);
    }
  }

  .toc__liste a.ist-aktiv {
    border-left-color: var(--tuerkis);
    background: rgba(79, 184, 166, 0.11);
    font-weight: 600;
    color: var(--petrol);
  }

  @media (max-width: 1100px) {
    .artikel-layout {
      grid-template-columns: minmax(0, 824px);
      padding: 0;
    }

    .toc {
      max-width: 824px;
      margin: 0 auto;
      padding: 56px 32px 0;
    }

    .toc__box {
      position: static;
    }

    .toc__liste {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2px 14px;
    }
  }

  @media (max-width: 600px) {
    .toc {
      padding: 40px 20px 0;
    }

    .toc__liste {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Artikeltext (Markdown mit HTML-Blöcken) ---------- */
  .artikel {
    width: 100%;
    min-width: 0;
    max-width: 824px;
    margin: 0 auto;
    padding: 64px 32px 88px;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .artikel :global(h2) {
    scroll-margin-top: 96px;
  }

  .artikel :global(p) {
    margin-bottom: 22px;
    font-size: 17px;
    line-height: 1.75;
  }

  .artikel :global(h2) {
    margin: 48px 0 18px;
    font-size: 27px;
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.01em;
  }

  .artikel :global(h3) {
    margin: 34px 0 14px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.32;
  }

  .artikel :global(ul),
  .artikel :global(ol) {
    margin: 0 0 24px 22px;
    padding: 0;
  }

  .artikel :global(ul) {
    list-style: disc;
  }

  .artikel :global(ol) {
    list-style: decimal;
  }

  .artikel :global(li) {
    margin-bottom: 10px;
    font-size: 17px;
    line-height: 1.7;
  }

  .artikel :global(li::marker) {
    color: var(--petrol);
  }

  .artikel :global(strong) {
    font-weight: 600;
  }

  .artikel :global(a:not(.btn)) {
    color: var(--petrol);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .artikel :global(.keypoint) {
    margin: 32px 0;
    padding: 22px 26px;
    border-left: 3px solid var(--tuerkis);
    border-radius: 0 12px 12px 0;
    background: #ffffff;
  }

  .artikel :global(.keypoint p) {
    margin: 0;
    font-size: 16.5px;
  }

  .artikel :global(.keypoint p + p) {
    margin-top: 14px;
  }

  .artikel :global(.tabelle-scroll) {
    margin: 28px 0;
    overflow-x: auto;
    border-radius: 12px;
    background: #ffffff;
  }

  .artikel :global(table) {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-size: 15.5px;
  }

  .artikel :global(th) {
    padding: 14px 18px;
    background: rgba(27, 110, 122, 0.08);
    font-family: var(--font-headline);
    font-size: 14.5px;
    font-weight: 600;
    text-align: left;
  }

  .artikel :global(td) {
    padding: 14px 18px;
    border-top: 1px solid rgba(11, 46, 60, 0.08);
    line-height: 1.55;
  }

  .faq-block {
    margin-top: 52px;
  }

  .faq-block h2 {
    margin-bottom: 16px !important;
    scroll-margin-top: 96px;
  }

  .faq-q {
    margin-bottom: 12px;
    padding: 22px 24px;
    border-radius: 14px;
    background: #ffffff;
    box-shadow: 0 3px 12px rgba(11, 46, 60, 0.05);
  }

  .faq-q h3 {
    margin: 0 0 10px !important;
    font-size: 17px !important;
  }

  .faq-q p {
    margin: 0 !important;
    font-size: 15.5px !important;
    line-height: 1.65;
    color: rgba(11, 46, 60, 0.85);
  }

  .cta {
    margin-top: 56px;
    padding: 34px 34px 36px;
    border-radius: 16px;
    background: linear-gradient(135deg, #4fb8a6 0%, #1b6e7a 70%);
    color: #ffffff;
  }

  .cta h2 {
    margin: 0 0 12px !important;
    font-size: 22px !important;
    color: #ffffff;
  }

  .cta p {
    margin: 0 0 22px !important;
    font-size: 16px !important;
    line-height: 1.65;
    color: #ffffff;
  }

  .cta .btn {
    color: var(--petrol);
  }

  @media (max-width: 760px) {
    .ah {
      margin: 8px;
      padding: 104px 20px 48px;
      border-radius: 16px;
    }
  }

  @media (max-width: 600px) {
    .artikel {
      padding: 44px 20px 64px;
    }

    .artikel :global(p),
    .artikel :global(li) {
      font-size: 16px;
    }

    .artikel :global(h2) {
      margin: 38px 0 14px;
      font-size: 23px;
    }

    .ah__standfirst {
      font-size: 16.5px;
    }

    .artikel :global(table) {
      font-size: 14px;
    }

    .artikel :global(th),
    .artikel :global(td) {
      padding: 11px 13px;
    }

    .cta {
      padding: 28px 22px;
    }
  }
</style>
