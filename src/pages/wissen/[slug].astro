---
import { getCollection, type CollectionEntry } from "astro:content";
import WissenArtikel from "../../views/WissenArtikel.astro";

export async function getStaticPaths() {
  const artikel = await getCollection("wissen");
  return artikel.map((a) => ({ params: { slug: a.id }, props: { artikel: a } }));
}

interface Props {
  artikel: CollectionEntry<"wissen">;
}
---

<WissenArtikel artikel={Astro.props.artikel} />
