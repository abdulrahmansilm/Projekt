---
import { getCollection, type CollectionEntry } from "astro:content";
import Leistung from "../../views/Leistung.astro";

export async function getStaticPaths() {
  const leistungen = await getCollection("leistungen");
  return leistungen.map((leistung) => ({ params: { slug: leistung.id }, props: { leistung } }));
}

interface Props {
  leistung: CollectionEntry<"leistungen">;
}
---

<Leistung leistung={Astro.props.leistung} />
