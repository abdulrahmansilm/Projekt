---
/**
 * Über uns (Neuordnung Runde 4, 22.09.2026):
 * Hero mit Bild → Sitz und Erreichbarkeit (mit Kontaktkasten) → Team (Bild & Text)
 * → „Wofür wir stehen“ als besondere Sektion → CTA → Wissen-Teaser.
 * „Ihre Vorteile“ und „IT und KI aus einer Hand“ wurden entfernt.
 * Bewusst ohne erfundene Kennzahlen oder Testimonials (docs/BRANCHE.md → „Nicht vorhanden“).
 */
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import HeroBildVisual from "../components/hero-visuals/HeroBildVisual.astro";
import BildText from "../components/sections/BildText.astro";
import KontaktWizard from "../components/kontakt/KontaktWizard.astro";
import WissenTeaser from "../components/sections/WissenTeaser.astro";
import { firma } from "../lib/config";
import { breadcrumbJsonLd } from "../lib/seo";

const eintrag = await getEntry("seiten", "startseite");
if (!eintrag) throw new Error("src/content/seiten/startseite.json fehlt");
const s = eintrag.data as Record<string, any>;

const ICON = {
  sitz: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>',
  gebiet: '<path d="M9 4.5 3.5 6.8v12.7L9 17.2l6 2.3 5.5-2.3V4.5L15 6.8 9 4.5Z"/><path d="M9 4.5v12.7M15 6.8v12.7"/>',
  zeit: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 1.8"/>',
};

const fakten = [
  { label: "Sitz", wert: firma.adresse.stadt, icon: ICON.sitz },
  { label: "Einsatzgebiet", wert: firma.einsatzgebiet, icon: ICON.gebiet },
  { label: "Erreichbarkeit", wert: firma.supportZeiten, icon: ICON.zeit },
];

const werte = [
  {
    titel: "Done-for-You statt Do-it-yourself",
    text: "Wir übernehmen die Umsetzung vollständig, statt Ihnen Anleitungen und halbfertige Baustellen zu hinterlassen.",
    icon: '<path d="M20 6 9 17l-5-5"/>',
  },
  {
    titel: "Sicherheit als Standard",
    text: "Updates, Datensicherung und Schutzmaßnahmen sind bei uns kein Zusatzpaket, sondern Grundausstattung.",
    icon: '<path d="M12 3l7.5 2.8v5.6c0 4.8-3.1 8.3-7.5 9.6-4.4-1.3-7.5-4.8-7.5-9.6V5.8L12 3Z"/>',
  },
  {
    titel: "Proaktiv statt Reaktiv",
    text: "Wir erkennen Probleme, bevor sie Ihren Betrieb aufhalten, statt erst zu reagieren, wenn etwas steht.",
    icon: '<path d="M12 3v3M12 18v3M4.2 7.5l2.6 1.5M17.2 15l2.6 1.5M4.2 16.5l2.6-1.5M17.2 9l2.6-1.5"/><circle cx="12" cy="12" r="3.2"/>',
  },
  {
    titel: "Ihr digitaler Wegbegleiter",
    text: "Wir begleiten Ihr Unternehmen langfristig und entwickeln Ihre IT gemeinsam mit Ihnen weiter, Schritt für Schritt.",
    icon: '<path d="M4 19c3-6 6-9 9-9h7"/><path d="M16 6l4 4-4 4"/><circle cx="4" cy="19" r="1.4"/>',
  },
];
---

<BaseLayout
  title="Über uns: IT-Dienstleister aus Frankfurt am Main"
  description="Selim-IT betreut Unternehmen bei IT-Betrieb, Sicherheit, Microsoft 365, Webentwicklung, Automatisierung und KI-Assistenten: aus Frankfurt am Main, im Rhein-Main-Gebiet vor Ort und bundesweit remote."
  pfad="/ueber-uns"
  mitKontaktformular
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Startseite", pfad: "/" },
      { name: "Über uns", pfad: "/ueber-uns" },
    ]),
  ]}
>
  <Hero headline="Über uns" subline={`${firma.claim} Aus Frankfurt für das Rhein-Main-Gebiet.`} cta={{ text: "Beratung vereinbaren" }} klein>
    <HeroBildVisual slug="ueber-uns" slot="visual" />
  </Hero>

  <BildText
    titel="Ein junges Team, technisch auf dem neuesten Stand"
    absaetze={[
      "Hinter Selim-IT steht ein junges Team, das neue Technologien nicht nur beobachtet, sondern selbst einsetzt. Was wir Ihnen empfehlen, kennen wir aus der eigenen Praxis.",
      "Zwei Informatiker verantworten Technik und Umsetzung, von Servern und Netzwerken bis zu KI-Assistenten und Automatisierungen. Unser Vertrieb begleitet Sie von der ersten Anfrage an, das Backoffice behält Termine und Abläufe im Blick, und unsere Webdesignerin gestaltet Ihren Auftritt im Netz.",
      "So haben Sie für jedes Thema die passende Person, und trotzdem kennt jeder Ihre Umgebung. Wenn Sie anrufen, erreichen Sie keine Warteschleife, sondern jemanden, der weiß, worum es geht.",
    ]}
    bildLabel="Unser Team"
    ctaText="Unser Leitbild entdecken"
    ctaHref="/leitbild"
  />

  <section class="fakten section-light" aria-labelledby="fakten-titel">
    <div class="container-site">
      <h2 id="fakten-titel" class="h2 fakten__titel" data-reveal>Sitz und Erreichbarkeit</h2>
      <ul class="fakten__liste" role="list" data-reveal-group>
        {
          fakten.map((f) => (
            <li class="fakt" data-reveal>
              <span class="fakt__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
              </span>
              <span class="fakt__label">{f.label}</span>
              <span class="fakt__wert">{f.wert}</span>
            </li>
          ))
        }
        <li class="fakt" data-reveal>
          <span class="fakt__ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.5 2.5.8 3.8.9.6 0 1 .5 1 1.1v3.6c0 .6-.5 1.1-1.1 1.1C10.9 21.7 2.3 13.1 2.3 3.9c0-.6.5-1.1 1.1-1.1H7c.6 0 1.1.4 1.1 1 .1 1.3.4 2.6.9 3.8.1.4.1.8-.2 1.1L6.6 10.8Z"></path>
            </svg>
          </span>
          <span class="fakt__label">Kontakt</span>
          <address class="fakt__kontakt">
            <a href={firma.telefon.href}>{firma.telefon.anzeige}</a>
            <a href={`mailto:${firma.email.adresse}`}>{firma.email.adresse}</a>
          </address>
        </li>
      </ul>
    </div>
  </section>

  <section class="werte section-light" aria-labelledby="werte-titel">
    <div class="werte__inner">
      <div class="werte__kopf" data-reveal>
        <h2 id="werte-titel" class="h2">Wofür wir stehen</h2>
        <p class="lead">Vier Grundsätze, nach denen wir jedes Projekt und jede Betreuung ausrichten.</p>
      </div>
      <ul class="werte__liste" role="list" data-reveal-group>
        {
          werte.map((w) => (
            <li class="wert" data-reveal>
              <span class="wert__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={w.icon} />
              </span>
              <h3>{w.titel}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <KontaktWizard />
  <WissenTeaser titel={s.wissen.titel} intro={s.wissen.intro} artikel={s.wissen.artikel} />
</BaseLayout>

<style>
  /* ---------- Sitz und Erreichbarkeit ---------- */
  .fakten {
    padding: 88px 0 24px;
  }

  .fakten__titel {
    margin-bottom: 32px;
  }

  .fakten__liste {
    display: grid;
    grid-template-columns: repeat(3, 1fr) 1.35fr;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Runde 5: alle Kästen in der besonderen Farbe (vorher nur der Kontaktkasten) */
  .fakt {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 26px 26px 28px;
    border-radius: 20px;
    background:
      radial-gradient(120% 100% at 90% 0%, rgba(79, 184, 166, 0.22), transparent 60%),
      var(--tiefsee);
    color: var(--on-dark);
    box-shadow: 0 4px 18px rgba(11, 46, 60, 0.05);
    transition:
      transform 240ms var(--ease-out),
      box-shadow 240ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .fakt:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 36px -18px rgba(11, 46, 60, 0.3);
    }
  }

  .fakt__ico {
    display: flex;
    width: 30px;
    height: 30px;
    margin-bottom: 12px;
    color: var(--helltuerkis);
  }

  .fakt__ico svg {
    width: 30px;
    height: 30px;
  }

  .fakt__label {
    font-family: var(--font-headline);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--helltuerkis);
  }

  .fakt__wert {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
    color: #ffffff;
  }

  .fakt__kontakt {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15.5px;
    font-style: normal;
    line-height: 1.5;
    color: rgba(240, 244, 243, 0.85);
  }

  .fakt__kontakt a {
    font-size: 17px;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .fakt__kontakt a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  /* ---------- Wofür wir stehen ---------- */
  .werte {
    padding: 96px 32px 100px;
  }

  .werte__inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .werte__kopf {
    max-width: 620px;
    margin-bottom: 48px;
  }

  .werte__kopf h2 {
    margin-bottom: 14px;
  }

  .werte__liste {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Runde 5: nur die einzelnen Kästen in der besonderen Farbe, nicht die ganze Sektion */
  .wert {
    padding: 28px 24px 30px;
    border-radius: 20px;
    background:
      radial-gradient(120% 100% at 90% 0%, rgba(79, 184, 166, 0.22), transparent 60%),
      var(--tiefsee);
    color: var(--on-dark);
    transition:
      transform 240ms var(--ease-out),
      box-shadow 240ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .wert:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 36px -18px rgba(11, 46, 60, 0.3);
    }
  }

  .wert__ico {
    display: flex;
    width: 34px;
    height: 34px;
    margin-bottom: 20px;
    color: var(--helltuerkis);
  }

  .wert__ico svg {
    width: 34px;
    height: 34px;
  }

  .wert h3 {
    margin-bottom: 10px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    color: #ffffff;
  }

  .wert p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--on-dark-72);
  }

  @media (max-width: 1100px) {
    .fakten__liste {
      grid-template-columns: repeat(2, 1fr);
    }

    .werte__liste {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .fakten {
      padding: 64px 0 16px;
    }

    .fakten__liste,
    .werte__liste {
      grid-template-columns: 1fr;
    }

    .werte {
      padding: 64px 20px 72px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fakt,
    .fakt:hover,
    .wert,
    .wert:hover {
      transform: none;
    }
  }
</style>
