:80 {
	# ---- Sicherheits-Header (Anforderung 22.09.2026) ----
	# Die Content-Security-Policy erzeugt Astro selbst als <meta> in jeder Seite (astro.config.mjs).
	# Hier stehen nur die Header, die als <meta> keine Wirkung hätten.
	header {
		# HSTS: nur wirksam über HTTPS; zwei Jahre inkl. Subdomains
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		# Clickjacking-Schutz zusätzlich modern (X-Frame-Options ist der Fallback für alte Browser)
		Content-Security-Policy "frame-ancestors 'none'"
		# Server-Kennung nicht preisgeben
		-Server
	}

	handle /api/* {
		# Antworten des Formular-Backends dürfen nie zwischengespeichert werden
		header Cache-Control "no-store"
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# Gehashte Assets dürfen lange im Cache bleiben, HTML nie
		@unveraenderlich path /_astro/*
		header @unveraenderlich Cache-Control "public, max-age=31536000, immutable"

		@html path *.html /
		header @html Cache-Control "no-cache"

		try_files {path} /404.html
		file_server
	}

	encode gzip zstd
}
