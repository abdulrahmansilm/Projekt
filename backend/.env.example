# Datenbank
DATABASE_URL=sqlite:////app/data/data.db
# Beispiel Postgres: postgresql+psycopg://user:password@localhost:5432/selim_it

# SMTP (Mailcow, eigener Mailserver)
SMTP_HOST=mail.selim-it.de
SMTP_PORT=587
SMTP_USER=noreply@selim-it.de
SMTP_PASSWORD=
SMTP_FROM=noreply@selim-it.de
SMTP_TO=info@selim-it.de

# CalDAV (Nextcloud-Kalender)
CALDAV_URL=https://cloud.selim-it.de/remote.php/dav
CALDAV_USER=
CALDAV_PASSWORD=
CALDAV_CALENDAR_NAME=Erstgespraeche

# Nextcloud Talk (Video-Call-Raum je Buchung)
NEXTCLOUD_TALK_API_URL=https://cloud.selim-it.de/ocs/v2.php/apps/spreed/api/v4/room
NEXTCLOUD_TALK_USER=
NEXTCLOUD_TALK_PASSWORD=

# Altcha (self-hosted Spam-Schutz, kein reCAPTCHA)
ALTCHA_SECRET=bitte-langen-zufaelligen-wert-einsetzen

# Allgemein
SITE_URL=https://selim-it.de
CORS_ORIGINS=https://selim-it.de
# Hosts, die das Backend bedient (Host-Header-Prüfung, Komma-getrennt)
ALLOWED_HOSTS=selim-it.de,www.selim-it.de,backend
# nur lokal: schaltet /api/docs frei
DEBUG=false
